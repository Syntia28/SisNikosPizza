@page
@model LoginModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css">

<style>
    body {
        font-family: 'Inter', sans-serif;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
    }

    .fondo-imagen {
        background-image: url('/Imagenes/login.webp');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        background-repeat: no-repeat;
        min-height: 100vh;
    }

    .card-login {
        background: rgba(255, 255, 255, 0.3);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 2px solid rgba(255, 202, 40, 0.6);
        border-radius: 1rem;
        animation: slideIn 0.7s ease-out;
        overflow: hidden;
        position: relative;
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .loading-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(255, 255, 255, 0.8);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 10;
    }

    .loading-spinner {
        border: 4px solid #060100;
        border-top: 4px solid transparent;
        border-radius: 50%;
        width: 30px;
        height: 30px;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    .text-title {
        font-family: 'Poppins', sans-serif;
        font-size: 2.2rem;
        font-weight: 700;
        background: linear-gradient(to right, #d68910, #f4d03f);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.15);
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .text-title i {
            font-size: 1.8rem;
            color: #030100;
            transition: transform 0.3s ease, color 0.3s ease;
        }

        .text-title:hover i {
            transform: scale(1.2);
            color: #030100;
        }

    .underline {
        width: 80px;
        height: 4px;
        background: #ffca28;
        margin: 0.5rem auto 1rem;
        border-radius: 2px;
        animation: fadeInUnderline 1s ease-in;
    }

    @@keyframes fadeInUnderline {
        from {
            width: 0;
            opacity: 0;
        }

        to {
            width: 80px;
            opacity: 1;
        }
    }

    .text-subtitle {
        font-size: 1.1rem;
        color: #060100;
        opacity: 0.8;
    }

    .form-control {
        border-radius: 30px;
        height: 55px;
        padding-left: 45px;
        border: 2px solid #ffca28;
        transition: all 0.3s ease;
        background: #ffffff;
    }

        .form-control:focus {
            border-color: #060100;
            box-shadow: 0 0 10px rgba(255, 143, 0, 0.4);
        }

    .form-floating > label {
        padding-left: 45px;
        color: #666;
        transition: all 0.3s ease;
    }

    .input-icon {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 1.3rem;
        color: #ff8f00;
        transition: color 0.3s ease, transform 0.3s ease;
    }

    .form-control:focus + .input-icon {
        color: #e67e22;
        transform: translateY(-50%) scale(1.1);
    }

    .form-check-input {
        border: 2px solid #ffca28;
        background-color: #ffffff;
        width: 22px;
        height: 22px;
        border-radius: 5px;
        transition: all 0.3s ease;
    }

        .form-check-input:checked {
            background-color: #060100;
            border-color: #060100;
            transform: scale(1.1);
        }

        .form-check-input:focus {
            box-shadow: 0 0 8px rgba(255, 143, 0, 0.4);
        }

    .form-check-label {
        font-size: 1rem;
        color: #060100;
        margin-left: 0.5rem;
    }

    .form-text {
        font-size: 0.85rem;
        color: #060100;
    }

    .text-link {
        color: #060100;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.3s ease;
    }

        .text-link:hover {
            color: #e67e22;
            text-decoration: underline;
            transform: scale(1.05);
        }

    .alert-danger {
        border-radius: 15px;
        background: #ffebee;
        color: #030100;
        border: 2px solid #ef5350;
        font-size: 0.95rem;
        padding: 0.8rem;
        text-align: center;
        animation: fadeIn 0.5s ease-in;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    .btn-custom {
        background-color: #ffca28;
        color: #000;
        padding: 8px 16px; 
        border-radius: 30px;
        font-weight: 600;
        font-size: 0.9rem; 
        border: none;
        transition: all 0.3s ease;
        width: auto; 
        margin: 0 auto; 
    }

        .btn-custom i {
            font-size: 0.9rem; 
        }

        .btn-custom:hover {
            animation: pulse 1.5s infinite;
        }

    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(255, 215, 0, 0.7);
        }

        70% {
            box-shadow: 0 0 0 15px rgba(255, 215, 0, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(255, 215, 0, 0);
        }
    }

    .btn-attractive:hover:not(:disabled) {
        animation: bounce 0.5s;
    }

    @@keyframes bounce {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-10px);
        }
    }
</style>

<div class="container-fluid min-h-screen d-flex align-items-center justify-content-center fondo-imagen">
    <div class="row w-100 justify-content-center">
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card-login p-6">
                <div class="loading-overlay" id="loadingOverlay">
                    <div class="loading-spinner"></div>
                </div>
                <div class="text-center mb-4">
                    <i class="bi bi-utensils" style="font-size: 2rem; color: #ffca28; margin-bottom: 1rem;"></i>
                    <dotlottie-player id="lottie-player" src="https://lottie.host/2d7a8310-619e-4f37-a0f8-01b3e0b8d1e4/8z9vF1gWnE.lottie"
                                      background="transparent" speed="1" style="width: 180px; height: 180px; margin: 0 auto;" loop autoplay aria-label="Animación de SisNikos">
                    </dotlottie-player>
                    <div id="lottie-fallback" class="d-none">
                        <img src="/Imagenes/login.jpg" alt="SisNikos" style="width: 180px; height: 180px; object-fit: contain;" />
                    </div>
                    <h1 class="text-title" style="color: black;">
                        <i class="bi bi-utensils me-2" aria-label="Icono de cubiertos"></i>
                        @ViewData["Title"]
                    </h1>
                    <div class="underline"></div>
                    <p class="text-subtitle" style="color: black;">¡Bienvenido a NIKO´S!</p>
                </div>
                <form id="account" method="post">
                    <div class="form-floating mb-4 position-relative">
                        <input asp-for="Input.Email" type="text" class="form-control ps-5" autocomplete="username" aria-required="true" placeholder="ingresar usuario o correo" />
                        <label asp-for="Input.Email" class="form-label">Correo o Usuario</label>
                        <i class="bi bi-envelope input-icon"></i>
                        <span asp-validation-for="Input.Email" class="text-danger d-block mt-1"></span>
                    </div>
                    <div class="form-floating mb-4 position-relative">
                        <input asp-for="Input.Password" type="password" class="form-control ps-5" autocomplete="current-password" aria-required="true" placeholder="ingresar contraseña" />
                        <label asp-for="Input.Password" class="form-label">Contraseña</label>
                        <i class="bi bi-lock input-icon"></i>
                        <span asp-validation-for="Input.Password" class="text-danger d-block mt-1"></span>
                    </div>
                    <div class="form-check mb-4">
                        <input class="form-check-input" asp-for="Input.RememberMe" aria-describedby="rememberMeHelp" />
                        <label class="form-check-label" asp-for="Input.RememberMe">@Html.DisplayNameFor(m => m.Input.RememberMe)</label>
                        <small id="rememberMeHelp" class="form-text text-muted">- Mantén tu sesión iniciada por 7 días.</small>
                    </div>
                    <button type="submit" class="btn-custom d-flex align-items-center justify-content-center">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Ingresar
                    </button>
                    <div class="text-center mt-4">
                        <p><a id="forgot-password" asp-page="./ForgotPassword" class="text-link">¿Olvidaste tu contraseña?</a></p>
                        <p><a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-link">Regístrate como nuevo usuario</a></p>
                        <p><a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="text-link">Reenviar confirmación por correo electrónico</a></p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}