@page
@model LoginModel

@{
    ViewData["Title"] = "INICIAR SESION";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid vh-100 d-flex align-items-center justify-content-center" style="background-color: #f8c471;">
    <div class="row w-100 shadow-lg rounded">
        <!-- Imagen a la izquierda -->
        <div class="col-md-6 d-none d-md-block p-0">
            <div class="h-100 w-100 bg-image"
                 style="background-image: url('https://z-p3-scontent.flim3-3.fna.fbcdn.net/v/t39.30808-6/264439390_119489787221083_793614291377048273_n.jpg?_nc_cat=101&ccb=1-7&_nc_sid=127cfc&_nc_eui2=AeEgqg69j-DH5QQsZbH2CUrfIj8ayJoO_i0iPxrImg7-LaF4-c2IeLJkAPmKbfFjtKIz0lyuQyYQBVsvKkiCyjP0&_nc_ohc=W57zjGQKDHoQ7kNvgGIMdHJ&_nc_zt=23&_nc_ht=z-p3-scontent.flim3-3.fna&_nc_gid=Am4fn8iGA3f6rBIshokC63f&oh=00_AYBwFnqsxnGqSGZJlumzGh0k_aPZ-dWCo5HnCEDR3KqYbQ&oe=67446E4C'); background-size: cover; background-position: center;">
                <div class="overlay d-flex align-items-center justify-content-center text-center text-white">
                    <div>
                        <h2 class="fw-bold fst-italic">INICIAR SESIÓN</h2>
                        <p class="fst-italic">Ingrese sus datos de inicio de sesión para acceder a <strong>NIKOS PIZZA</strong></p>
                        <p class="fst-italic">y poder disfrutar de las mejores pizzas</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Formulario de login -->
        <div class="col-md-6 p-5" style="background-color: #f9e79f;">
            <h1 class="mb-4 text-center text-dark">@ViewData["Title"]</h1>
            <section>
                <form id="account" method="post">
                    <hr />
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.Email" class="form-label">Email</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" type="password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                        <label asp-for="Input.Password" class="form-label">Contraseña</label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    <div class="checkbox mb-3">
                        <label asp-for="Input.RememberMe" class="form-label">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            @Html.DisplayNameFor(m => m.Input.RememberMe)
                        </label>
                    </div>
                    <button id="registerSubmit" type="submit" class="w-100 btn btn-lg" style="background-color: #eb984e; color: #fff; border: none;">
                        INGRESAR
                    </button>
                    <div class="text-center mt-3">
                        <p>
                            <a id="forgot-password" asp-page="./ForgotPassword">¿Olvidaste tu contraseña?</a>
                        </p>
                        <p>
                            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Regístrate como nuevo usuario</a>
                        </p>
                        <p>
                            <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Reenviar confirmación por correo electrónico</a>
                        </p>
                    </div>
                </form>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
