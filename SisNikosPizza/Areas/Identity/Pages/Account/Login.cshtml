@page
@model LoginModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .login-page-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0.5rem;
        background-size: cover;
        background-position: center;
        color: white;
        background-attachment: fixed;
        font-family: sans-serif;
        position: relative;
    }

    .login-bg-image {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: -10;
    }

    .login-form-container {
        position: relative;
        width: 100%;
        max-width: 28rem; /* 448px */
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        background-color: rgba(0, 0, 0, 0.5);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 1.5rem; /* 24px */
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        min-height: 350px;
    }

    .loading-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(255, 255, 255, 0.9);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        z-index: 50;
        border-radius: 1.5rem; /* 24px */
        display: none; /* Initially hidden */
    }

    .loading-overlay.visible {
        display: flex;
    }

    .spinner {
        width: 4rem; /* 64px */
        height: 4rem; /* 64px */
        border-width: 4px;
        border-color: #4ade80; /* green-400 */
        border-top-color: #166534; /* green-800 */
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    .loading-text {
        margin-top: 1rem;
        color: #15803d; /* green-700 */
        font-weight: 600;
        font-size: 1.125rem; /* 18px */
    }

    .header-section {
        text-align: center;
    }

    .header-animation {
        width: 8rem; /* 128px */
        height: 8rem; /* 128px */
        margin-top: -1rem;
        margin-left: auto;
        margin-right: auto;
    }

    .header-title {
        font-size: 1.875rem; /* 30px */
        font-weight: 700;
        text-shadow: 0 1px 3px rgba(0,0,0,0.3);
    }

    .login-form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .validation-summary {
        background-color: rgba(239, 68, 68, 0.8); /* bg-red-500/80 */
        border: 1px solid #b91c1c; /* border-red-700 */
        padding: 0.5rem 1rem;
        border-radius: 0.5rem;
        font-size: 0.875rem; /* 14px */
        text-align: center;
    }

    .input-group {
        position: relative;
    }

    .form-input {
        display: block;
        width: 100%;
        padding: 0.5rem 1rem;
        border-radius: 0.5rem;
        background-color: rgba(255, 255, 255, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.3);
        transition: all 0.3s;
    }

    .form-input:focus {
        outline: none;
        box-shadow: 0 0 0 2px #4ade80; /* focus:ring-2 focus:ring-green-400 */
        border-color: #4ade80;
    }

    .validation-message {
        color: #f87171; /* text-red-400 */
        font-size: 0.75rem; /* 12px */
        position: absolute;
        bottom: -1.25rem; /* -bottom-5 */
        left: 0.5rem;
    }

    .form-options {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 0.875rem; /* 14px */
    }

    .remember-me {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    
    .remember-me-checkbox {
        height: 1rem;
        width: 1rem;
        border-radius: 0.25rem;
        border-color: #86efac; /* border-green-300 */
        background-color: rgba(220, 252, 231, 0.3); /* bg-green-100/30 */
        color: #22c55e; /* text-green-500 */
    }
    
    .remember-me-checkbox:focus {
        box-shadow: 0 0 0 2px #166534; /* focus:ring-offset-green-800 */
    }

    .form-link {
        font-weight: 500;
        text-decoration: none;
        color: inherit;
    }

    .form-link:hover {
        color: #67e8f9; /* hover:text-cyan-300 */
        text-decoration: underline;
    }

    .submit-button {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1rem;
        font-size: 1.125rem; /* 18px */
        font-weight: 700;
        color: #1f2937; /* text-gray-800 */
        background-image: linear-gradient(to right, #facc15, #fb923c); /* from-yellow-400 to-orange-400 */
        border-radius: 9999px;
        border: none;
        box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -2px rgba(0,0,0,0.05);
        transition: all 0.3s ease-in-out;
        cursor: pointer;
    }

    .submit-button:hover {
        box-shadow: 0 0 20px rgba(250, 204, 21, 0.5); /* hover:shadow-yellow-400/50 */
        transform: translateY(-0.25rem);
    }
    
    .submit-button:focus {
        outline: none;
        box-shadow: 0 0 0 4px rgba(250, 204, 21, 0.5); /* focus:ring-4 focus:ring-yellow-400/50 */
    }

    .register-link {
        text-align: center;
        font-size: 0.875rem; /* 14px */
        font-weight: 500;
        color: #86efac; /* text-green-300 */
        text-decoration: none;
    }
    
    .register-link:hover {
        color: #67e8f9; /* hover:text-cyan-300 */
        text-decoration: underline;
    }

    @@keyframes spin {
        from {
            transform: rotate(0deg);
        }
        to {
            transform: rotate(360deg);
        }
    }
</style>

<div class="login-page-container">
    <img fetchpriority="high" decoding="async" height="100%" width="100%" src="/Imagenes/login.avif"
        alt="Fondo de inicio de sesión" class="login-bg-image" />

    <div class="login-form-container">

        <!-- Overlay de Carga -->
        <div id="loadingOverlay" class="loading-overlay">
            <div class="spinner"></div>
            <p class="loading-text">Ingresando...</p>
        </div>

        <div class="header-section">
            <dotlottie-player src="https://lottie.host/2d7a8310-619e-4f37-a0f8-01b3e0b8d1e4/8z9vF1gWnE.lottie"
                background="transparent" speed="1" class="header-animation" loop autoplay
                aria-label="Animación de SisNikos">
            </dotlottie-player>
            <h1 class="header-title">@ViewData["Title"]</h1>
        </div>

        <form id="account" method="post" class="login-form">

            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

            <!-- Campo Email -->
            <div class="input-group">
                <input asp-for="Input.Email" id="email" class="form-input"
                    placeholder="Correo o Usuario" autocomplete="username" aria-required="true" />
                <span asp-validation-for="Input.Email" class="validation-message"></span>
            </div>

            <!-- Campo Contraseña -->
            <div class="input-group">
                <input asp-for="Input.Password" type="password" id="password" class="form-input"
                    placeholder="Contraseña" autocomplete="current-password" aria-required="true" />
                <span asp-validation-for="Input.Password" class="validation-message"></span>
            </div>

            <div class="form-options">
                <div class="remember-me">
                    <input asp-for="Input.RememberMe" class="remember-me-checkbox" />
                    <label asp-for="Input.RememberMe" class="font-medium">
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>
                <a id="forgot-password" asp-page="./ForgotPassword" class="form-link">¿Olvidaste tu contraseña?</a>
            </div>

            <button id="login-submit" type="submit" class="submit-button">
                <i class="bi bi-box-arrow-in-right"></i>
                Ingresar
            </button>

            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="register-link">
                Registrar un nuevo usuario
            </a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('account');
            const loadingOverlay = document.getElementById('loadingOverlay');

            if (form) {
                form.addEventListener('submit', function (e) {
                    if (!$(form).valid()) {
                        return; 
                    }

                    if (loadingOverlay) {
                        loadingOverlay.classList.add('visible');
                    }
                });
            }
        });
    </script>
}
