@page
@model RegisterModel
@{
    ViewData["Title"] = "Registrate";
}

<div class="container-fluid vh-100 d-flex align-items-center justify-content-center" style="background-color: #f8c471;">
    <div class="row w-100">
        <!-- Formulario de registro -->
        <div class="col-lg-6 col-md-8 p-5 rounded shadow-lg" style="background-color: #f9e79f; box-shadow: 0px 4px 15px rgba(0, 0, 0, 0.2);">
            <h1 class="text-center mb-4 text-dark">@ViewData["Title"]</h1>
            <h2 class="text-center mb-3 text-dark">Crea tu cuenta en Nikos Pizza</h2>
            <hr class="border-dark mb-4" />
            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <!-- Correo Electrónico -->
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control text-dark bg-light border-secondary" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <label asp-for="Input.Email" class="text-dark">Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <!-- Contraseña -->
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" type="password" class="form-control text-dark bg-light border-secondary" autocomplete="new-password" aria-required="true" placeholder="password" />
                    <label asp-for="Input.Password" class="text-dark">Contraseña</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <!-- Confirmar Contraseña -->
                <div class="form-floating mb-3">
                    <input asp-for="Input.ConfirmPassword" type="password" class="form-control text-dark bg-light border-secondary" autocomplete="new-password" aria-required="true" placeholder="password" />
                    <label asp-for="Input.ConfirmPassword" class="text-dark">Confirma la Contraseña</label>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>

                <!-- Botón de Registro -->
                <button id="registerSubmit" type="submit" class="w-100 btn btn-lg" style="background-color: #e59866; color: #fff; border: none;">
                    REGISTAR
                </button>
            </form>
        </div>

        <!-- Imagen y texto -->
        <div class="col-lg-6 col-md-8 d-flex align-items-center justify-content-center">
            <div class="text-center">
                <!-- Imagen -->
                <img src="https://z-p3-scontent.flim3-2.fna.fbcdn.net/v/t39.30808-6/292268889_175399464963448_1043308588369004395_n.jpg?_nc_cat=106&ccb=1-7&_nc_sid=833d8c&_nc_eui2=AeHbtaYr_QbRhIJHm_lbln1Rcz8Ne_r6_jRzPw17-vr-NE1DhCn2jnmg4suyKsQKjlDLfqYwnvlKfMlp6XFfjjDp&_nc_ohc=PVdL_xGWXKYQ7kNvgGv3kwR&_nc_zt=23&_nc_ht=z-p3-scontent.flim3-2.fna&_nc_gid=AWQEQcy5jxOyrMcay--wjO_&oh=00_AYA4RRuTiRMjJqgN1JZQzOBGBfhHiqWKsoMgDDVV_3bzVg&oe=67443EB8"
                     alt="Nikos Pizza Logo"
                     class="img-fluid rounded shadow-lg mb-4"
                     style="max-width: 400px; height: auto;">
                <h3 class="text-dark">¡Bienvenido a Nikos Pizza!</h3>
                <p class="text-secondary">Regístrate para disfrutar de nuestras promociones exclusivas y personalizar tus pedidos.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
