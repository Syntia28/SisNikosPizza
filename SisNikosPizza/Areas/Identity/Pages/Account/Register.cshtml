@page
@model RegisterModel
@{
    ViewData["Title"] = "Registrate";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<style>
    body {
        font-family: 'Inter', sans-serif;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
    }

    .fondo-imagen {
        background-image: url('/Imagenes/register.webp');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        background-repeat: no-repeat;
        min-height: 100vh;
    }

    .card-login {
        background: rgba(255, 255, 255, 0.5);
        backdrop-filter: blur(10px);
        border: 2px solid rgba(255, 202, 40, 0.6);
        border-radius: 1rem;
        animation: slideIn 0.7s ease-out;
        padding: 2rem;
        position: relative;
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .text-title {
        font-family: 'Poppins', sans-serif;
        font-size: 2.2rem;
        font-weight: 700;
        color: #000000;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
    }

    .underline {
        width: 80px;
        height: 4px;
        background: #ffca28;
        margin: 0.5rem auto 1.5rem;
        border-radius: 2px;
    }

    .text-subtitle, .text-description {
        color: #000000;
        opacity: 0.8;
    }

    .text-subtitle {
        font-size: 1.1rem;
        margin-bottom: 1rem;
    }

    .text-description {
        font-size: 0.95rem;
        margin-bottom: 1.5rem;
    }

    .form-control {
        border-radius: 30px;
        height: 55px;
        padding-left: 70px;
        border: 2px solid #ffca28;
        background: #ffffff;
        transition: all 0.3s ease;
        width: 100%;
    }

        .form-control:focus {
            border-color: #060100;
            box-shadow: 0 0 10px rgba(255, 143, 0, 0.4);
        }

    .form-floating > label {
        padding-left: 70px;
        color: #000000;
    }

    .input-icon {
        position: absolute;
        left: 25px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 1.3rem;
        color: #ff8f00;
        z-index: 1;
    }

    .form-check-input {
        border: 2px solid #ffca28;
        background-color: #ffffff;
        width: 22px;
        height: 22px;
        border-radius: 5px;
    }

        .form-check-input:checked {
            background-color: #060100;
            border-color: #060100;
        }

    .text-link {
        color: #000000;
        text-decoration: none;
        font-weight: 500;
    }

        .text-link:hover {
            color: #e67e22;
            text-decoration: underline;
        }

    .alert-danger {
        border-radius: 15px;
        background: #ffebee;
        color: #000000;
        border: 2px solid #ef5350;
        font-size: 0.95rem;
        padding: 0.8rem;
        text-align: center;
        margin-bottom: 1.5rem;
    }

    .btn-custom {
        background-color: #ffca28;
        color: #000;
        padding: 8px 16px; 
        border-radius: 30px;
        font-weight: 600;
        font-size: 0.9rem;
        border: none;
        transition: all 0.3s ease;
        width: auto; 
        margin: 0 auto; 
    }

        .btn-custom i {
            font-size: 0.9rem; 
        }

        .btn-custom:hover {
            animation: pulse 1.5s infinite;
        }

    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(255, 215, 0, 0.7);
        }

        70% {
            box-shadow: 0 0 0 15px rgba(255, 215, 0, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(255, 215, 0, 0);
        }
    }
</style>

<div class="container-fluid min-h-screen d-flex align-items-center justify-content-center fondo-imagen">
    <div class="row w-100 justify-content-center">
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card-login">
                <div class="text-center mb-4">
                    <dotlottie-player src="https://lottie.host/2d7a8310-619e-4f37-a0f8-01b3e0b8d1e4/8z9vF1gWnE.lottie"
                                      background="transparent" speed="1"
                                      style="width: 180px; height: 180px; margin: 0 auto;" loop autoplay>
                    </dotlottie-player>
                    <h1 class="text-title"><i class="bi bi-utensils me-2"></i>@ViewData["Title"]</h1>
                    <div class="underline"></div>
                    <p class="text-subtitle">¡Bienvenido a Nikos Pizza!</p>
                    <p class="text-description">Regístrate para disfrutar de nuestras promociones exclusivas y personalizar tus pedidos.</p>
                </div>

                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div class="form-floating mb-4 position-relative">
                        <input asp-for="Input.Username" class="form-control ps-5" placeholder="Usuario" autocomplete="username" aria-required="true" />
                        <label asp-for="Input.Username">Nombre de usuario</label>
                        <i class="bi bi-person input-icon"></i>
                        <span asp-validation-for="Input.Username" class="text-danger mt-1 d-block"></span>
                    </div>

                    <div class="form-floating mb-4 position-relative">
                        <input asp-for="Input.Email" class="form-control ps-5" placeholder="Correo Electrónico" autocomplete="email" aria-required="true" />
                        <label asp-for="Input.Email">Correo Electrónico</label>
                        <i class="bi bi-envelope input-icon"></i>
                        <span asp-validation-for="Input.Email" class="text-danger mt-1 d-block"></span>
                    </div>

                    <div class="form-floating mb-4 position-relative">
                        <input asp-for="Input.PhoneNumber" class="form-control ps-5" placeholder="Teléfono" autocomplete="tel" aria-required="true" />
                        <label asp-for="Input.PhoneNumber">Teléfono</label>
                        <i class="bi bi-telephone input-icon"></i>
                        <span asp-validation-for="Input.PhoneNumber" class="text-danger mt-1 d-block"></span>
                    </div>

                    <div class="form-floating mb-4 position-relative">
                        <input asp-for="Input.Password" type="password" class="form-control ps-5" placeholder="Contraseña" autocomplete="new-password" aria-required="true" />
                        <label asp-for="Input.Password">Contraseña</label>
                        <i class="bi bi-lock input-icon"></i>
                        <span asp-validation-for="Input.Password" class="text-danger mt-1 d-block"></span>
                    </div>

                    <div class="form-floating mb-4 position-relative">
                        <input asp-for="Input.ConfirmPassword" type="password" class="form-control ps-5" placeholder="Confirmar Contraseña" autocomplete="new-password" aria-required="true" />
                        <label asp-for="Input.ConfirmPassword">Confirmar Contraseña</label>
                        <i class="bi bi-lock input-icon"></i>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger mt-1 d-block"></span>
                    </div>


                    <button type="submit" class="btn-custom d-flex align-items-center justify-content-center">
                        <i class="bi bi-check2 me-2"></i>REGISTRAR
                    </button>
                </form>

                <div class="text-center mt-4">
                    <p><a asp-page="./Login" class="text-link">¿Ya tienes una cuenta? Inicia Sesión</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}