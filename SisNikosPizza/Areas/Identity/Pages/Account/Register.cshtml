@page
@model RegisterModel
@{
    ViewData["Title"] = "Regístrate";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*
  DISEÑO UNIFICADO CON LOGIN:
  - Se eliminó el bloque <style> y se usan clases de Tailwind CSS.
  - Se replica el diseño de tarjeta con fondo de imagen contenida.
  - Se usa el patrón de "etiqueta flotante" para los inputs.
*@

<style>
    /* Animación de entrada para el formulario */
    .form-container-animate {
        animation: slide-in-fade 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.2s forwards;
        opacity: 0;
        /* Inicia invisible para la animación */
    }

    @@keyframes slide-in-fade {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<!-- Contenedor principal que ocupa toda la pantalla -->
<div class="min-h-screen w-full flex items-center justify-center p-4 font-sans bg-cover bg-center bg-fixed">

    <!-- Imagen de fondo de página completa -->
    <img fetchpriority="high" decoding="async" height="100%" width="100%" src="/Imagenes/register.avif"
        alt="Fondo de registro" class="absolute inset-0 w-full h-full object-cover -z-10" />

    <!-- Contenedor del Formulario -->
    <div
        class="form-container-animate relative w-full max-w-md p-8 lg:p-12 flex flex-col gap-6 bg-black/50 border border-white/20 rounded-3xl shadow-2xl">

        <div class="relative z-10 text-center">
            <dotlottie-player src="https://lottie.host/2d7a8310-619e-4f37-a0f8-01b3e0b8d1e4/8z9vF1gWnE.lottie"
                background="transparent" speed="1" class="w-32 h-32 -mt-4 mx-auto" loop autoplay
                aria-label="Animación de SisNikos">
            </dotlottie-player>
            <h1 class="text-3xl font-bold text-white text-shadow-lg">@ViewData["Title"]</h1>
            <p class="text-gray-200 mt-2 text-shadow-sm">Crea tu cuenta para disfrutar de NIKO'S.</p>
        </div>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="relative z-10 gap-8 flex flex-col">
            <div asp-validation-summary="ModelOnly"
                class="bg-red-500/80 border border-red-700 text-white px-4 py-2 rounded-lg text-sm text-center"
                role="alert"></div>

            <!-- Campos del formulario con etiqueta flotante -->
            <div class="relative">
                <input asp-for="Input.Username"
                    class="peer block w-full px-4 h-14 rounded-lg bg-white/10 text-white placeholder-transparent border-2 border-white/30 focus:ring-0 focus:border-yellow-400 focus:outline-none transition duration-300"
                    placeholder="Nombre de Usuario" autocomplete="username" aria-required="true" />
                <label asp-for="Input.Username"
                    class="absolute left-4 -top-2.5 text-sm text-gray-300 transition-all duration-300 peer-placeholder-shown:top-4 peer-placeholder-shown:text-base peer-placeholder-shown:text-gray-300 peer-focus:-top-2.5 peer-focus:text-yellow-300 peer-focus:text-sm">Nombre
                    de Usuario</label>
                <span asp-validation-for="Input.Username" class="text-red-400 text-xs absolute -bottom-5 left-2"></span>
            </div>

            <div class="relative">
                <input asp-for="Input.Email"
                    class="peer block w-full px-4 h-14 rounded-lg bg-white/10 text-white placeholder-transparent border-2 border-white/30 focus:ring-0 focus:border-yellow-400 focus:outline-none transition duration-300"
                    placeholder="Correo Electrónico" autocomplete="email" aria-required="true" />
                <label asp-for="Input.Email"
                    class="absolute left-4 -top-2.5 text-sm text-gray-300 transition-all duration-300 peer-placeholder-shown:top-4 peer-placeholder-shown:text-base peer-placeholder-shown:text-gray-300 peer-focus:-top-2.5 peer-focus:text-yellow-300 peer-focus:text-sm">Correo
                    Electrónico</label>
                <span asp-validation-for="Input.Email" class="text-red-400 text-xs absolute -bottom-5 left-2"></span>
            </div>

            <div class="relative">
                <input asp-for="Input.PhoneNumber"
                    class="peer block w-full px-4 h-14 rounded-lg bg-white/10 text-white placeholder-transparent border-2 border-white/30 focus:ring-0 focus:border-yellow-400 focus:outline-none transition duration-300"
                    placeholder="Teléfono" autocomplete="tel" aria-required="true" />
                <label asp-for="Input.PhoneNumber"
                    class="absolute left-4 -top-2.5 text-sm text-gray-300 transition-all duration-300 peer-placeholder-shown:top-4 peer-placeholder-shown:text-base peer-placeholder-shown:text-gray-300 peer-focus:-top-2.5 peer-focus:text-yellow-300 peer-focus:text-sm">Teléfono</label>
                <span asp-validation-for="Input.PhoneNumber"
                    class="text-red-400 text-xs absolute -bottom-5 left-2"></span>
            </div>

            <div class="relative">
                <input asp-for="Input.Password" type="password"
                    class="peer block w-full px-4 h-14 rounded-lg bg-white/10 text-white placeholder-transparent border-2 border-white/30 focus:ring-0 focus:border-yellow-400 focus:outline-none transition duration-300"
                    placeholder="Contraseña" autocomplete="new-password" aria-required="true" />
                <label asp-for="Input.Password"
                    class="absolute left-4 -top-2.5 text-sm text-gray-300 transition-all duration-300 peer-placeholder-shown:top-4 peer-placeholder-shown:text-base peer-placeholder-shown:text-gray-300 peer-focus:-top-2.5 peer-focus:text-yellow-300 peer-focus:text-sm">Contraseña</label>
                <span asp-validation-for="Input.Password" class="text-red-400 text-xs absolute -bottom-5 left-2"></span>
            </div>

            <div class="relative">
                <input asp-for="Input.ConfirmPassword" type="password"
                    class="peer block w-full px-4 h-14 rounded-lg bg-white/10 text-white placeholder-transparent border-2 border-white/30 focus:ring-0 focus:border-yellow-400 focus:outline-none transition duration-300"
                    placeholder="Confirmar Contraseña" autocomplete="new-password" aria-required="true" />
                <label asp-for="Input.ConfirmPassword"
                    class="absolute left-4 -top-2.5 text-sm text-gray-300 transition-all duration-300 peer-placeholder-shown:top-4 peer-placeholder-shown:text-base peer-placeholder-shown:text-gray-300 peer-focus:-top-2.5 peer-focus:text-yellow-300 peer-focus:text-sm">Confirmar
                    Contraseña</label>
                <span asp-validation-for="Input.ConfirmPassword"
                    class="text-red-400 text-xs absolute -bottom-5 left-2"></span>
            </div>

            <div class="pt-2">
                <button type="submit"
                    class="w-full flex justify-center items-center gap-2 py-3 px-4 text-lg font-bold text-gray-800 bg-gradient-to-r from-yellow-400 to-orange-400 rounded-full shadow-lg hover:shadow-yellow-400/50 hover:-translate-y-1 transform-gpu transition-all duration-300 ease-in-out focus:outline-none focus:ring-4 focus:ring-yellow-400/50">
                    <i class="bi bi-check2-circle"></i>
                    Crear Cuenta
                </button>
            </div>
        </form>

        <div class="relative z-10 text-center mt-6">
            <a asp-page="./Login" class="font-medium text-gray-300 hover:text-white hover:underline">¿Ya tienes una
                cuenta? Inicia Sesión</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}