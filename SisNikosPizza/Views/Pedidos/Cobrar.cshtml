@using SisNikosPizza.Utilidades
@model SisNikosPizza.Models.CobrarPedidoModel

@{
    ViewData["Title"] = "Cobrar Pedido";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<div class="container-fluid py-4">
    <div class="card shadow-lg rounded-lg">
        <!-- Cabecera -->
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0">Cobrar Pedido</h3>
        </div>

        <!-- Contenido -->
        <div class="card-body">
            <!-- Info Pedido -->
            <div class="mb-4">
                <h5><b>Tipo de Pedido:</b> <span class="badge bg-secondary">@Model.Pedido.TipoPedido</span></h5>
                <h5><b>Fecha de Pedido:</b> @Model.Pedido.FechaPedido.ToString("dd/MM/yyyy HH:mm")</h5>
            </div>

            <!-- Tabla Productos -->
            <div class="table-responsive mb-4">
                <table class="table table-striped table-hover text-center align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Imagen</th>
                            <th>Nombre</th>
                            <th>Cantidad</th>
                            <th>Precio Unitario</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Pedido.DetallePedidos != null && Model.Pedido.DetallePedidos.Any())
                        {
                            foreach (var item in Model.Pedido.DetallePedidos)
                            {
                                <tr>
                                    <td>
                                        <img src="@item.Producto.ImagenUrl" alt="@item.Producto.Nombre" class="rounded" style="width: 60px; height: 60px; object-fit: cover;" />
                                    </td>
                                    <td>@item.Producto.Nombre</td>
                                    <td>@item.Cantidad</td>
                                    <td>S/. @item.Producto.Precio.ToString("0")</td> <!-- Mostrar solo enteros -->
                                    <td>S/. @(Math.Round(item.Cantidad * item.Producto.Precio))</td> <!-- Mostrar total solo como entero -->
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-danger">No hay productos en el pedido.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Total y Botón -->
            <form asp-controller="Venta" asp-action="CrearVenta" asp-route-id="@Model.Pedido.PedidoId" method="post">
                @{
                    var total = Model.Pedido.DetallePedidos.Sum(x => x.Cantidad * x.Producto.Precio);
                }
                <div class="d-flex justify-content-between align-items-center">
                    <h3 class="text-success fw-bold">Total a Cobrar: S/. @Math.Round(total)</h3>

                    <button type="submit" class="btn btn-lg btn-success shadow-sm">
                        <i class="bi bi-cash-coin me-2"></i> Cobrar Pedido
                    </button>
                </div>
            </form>

            <!-- <a asp-controller="Venta" asp-action="Index">
                
                <div class="d-flex justify-content-between align-items-center">
                    <h3 class="text-success fw-bold">Total a Cobrar: S/. </h3>

                    <button type="submit" class="btn btn-lg btn-success shadow-sm">
                        <i class="bi bi-cash-coin me-2"></i> Cobrar Pedido
                    </button>
                </div>
            </a> -->

        </div>
    </div>
</div>

<!-- Estilos Personalizados -->
<style>
    .table thead th {
        vertical-align: middle;
    }

    .table tbody td {
        vertical-align: middle;
    }

    .badge {
        font-size: 1rem;
        padding: 0.5em 0.7em;
    }

    .btn-success:hover {
        background-color: #27ae60;
        transform: scale(1.05);
        transition: all 0.3s ease;
    }
</style>
