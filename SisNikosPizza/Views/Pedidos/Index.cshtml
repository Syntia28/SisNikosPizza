@model IEnumerable<SisNikosPizza.Domain.Models.Pedido>
@using SisNikosPizza.Utilidades
@using Microsoft.AspNetCore.Identity

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

    @{
    ViewData["Title"] = "Pedidos";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<div class="container-fluid py-4">
    <div class="card shadow-sm">
        <!-- Cabecera -->
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 class="mb-0">Pedidos</h2>
            <a class="btn btn-success btn-sm" asp-controller="Pedidos" asp-action="Nuevo">
                <i class="bi bi-file
                -earmark-plus"></i>&nbsp;Nuevo Pedido
                </a>
                </div>
                <!-- Filtros y Opciones -->
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-3">
                        <div>
                            <label for="entries" class="form-label me-2">Mostrar</label>
                            <select id="entries" class="form-select d-inline-block" style="width: auto;">
                                <option>10</option>
                                <option>25</option>
                                <option>50</option>
                                <option>100</option>
                            </select>
                            <span>registros por página</span>
                        </div>
                        <div>
                            <input type="search" class="form-control" placeholder="Buscar" style="width: 300px;" />
                        </div>
                    </div>
                    <!-- Tabla -->
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped align-middle">
                            <thead class="table-light text-center">
                                <tr>
                       
                                    <th>Fecha</th>
                            <th>Cliente</th>
                          
                                    <th>Total</th>
                                    <th>Estado</th>
                                    <th>Opciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pedido in Model)
                                {
                                    <tr>
                                      
                                        <td>@pedido.FechaPedido</td>
                                <td>@pedido.Owner.NormalizedEmail</td>
                               
                                        <td>S/. @pedido.DetallePedidos.Sum(dp => dp.Cantidad*dp.Producto.Precio)</td>
                                        <td>
                                            @if (pedido.EstadoPedido==VCG.EstadoPedido.Pagado)
                                            {
                                        <span class="badge bg-success">Pagado</span>
                                    }else if (pedido.EstadoPedido==VCG.EstadoPedido.Entregado)
                                    {
                                        <span>
                                            class="badge bg-primary">Entregado

                                        </span>
                                    }else if (pedido.EstadoPedido==VCG.EstadoPedido.Anulado)
                                    {
                                        <span class="badge bg-danger">Anulado</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">Pendiente</span>
                                    }

                                        </td>
                                        <td class="text-center">
                                   
                                        <a class="btn btn-info btn-sm me-1" asp-controller="Pedidos" asp-action="Detalles" asp-route-id="@pedido.PedidoId">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                     @*     <a class="btn btn-danger btn-sm" asp-controller="Pedidos" asp-action="Eliminar" asp-route-id="@pedido.PedidoId">
                                             <i class="fas fa-trash"></i>
                                         </a> *@

                                    @if (User.IsInRole(VCG.Role_Admin)) 
                                    {
                                          @if (pedido.EstadoPedido != VCG.EstadoPedido.Pagado)
                                            {
                                                <a class="btn btn-success btn-sm" asp-controller="Pedidos" asp-action="Cobrar" asp-route-id="@pedido.PedidoId">
                                                    <i class="fas fa-cash-register"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <button class="btn btn-success btn-sm" disabled>
                                                    <i class="fas fa-cash-register"></i>
                                                </button>
                                            }
                                          
                                              
                                    }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            </table>
                            </div>
                            </div>
                            </div>
                            </div>
                            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
                            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.min.js"></script>
                           