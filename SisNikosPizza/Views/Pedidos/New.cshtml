@model SisNikosPizza.Models.PedidoVistaModel


    @{
    ViewData["Title"] = "Pedido";
    Layout = "~/Views/Shared/_Admin.cshtml";
}



<div style="display: flex; justify-content: space-between;">
    <!-- Sección Izquierda -->
    <div style="width: 45%;">
        <h3>Productos Disponibles</h3>
        <ul>
            @foreach (var producto in Model.ProductosDisponibles)
            {
                <li>
                    @producto.Nombre 
                    <form method="post" action="/Pedido/Create" style="display: inline;">
                        <input type="hidden" name="productId" value="@producto.ProductoId" />
                        <button type="submit">Add</button>
                    </form>
                </li>
            }
        </ul>
    </div>

    <!-- Sección Derecha -->
    <div style="width: 45%;">
        <h3>Pedidos</h3>
        <ul>
            @foreach (var pedido in Model.Pedidos)
            {
                <li>
                    @pedido.Producto.Nombre
                    <div style="display: flex; align-items: center;">
                        <!-- Botón para Decrease -->
                        <form method="post" action="/Pedido/Decrease" style="margin-right: 10px;">
                            <input type="hidden" name="pedidoId" value="@pedido.PedidoId" />
                            <button type="submit">-</button>
                        </form>

                        <!-- Cantidad -->
                        <span>@pedido.Cantidad</span>

                        <!-- Botón para Increase -->
                        <form method="post" action="/Pedido/Increase" style="margin-left: 10px;">
                            <input type="hidden" name="pedidoId" value="@pedido.PedidoId" />
                            <button type="submit">+</button>
                        </form>
                    </div>
                </li>
            }
        </ul>
    </div>
</div>
