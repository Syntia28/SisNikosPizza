@using SisNikosPizza.Utilidades
@model SisNikosPizza.Domain.ViewModels.VMDDetallesPedido

@{
    ViewData["Title"] = "Boleta de Pago";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

@section Styles {
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@4"></script>
    <script defer src="https://unpkg.com/@@alpinejs/collapse@3.x.x/dist/cdn.min.js"></script>
    <script src="https://unpkg.com/alpinejs" defer></script>

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #fef3c7, #fee2e2); /* Warm yellow gradient */
            color: #212121;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            min-height: 100vh;
        }

        .container {
            max-width: 1400px;
            padding: 2rem 1.5rem;
            margin: 0 auto;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        .boleta-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border-radius: 1.5rem;
            border: 2px solid #f1c40f;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1);
            padding: 1.5rem;
            width: 100%;
            max-width: 28rem; /* Matches previous card size */
            position: relative;
            animation: float 4s ease-in-out infinite;
        }

        .boleta-card::before {
            content: '';
            position: absolute;
            top: -40%;
            left: -40%;
            width: 180%;
            height: 180%;
            background: radial-gradient(circle, rgba(241, 196, 15, 0.1) 0%, transparent 70%);
            animation: rotate 12s linear infinite;
            z-index: 0;
        }
        .card-content {
            position: relative;
            z-index: 1;
        }

        .header-text {
            font-size: 1.875rem;
            font-weight: 700;
            color: #e67e22;
            text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.1);
            letter-spacing: 1px;
        }

        .subtext {
            color: #7f8c8d;
            font-style: italic;
            font-size: 0.75rem;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            padding: 0.5rem 0;
            font-size: 0.875rem;
        }

        .order-item {
            display: flex;
            justify-content: space-between;
            padding: 0.5rem 0;
            border-bottom: 1px dashed #e0e0e0;
        }

        .total {
            display: flex;
            justify-content: space-between;
            padding: 0.75rem 0;
            font-size: 1.125rem;
            font-weight: 600;
            color: #e74c3c;
        }

        .export-button {
            background: linear-gradient(45deg, #e74c3c, #c0392b);
            color: white;
            border-radius: 0.5rem;
            padding: 0.5rem 1rem;
            font-weight: 500;
            transition: all 0.3s ease;
        }

            .export-button:hover {
                background: linear-gradient(45deg, #c0392b, #a93226);
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(231, 76, 60, 0.3);
            }

    </style>
}

<div class="flex items-center justify-center min-h-screen bg-gradient-to-tr from-gray-100 to-gray-200" role="main">
    <div class="container">
        <div class="boleta-card">
            <div class="card-content">
                <div class="flex flex-col items-center mb-4 text-center">
                    <span class="header-text">NIKOS PIZZA</span>
                    <span class="subtext">Boleta de Pago</span>
                    <span class="text-xs text-gray-400">Fecha: @Model.FechaPedido.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <div class="border-b border-gray-200 mb-4"></div>
                <div class="mb-4">
                    <div class="detail-row">
                        <span class="font-semibold">Cliente:</span>
                        <span>@Model.Usuario.UserName</span>
                    </div>
                    @if (Model.Detalles.First().Pedido.Direccion != null)
                    {
                        <div class="detail-row">
                            <span class="font-semibold">Dirección:</span>
                            <span>@Model.Detalles.First().Pedido.Direccion</span>
                        </div>
                    }
                </div>
                <div class="border-b border-gray-200 mb-4"></div>
                <div>
                    <span class="font-semibold text-gray-700">Detalle del Pedido:</span>
                    <ul class="mt-2 mb-4 text-sm">
                        @foreach (var pedido in Model.Detalles)
                        {
                            <li class="order-item">
                                <span class="flex items-center gap-1">
                                    <i class="fa-solid fa-pizza-slice text-yellow-600"></i>
                                    @pedido.Cantidad
                                </span>
                                <span>@pedido.Producto.Nombre</span>
                                <span>S/ @pedido.PrecioTotal.ToString("0.00")</span>
                            </li>
                        }
                    </ul>
                </div>
                <div class="total">
                    <span>Total:</span>
                    <span class="text-green-600">S/ @Model.Detalles.Sum(d => d.PrecioTotal).ToString("0.00")</span>
                </div>
                <div class="detail-row text-xs">
                    <span class="text-gray-400">Método:</span>
                    <span class="text-gray-600">@Model.Detalles.First().Pedido.TipoPedido</span>
                </div>

                <form asp-controller="Reportes"
                      asp-action="ExportarBoleta"
                      method="post"
                      class="mt-4"
                      aria-label="Exportar boleta">
                    <input type="hidden" name="id" value="@Model.Detalles.First().Pedido.PedidoId" />
                    <button type="submit" class="export-button w-full">
                        <i class="fa-solid fa-file-arrow-down mr-2"></i> Exportar Boleta
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}