@using SisNikosPizza.Utilidades
@model SisNikosPizza.Domain.ViewModels.VMDDetallesPedido

@{
    ViewData["Title"] = "Boleta de Pago";
    Layout = "~/Views/Shared/_Admin.cshtml";
}
@section Styles {
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@4"></script>
    <script defer src="https://unpkg.com/@@alpinejs/collapse@3.x.x/dist/cdn.min.js"></script>
    <script src="https://unpkg.com/alpinejs" defer></script>
}

<div class="flex flex-col items-center gap-8 py-8 bg-gray-100 min-h-screen" role="main">
        <div class="w-full max-w-md bg-white rounded-lg shadow-lg border-2 border-dashed border-gray-300 p-6 relative">
            <div class="flex flex-col items-center mb-4">
                <span class="text-2xl font-bold text-indigo-700 tracking-widest">NIKOS PIZZA</span>
                <span class="text-sm text-gray-500">Boleta de Pago</span>
                <span class="text-xs text-gray-400">Fecha: @Model.FechaPedido.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
            <div class="border-b border-gray-200 mb-4"></div>
            <div class="mb-2">
                <div class="flex justify-between text-sm">
                    <span class="font-semibold">Cliente:</span>
                    <span>@Model.Usuario.UserName</span>
                </div>
                @if(Model.Detalles.First().Pedido.Direccion != null){
                    <div class="flex justify-between text-sm">
                        <span class="font-semibold">Dirección:</span>
                        <span>@Model.Detalles.First().Pedido.Direccion</span>
                    </div>
                }
            </div>
            <div class="border-b border-gray-200 mb-4"></div>
            <div>
                <span class="font-semibold text-gray-700">Detalle del Pedido:</span>
                <ul class="mt-2 mb-4 text-sm">
                    @foreach (var pedido in Model.Detalles)
                    {
                        <li class="flex justify-between items-center py-1 border-b border-dashed border-gray-200 last:border-b-0">
                            <span>
                                <i class="fa-solid fa-pizza-slice text-yellow-600"></i>
                                @pedido.Cantidad
                            </span>
                            <span>@pedido.Producto.Nombre</span>
                            <span>S/ @pedido.PrecioTotal.ToString("0.00")</span>
                        </li>
                    }
                </ul>
            </div>
            <div class="flex justify-between items-center font-bold text-lg mb-4">
                <span>Total:</span>
                <span class="text-green-600">S/ @Model.Detalles.Sum(d => d.PrecioTotal).ToString("0.00")</span>
            </div>
            <div class="flex justify-between items-center mb-2">
                <span class="text-xs text-gray-400">Método:</span>
                <span class="text-xs text-gray-600">@Model.Detalles.First().Pedido.TipoPedido</span>
            </div>

            <form 
                asp-controller="Reportes" 
                asp-action="ExportarBoleta" 
                method="post"
                class="absolute top-2 right-2 flex gap-4"
            >
                <input type="hidden" name="id" value="@Model.Detalles.First().Pedido.PedidoId" />
                <button type="submit"
                    class="flex-1 bg-red-500 hover:bg-red-600 text-white font-medium px-4 py-2 rounded-lg transition-colors">
                    <i class="fa-solid fa-file-arrow-down"></i>
                </button>
            </form>
        </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
