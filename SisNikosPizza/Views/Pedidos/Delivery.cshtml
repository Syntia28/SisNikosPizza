@using SisNikosPizza.Utilidades
@model IEnumerable<SisNikosPizza.Domain.ViewModels.VMDDetallesPedido>

@{
    ViewData["Title"] = "Lista de Pedidos Delivery";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

@section Styles {
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@4"></script>
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <script defer src="https://unpkg.com/@@alpinejs/collapse@3.x.x/dist/cdn.min.js"></script>

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #fef3c7, #fee2e2);
            color: #212121;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            min-height: 100vh;
        }

        .container {
            max-width: 1400px;
            padding: 2rem 1.5rem;
            margin: 0 auto;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            min-height: 100vh;
        }

        .card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border-radius: 1rem;
            border: 2px solid #f1c40f;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            padding: 1rem;
            width: 100%;
            max-width: 300px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .card:hover {
                transform: translateY(-5px);
                box-shadow: 0 15px 40px rgba(0, 0, 0, 0.2);
            }

            .card::before {
                content: '';
                position: absolute;
                top: -30%;
                left: -30%;
                width: 160%;
                height: 160%;
                background: radial-gradient(circle, rgba(241, 196, 15, 0.1) 0%, transparent 70%);
                animation: rotate 12s linear infinite;
                z-index: 0;
            }

       

        .card-content {
            position: relative;
            z-index: 1;
        }

        .header-text {
            font-size: 1.25rem;
            font-weight: 600;
            color: #e67e22;
            text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.1);
        }

        .detail-item {
            display: flex;
            gap: 0.5rem;
            font-size: 0.875rem;
            color: #7f8c8d;
            margin-bottom: 0.5rem;
        }

        .price {
            font-size: 1.125rem;
            font-weight: 600;
            color: #e74c3c;
        }

        .toggle-button {
            background: linear-gradient(45deg, #2ecc71, #27ae60);
            color: white;
            border-radius: 0.5rem;
            padding: 0.5rem 1rem;
            font-weight: 500;
            transition: all 0.3s ease;
            width: 100%;
        }

            .toggle-button:hover {
                background: linear-gradient(45deg, #27ae60, #219653);
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(46, 204, 113, 0.3);
            }

        .collapsible-content {
            margin-top: 0.5rem;
            padding: 0.5rem;
            background: #fff3e0;
            border-radius: 0.5rem;
            max-height: 200px;
            overflow-y: auto;
        }

        .collapsible-item {
            display: flex;
            justify-content: space-between;
            padding: 0.25rem 0;
            font-size: 0.875rem;
            color: #34495e;
        }

        .status-select {
            background: linear-gradient(45deg, #3498db, #2980b9);
            color: white;
            border: none;
            border-radius: 0.5rem;
            padding: 0.5rem;
            font-weight: 500;
            width: 100%;
            transition: all 0.3s ease;
            appearance: none;
            cursor: pointer;
        }

            .status-select:hover {
                background: linear-gradient(45deg, #2980b9, #2471a3);
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(52, 152, 219, 0.3);
            }

        .action-button {
            background: linear-gradient(45deg, #3498db, #2980b9);
            color: white;
            border-radius: 0.5rem;
            padding: 0.75rem;
            font-weight: 500;
            width: 100%;
            transition: all 0.3s ease;
        }

            .action-button:hover {
                background: linear-gradient(45deg, #2980b9, #2471a3);
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(52, 152, 219, 0.3);
            }

       
        

        
       
    </style>
}

<div class="flex items-center justify-center min-h-screen bg-gradient-to-tr from-gray-100 to-gray-200" role="main">
    <div class="container">
        <div class="grid" role="list">
            @foreach (var item in Model)
            {
                <div class="card relative" role="listitem">
                    <div class="card-content">
                        <div class="relative">
                            @{
                                // Get the first DetallePedido and its associated Producto
                                var firstDetalle = item.Detalles.FirstOrDefault();
                                string imageUrl = firstDetalle?.Producto?.ImagenUrl;
                                // Adjust the path if images are stored in wwwroot (e.g., prepend "/images/")
                                if (!string.IsNullOrEmpty(imageUrl) && !imageUrl.StartsWith("http"))
                                {
                                    imageUrl = $"/images/{imageUrl}";
                                }
                            }
                            <img src="/logo/logo.png" alt="Product Image for @firstDetalle?.Producto?.Nombre" class="w-full h-40 object-cover rounded-t-lg" />
                            <span class="absolute top-2 right-2 bg-red-500 text-white px-2 py-1 rounded-full text-xs font-medium">
                                Delivery
                            </span>
                        </div>

                        <div class="p-2 space-y-2">
                            <div>
                                <div class="detail-item">
                                    <i class="fa-solid fa-truck-fast text-yellow-600"></i>
                                    <h3 class="header-text">@firstDetalle?.Producto?.Nombre ?? "Producto 1"</h3>
                                </div>
                                <div class="detail-item">
                                    <i class="fa-solid fa-user text-yellow-600"></i>
                                    <p class="text-gray-500">@item.Usuario.UserName</p>
                                </div>
                                @if (item.Detalles.First().Pedido.Direccion != null)
                                {
                                    <div class="detail-item">
                                        <i class="fa-solid fa-location-dot text-yellow-600"></i>
                                        <p class="text-gray-500">@item.Detalles.First().Pedido.Direccion</p>
                                    </div>
                                }
                            </div>

                            <div class="flex justify-between items-center">
                                <div class="space-y-1">
                                    <p class="price">S/ @item.Detalles.Sum(d => d.PrecioTotal)</p>
                                </div>
                                <div class="flex items-center gap-1">
                                    <span class="text-gray-500">Cantidad</span>
                                    <span class="text-gray-700 font-medium">@item.Detalles.Sum(d => d.Cantidad)</span>
                                </div>
                            </div>

                            <div class="flex flex-col items-center" x-data="{ reportsOpen: false }">
                                <button x-on:click="reportsOpen = !reportsOpen" class="toggle-button">
                                    <i class="fa-solid fa-clipboard-list mr-2"></i>
                                    Ver lista de pedido
                                </button>

                                <div class="collapsible-content" x-cloak x-show="reportsOpen" x-collapse x-collapse.duration.500ms>
                                    <ul class="flex flex-col gap-1">
                                        @foreach (var pedido in item.Detalles)
                                        {
                                            <li class="collapsible-item">
                                                <span class="flex items-center gap-1">
                                                    <i class="fa-solid fa-truck-fast text-green-600"></i>
                                                    @pedido.Cantidad
                                                </span>
                                                <span class="flex items-center gap-1">
                                                    <i class="fa-solid fa-dollar text-green-600"></i>
                                                    S/ @pedido.PrecioTotal
                                                </span>
                                                <span class="flex items-center gap-1">
                                                    <i class="fa-solid fa-box-open text-green-600"></i>
                                                    @pedido.Producto.Nombre
                                                </span>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>

                            <form asp-controller="Pedidos" asp-action="UpdateStatus" method="post" class="mt-2">
                                <input type="hidden" name="pedidoId" value="@item.Detalles.First().Pedido.PedidoId" />
                                <select name="status" class="status-select" aria-label="Cambiar estado del pedido">
                                    <option value="Pendiente">Pedido Pendiente</option>
                                    <option value="EnCamino">En Camino</option>
                                    <option value="Entregado">Pedido Entregado</option>
                                </select>
                                <button type="submit" class="action-button mt-2">
                                    Actualizar Estado
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}