@using SisNikosPizza.Utilidades
@model SisNikosPizza.Models.NuevoPedidoVista

@{
    ViewData["Title"] = "Nuevo Pedido";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<div class="container-fluid py-4">
    <div class="shadow-sm">
        <!-- Cabecera -->
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 class="mb-0">Nuevo Pedido</h2>
        </div>

        <!-- Filtros y Opciones -->
        <div  style=" background-color: rgba(255, 255, 255, 0.8);">

            <!-- Tabla -->
            <div class="table-responsive">
                <table class="table table-bordered table-striped align-middle">
                    <thead class="table-light text-center">
                        <tr>
                            <th>Imagen</th>
                            <th>Nombre</th>
                            <th>Cantidad</th>
                            <th>Precio unitario</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var carritoItem in Model.CarritoProductos)
                        {
                            <tr>
                                <td>
                                    <img src="@carritoItem.Producto.ImagenUrl" alt="@carritoItem.Producto.Nombre" style="width: 50px; height: 50px;" />
                                </td>
                                <td>
                                    <span>
                                        @carritoItem.Producto.Nombre
                                    </span>
                                </td>
                                <td class="text-center">
                                    @carritoItem.Cantidad
                                </td>
                                <td class="text-end">
                                    $@carritoItem.Producto.Precio
                                </td>
                                <td class="text-end">
                                    $@(carritoItem.Cantidad * carritoItem.Producto.Precio)
                                </td>
                              
                                        </tr>
                                        }
                                        </tbody>
                                        </table>
                                        <div>
                    <form method="post" asp-controller="Pedidos" asp-action="CrearPedido">
                        <div class="mb-3">
                            <label for="TipoPedido" class="form-label">Tipo Pedido</label>
                         
                            <select id="tipoPedidoSelect" name="TipoPedido" asp-for="@Model.Pedido.TipoPedido" class="form-select">
                                <option value="">Seleccion el tipo de pedido</option>
                                <option value="@VCG.TipoPedido.Delivery" selected="@((ViewBag.TipoPedido == VCG.TipoPedido.Delivery) ? "selected" : null)">@VCG.TipoPedido.Delivery</option>
                                <option value="@VCG.TipoPedido.Recoger" selected="@((ViewBag.TipoPedido == VCG.TipoPedido.Recoger) ? "selected" : null)">@VCG.TipoPedido.Recoger</option>
                                <option value="@VCG.TipoPedido.Mesa" selected="@((ViewBag.TipoPedido == VCG.TipoPedido.Mesa) ? "selected" : null)">@VCG.TipoPedido.Mesa</option>
                            </select>

                            <script>
                                document.getElementById('tipoPedidoSelect').addEventListener('change', function () {
                                    var selectedValue = this.value;
                                    window.location.href = '@Url.Action("Nuevo", "Pedidos")?TipoPedido=' + selectedValue;
                                });
                            </script>

                            <span id="errorTipoPedido" class="text-danger">@ViewBag.ErrorTipoPedido</span>
                        </div>

                        @if (ViewBag.TipoPedido == VCG.TipoPedido.Delivery)
                        {
                            <div class="mb-3">
                                <label for="Telefono" class="form-label">Telefono</label>
                                <input type="text" id="Telefono" name="Telefono" asp-for="@Model.Pedido.Telefono" class="form-control" />
                                <span class="text-danger">@ViewBag.ErrorTelefono</span>
                            </div>
                            <div class="mb-3">
                                <label for="Direccion" class="form-label">Dirección</label>
                                <input type="text" id="Direccion" name="Direccion" asp-for="@Model.Pedido.Direccion" class="form-control" />
                                <span class="text-danger">@ViewBag.ErrorDireccion</span>
                            </div>
                            <div class="mb-3">
                                <label for="Referencia" class="form-label">Referencia</label>
                                <input type="text" id="Referencia" name="Referencia" asp-for="@Model.Pedido.Referencia" class="form-control" />
                                <span class="text-danger">@ViewBag.ErrorReferencia</span>
                            </div>
                        }
                        @if (ViewBag.TipoPedido == VCG.TipoPedido.Recoger)
                        {
                            <div class="mb-3">
                                <span>Nuestra Direccion</span>
                                <p>Recoger en: Av. xd de la Pizzeria</p>
                            </div>
                            <div class="mb-3">
                                <label for="FechaRecogo" class="form-label">Fecha Recogo</label>
                                <input type="datetime-local" id="FechaRecogo" name="FechaRecogo" asp-for="@Model.Pedido.FechaRecogo" class="form-control" />
                                <span class="text-danger">@ViewBag.ErrorFechaRecogo</span>
                            </div>
                            
                        }

                        @if (ViewBag.TipoPedido == VCG.TipoPedido.Mesa)
                        {
                            
                            <div class="mb-3">
                                <label for="FechaRecogo" class="form-label">Escribe el numero o nombre de la mesa</label>
                                <input type="text" id="Mesa" name="Mesa" asp-for="@Model.Pedido.Mesa" class="form-control" />
                                <span class="text-danger">@ViewBag.ErrorMesa</span>
                            </div>

                        }

                        <div>
                            <span class="text-danger">@ViewBag.ErrorCarroVacio</span>
                        </div>
                        <div class="d-flex justify-content-end mt-4">
                        <div class="text-end">
                            <p class="mb-1">
                                <strong>Subtotal:</strong>
                                S/. @Math.Round(Model.CarritoProductos.Sum(item => item.Cantidad * item.Producto.Precio) * 0.82, 2)
                            </p>
                            <p class="mb-1">
                                <strong>Impuestos (18%):</strong>
                                S/. @Math.Round(Model.CarritoProductos.Sum(item => item.Cantidad * item.Producto.Precio) * 0.18, 2)
                            </p>
                            <p class="mb-1">
                                <strong>Total:</strong>
                                S/. @Model.CarritoProductos.Sum(item => item.Cantidad * item.Producto.Precio)
                            </p>


                        </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <h3 class="mb-0">Total: $@Model.CarritoProductos.Sum(x => x.Cantidad * x.Producto.Precio)</h3>
                           
                            <button type="submit" class="btn btn-primary">Realizar Pedido</button>
                        </div>
                                            </form>

                                        </div>
                                        </div>
                                        </div>
                                        </div>
                                        </div>

                                        <script>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.querySelector("form");
        const tipoPedido = document.querySelector("#tipoPedidoSelect");
        const errorTipoPedido = document.querySelector("#errorTipoPedido");

        form.addEventListener("submit", function (e) {
            e.preventDefault();
            alert("hola")
            return;
            // Limpiar mensajes de error previos
            errorTipoPedido.textContent = "";

            // Validar el campo tipoPedido
            if (!tipoPedido.value) {
                errorTipoPedido.textContent = "Por favor, selecciona un tipo de pedido.";
                e.preventDefault(); // Detener el envío del formulario
                return;
            }
        });
    });

                                        </script>
                                       
