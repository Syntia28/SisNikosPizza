@using SisNikosPizza.Utilidades
@model SisNikosPizza.Models.NuevoPedidoVista

@{
    ViewData["Title"] = "Nuevo Pedido";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<div class="container py-5">
    <div class="card shadow-sm">
        <!-- Cabecera -->
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h2 class="mb-0">Nuevo Pedido</h2>
        </div>

        <!-- Contenido -->
        <div class="card-body" style="background-color: rgba(255, 255, 255, 0.9);">
            @if (!Model.CarritoProductos.Any())
            {
                <div class="text-center">
                    <p class="text-muted fs-5">No hay productos en tu carrito.</p>
                    <a href="/Carta" class="btn btn-primary">Ver Carta</a>
                </div>
            }
            else
            {
                <!-- Tabla de Productos -->
                <div class="table-responsive mb-4">
                    <table class="table table-bordered table-hover align-middle">
                        <thead class="table-light text-center">
                            <tr>
                                <th>Imagen</th>
                                <th>Nombre</th>
                                <th>Cantidad</th>
                                <th>Precio Unitario</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var carritoItem in Model.CarritoProductos)
                            {
                                <tr>
                                    <td class="text-center">
                                        <img src="@carritoItem.Producto.ImagenUrl" alt="@carritoItem.Producto.Nombre" class="img-fluid rounded" style="width: 50px; height: 50px;">
                                    </td>
                                    <td>@carritoItem.Producto.Nombre</td>
                                    <td class="text-center">@carritoItem.Cantidad</td>
                                    <td class="text-end">$@carritoItem.Producto.Precio.ToString("0.00")</td>
                                    <td class="text-end">$@(carritoItem.Cantidad * carritoItem.Producto.Precio).ToString("0.00")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Formulario -->
                <form method="post" asp-controller="Pedidos" asp-action="CrearPedido">
                    <div class="mb-3">
                        <label for="TipoPedido" class="form-label">Tipo de Pedido</label>
                        <select id="tipoPedidoSelect" name="TipoPedido" asp-for="@Model.Pedido.TipoPedido" class="form-select">
                            <option value="">Selecciona el tipo de pedido</option>
                            <option value="@VCG.TipoPedido.Delivery" selected="@((ViewBag.TipoPedido == VCG.TipoPedido.Delivery) ? "selected" : null)">Delivery</option>
                            <option value="@VCG.TipoPedido.Recoger" selected="@((ViewBag.TipoPedido == VCG.TipoPedido.Recoger) ? "selected" : null)">Recoger</option>
                            <option value="@VCG.TipoPedido.Mesa" selected="@((ViewBag.TipoPedido == VCG.TipoPedido.Mesa) ? "selected" : null)">En Mesa</option>
                        </select>
                        <span id="errorTipoPedido" class="text-danger">@ViewBag.ErrorTipoPedido</span>
                    </div>

                    <!-- Campos Condicionales -->
                    @if (ViewBag.TipoPedido == VCG.TipoPedido.Delivery)
                    {
                        <div class="mb-3">
                            <label for="Telefono" class="form-label">Teléfono</label>
                            <input type="text" id="Telefono" name="Telefono" asp-for="@Model.Pedido.Telefono" class="form-control">
                            <span class="text-danger">@ViewBag.ErrorTelefono</span>
                        </div>
                        <div class="mb-3">
                            <label for="Direccion" class="form-label">Dirección</label>
                            <input type="text" id="Direccion" name="Direccion" asp-for="@Model.Pedido.Direccion" class="form-control">
                            <span class="text-danger">@ViewBag.ErrorDireccion</span>
                        </div>
                        <div class="mb-3">
                            <label for="Referencia" class="form-label">Referencia</label>
                            <input type="text" id="Referencia" name="Referencia" asp-for="@Model.Pedido.Referencia" class="form-control">
                            <span class="text-danger">@ViewBag.ErrorReferencia</span>
                        </div>
                    }
                    @if (ViewBag.TipoPedido == VCG.TipoPedido.Recoger)
                    {
                        <div class="mb-3">
                            <p><strong>Recoger en:</strong> Av. XD de la Pizzería</p>
                            <label for="FechaRecogo" class="form-label">Fecha de Recogida</label>
                            <input type="datetime-local" id="FechaRecogo" name="FechaRecogo" asp-for="@Model.Pedido.FechaRecogo" class="form-control">
                            <span class="text-danger">@ViewBag.ErrorFechaRecogo</span>
                        </div>
                    }
                    @if (ViewBag.TipoPedido == VCG.TipoPedido.Mesa)
                    {
                        <div class="mb-3">
                            <label for="Mesa" class="form-label">Número o Nombre de la Mesa</label>
                            <input type="text" id="Mesa" name="Mesa" asp-for="@Model.Pedido.Mesa" class="form-control">
                            <span class="text-danger">@ViewBag.ErrorMesa</span>
                        </div>
                    }

                    <!-- Resumen y Total -->
                    <div class="text-end mt-4">
                        <p><strong>Subtotal:</strong> S/. @Math.Round(Model.CarritoProductos.Sum(item => item.Cantidad * item.Producto.Precio) * 0.82, 2)</p>
                        <p><strong>Impuestos (18%):</strong> S/. @Math.Round(Model.CarritoProductos.Sum(item => item.Cantidad * item.Producto.Precio) * 0.18, 2)</p>
                        <p><strong>Total:</strong> S/. @Model.CarritoProductos.Sum(item => item.Cantidad * item.Producto.Precio)</p>
                    </div>

                    <!-- Botón -->
                    <div class="text-end mt-3">
                        <button type="submit" class="btn btn-success">Realizar Pedido</button>
                    </div>
                </form>
            }
        </div>
    </div>
</div>

<script>
    document.getElementById('tipoPedidoSelect').addEventListener('change', function () {
        var selectedValue = this.value;
        window.location.href = '@Url.Action("Nuevo", "Pedidos")?TipoPedido=' + selectedValue;
    });
    document.addEventListener("load", function () {
        const form = document.querySelector("form");
        const tipoPedido = document.querySelector("#tipoPedidoSelect");
        const errorTipoPedido = document.querySelector("#errorTipoPedido");

        form.addEventListener("submit", function (e) {
            // Limpiar errores previos
            errorTipoPedido.textContent = "";

            if (!tipoPedido.value) {
                errorTipoPedido.textContent = "Por favor, selecciona un tipo de pedido.";
                e.preventDefault(); // Detener envío
            }
        });
    });
</script>
