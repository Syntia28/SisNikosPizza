@using SisNikosPizza.Utilidades
@model IEnumerable<SisNikosPizza.Domain.Models.Pedido>

@{
    ViewData["Title"] = "Detalle del Pedido";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
<link href="./wwwroot/css/pedidos.detalles.css" rel="stylesheet">


@* <div class="container">
    <div class="card">
        <div class="card-header">
            <h1>Detalle del Pedido</h1>
            <p>Revisa los detalles de tu pedido con atención</p>
        </div>
        <div class="card-body">
            <div class="mb-4">
                <a asp-action="Index" asp-controller="Pedidos" class="btn-custom btn-back">
                    <i class="bi bi-arrow-left-circle"></i> Regresar
                </a>
            </div>

            <div class="section-title">Información General</div>
            <div class="info-grid">
                <div class="info-item">
                    <i class="bi bi-receipt"></i>
                    <p><strong>N° Pedido:</strong> @Model.PedidoId</p>
                </div>
                <div class="info-item">
                    <i class="bi bi-calendar-event"></i>
                    <p><strong>Fecha:</strong> @Model.FechaPedido.ToString("dd/MM/yyyy HH:mm")</p>
                </div>
                <div class="info-item">
                    <i class="bi bi-flag"></i>
                    <p><strong>Estado:</strong> @Model.EstadoPedido</p>
                </div>
                <div class="info-item">
                    <i class="bi bi-truck"></i>
                    <p><strong>Tipo de Pedido:</strong> @Model.TipoPedido</p>
                </div>
                @if (Model.TipoPedido == VCG.TipoPedido.Delivery)
                {
                    <div class="info-item">
                        <i class="bi bi-telephone"></i>
                        <p><strong>Teléfono:</strong> @Model.Telefono</p>
                    </div>
                    <div class="info-item">
                        <i class="bi bi-geo-alt"></i>
                        <p><strong>Dirección:</strong> @Model.Direccion</p>
                    </div>
                    <div class="info-item">
                        <i class="bi bi-info-circle"></i>
                        <p><strong>Referencia:</strong> @Model.Referencia</p>
                    </div>
                }
                else if (Model.TipoPedido == VCG.TipoPedido.Recoger)
                {
                    <div class="info-item">
                        <i class="bi bi-clock-history"></i>
                        <p><strong>Fecha de Recogo:</strong> @Model.FechaRecogo?.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                }
                else if (Model.TipoPedido == VCG.TipoPedido.Mesa)
                {
                    <div class="info-item">
                        <i class="bi bi-table"></i>
                        <p><strong>Mesa:</strong> @Model.Mesa</p>
                    </div>
                }
            </div>

            <div class="section-title">Productos del Pedido</div>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Descripción</th>
                            <th>Cantidad</th>
                            <th>Precio Unitario</th>
                            <th>Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var detalle in Model.DetallePedido)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@detalle.Producto.ImagenUrl" class="product-img" alt="@detalle.Producto.Nombre" />
                                        <span class="fw-semibold">@detalle.Producto.Nombre</span>
                                    </div>
                                </td>
                                <td>@detalle.Producto.Descripcion</td>
                                <td>@detalle.Cantidad</td>
                                <td>S/. @detalle.Producto.Precio</td>
                                <td>S/. @(detalle.Cantidad * detalle.Producto.Precio)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="totals">
                @{
                    var subtotal = Model.DetallePedido.Sum(dp => dp.Cantidad * dp.Producto.Precio) * 0.82;
                    var impuestos = Model.DetallePedido.Sum(dp => dp.Cantidad * dp.Producto.Precio) * 0.18;
                    var total = Model.DetallePedido.Sum(dp => dp.Cantidad * dp.Producto.Precio);
                }
                <p><strong>Subtotal:</strong> S/. @subtotal</p>
                <p><strong>IGV (18%):</strong> S/. @impuestos</p>
                <h4>Total: S/. @total</h4>
            </div>

            <div class="text-end mt-5">
                <a asp-action="Cobrar" asp-controller="Pedidos" asp-route-id="@Model.PedidoId" class="btn-custom btn-continue">
                    Continuar <i class="bi bi-arrow-right-circle"></i>
                </a>
            </div>
        </div>
    </div>
</div> *@