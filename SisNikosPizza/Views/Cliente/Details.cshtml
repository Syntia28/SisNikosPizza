@using Microsoft.AspNetCore.Identity
@model IdentityUser

@{
    ViewData["Title"] = "Detalles del Usuario";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700&display=swap" rel="stylesheet">

<style>
    body {
        font-family: 'Inter', sans-serif;
        background: linear-gradient(135deg, #fff3e0 0%, #ffe082 100%);
        color: #212121;
        margin: 0;
        padding: 0;
    }

    .details-card {
        animation: slideIn 0.7s ease-out;
    }

 

    .details-value {
        transition: background-color 0.3s ease;
    }

        .details-value:hover {
            background-color: #fef3c7;
        }

    .btn {
        transition: all 0.3s ease;
    }

        .btn:hover {
            transform: scale(1.05);
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
</style>

<div class="container mx-auto py-12 px-4 sm:px-6 lg:px-8" role="main">
    <div class="max-w-lg mx-auto bg-white shadow-2xl rounded-2xl overflow-hidden border-2 border-yellow-300 details-card" aria-labelledby="details-header">
        <div class="bg-gradient-to-r from-yellow-600 to-red-600 text-white px-6 py-4 text-center relative">
            <h3 class="text-2xl font-bold font-['Poppins']" id="details-header">Detalles del Usuario</h3>
            <div class="absolute inset-0 bg-radial-gradient from-white/20 to-transparent opacity-30"></div>
        </div>
        <div class="p-6 bg-yellow-50">
            <div class="space-y-4">
                <div class="details-item">
                    <span class="block text-gray-700 font-semibold mb-1">ID</span>
                    <div class="details-value bg-gray-100 text-gray-800 px-4 py-2 rounded-lg border border-gray-200 break-all">@Model.Id</div>
                </div>
                <div class="details-item">
                    <span class="block text-gray-700 font-semibold mb-1">Nombre de Usuario</span>
                    <div class="details-value bg-gray-100 text-gray-800 px-4 py-2 rounded-lg border border-gray-200">@Model.UserName</div>
                </div>
                <div class="details-item">
                    <span class="block text-gray-700 font-semibold mb-1">Email</span>
                    <div class="details-value bg-gray-100 text-gray-800 px-4 py-2 rounded-lg border border-gray-200">@Model.Email</div>
                </div>
                <div class="details-item">
                    <span class="block text-gray-700 font-semibold mb-1">Teléfono</span>
                    <div class="details-value bg-gray-100 text-gray-800 px-4 py-2 rounded-lg border border-gray-200">@(Model.PhoneNumber ?? "No disponible")</div>
                </div>
            </div>
            <div class="flex justify-end space-x-3 mt-6">
                <a asp-controller="Cliente" asp-action="Edit" asp-route-id="@Model.Id" class="btn inline-flex items-center px-4 py-2 bg-blue-600 text-white rounded-full hover:bg-blue-700 transition duration-300 shadow-md" aria-label="Editar usuario @Model.UserName">
                    <i class="bi bi-pencil-square mr-2"></i> Editar
                </a>
                <a asp-controller="Cliente" asp-action="Index" class="btn inline-flex items-center px-4 py-2 bg-gray-600 text-white rounded-full hover:bg-gray-700 transition duration-300 shadow-md" aria-label="Volver a la lista de usuarios">
                    <i class="bi bi-arrow-left mr-2"></i> Volver
                </a>
            </div>
        </div>
    </div>
</div>