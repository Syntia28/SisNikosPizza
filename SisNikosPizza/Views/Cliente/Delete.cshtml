@using Microsoft.AspNetCore.Identity
@model IdentityUser

@{
    ViewData["Title"] = "Eliminar Usuario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700&display=block"
    rel="stylesheet">

<style>
    body {
        font-family: 'Inter', sans-serif;
        background: linear-gradient(135deg, #fff3e0 0%, #ffe082 100%);
        color: #212121;
        margin: 0;
        padding: 0;
    }

    .delete-card {
        animation: slideIn 0.7s ease-out;
        border-left: 6px solid #dc2626;
    }



    .warning-message {
        animation: pulse 2s infinite;
    }




    .btn {
        transition: all 0.3s ease;
    }

    .btn:hover {
        transform: scale(1.05);
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
</style>

<div class="container mx-auto py-12 px-4 sm:px-6 lg:px-8" role="main">
    <div class="max-w-lg mx-auto bg-white shadow-2xl rounded-2xl overflow-hidden border-2 border-yellow-300 delete-card"
        aria-labelledby="delete-header">
        <div class="bg-gradient-to-r from-red-600 to-red-800 text-white px-6 py-4 text-center relative">
            <h3 class="text-2xl font-bold font-['Poppins']" id="delete-header">Confirmar Eliminación</h3>
            <div class="absolute inset-0 bg-radial-gradient from-white/20 to-transparent opacity-30"></div>
        </div>
        <div class="p-6 bg-yellow-50">
            <div
                class="warning-message flex items-center bg-red-100 text-red-800 p-4 rounded-lg mb-6 border border-red-300">
                <i class="bi bi-exclamation-triangle-fill text-2xl mr-3"></i>
                <div>
                    <strong>¡Atención!</strong> ¿Estás seguro de que deseas eliminar este usuario? Esta acción no se
                    puede deshacer.
                </div>
            </div>

            <h4 class="text-lg font-semibold text-gray-700 mb-3">Detalles del Usuario a Eliminar:</h4>
            <dl class="space-y-3">
                <div class="flex flex-col">
                    <dt class="text-gray-700 font-semibold">ID Usuario:</dt>
                    <dd class="text-gray-600 bg-gray-100 px-4 py-2 rounded-lg border border-gray-200 break-all">
                        @Model.Id</dd>
                </div>
                <div class="flex flex-col">
                    <dt class="text-gray-700 font-semibold">Nombre de Usuario:</dt>
                    <dd class="text-gray-600 bg-gray-100 px-4 py-2 rounded-lg border border-gray-200">
                        @Html.DisplayFor(model => model.UserName)</dd>
                </div>
                <div class="flex flex-col">
                    <dt class="text-gray-700 font-semibold">Email:</dt>
                    <dd class="text-gray-600 bg-gray-100 px-4 py-2 rounded-lg border border-gray-200">
                        @Html.DisplayFor(model => model.Email)</dd>
                </div>
                <div class="flex flex-col">
                    <dt class="text-gray-700 font-semibold">Teléfono:</dt>
                    <dd class="text-gray-600 bg-gray-100 px-4 py-2 rounded-lg border border-gray-200">
                        @(Model.PhoneNumber ?? "No disponible")</dd>
                </div>
            </dl>

            <form method="post" asp-action="Delete" asp-controller="Cliente" id="delete-form" class="mt-6">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div class="flex justify-end space-x-3">
                    <button type="submit"
                        class="btn inline-flex items-center px-4 py-2 bg-red-600 text-white rounded-full hover:bg-red-700 transition duration-300 shadow-md"
                        aria-label="Confirmar eliminación del usuario @Model.UserName">
                        <i class="bi bi-trash-fill mr-2"></i> Eliminar Permanentemente
                    </button>
                    <a asp-action="Index" asp-controller="Cliente"
                        class="btn inline-flex items-center px-4 py-2 bg-gray-600 text-white rounded-full hover:bg-gray-700 transition duration-300 shadow-md"
                        aria-label="Cancelar y volver a la lista de usuarios">
                        <i class="bi bi-x-circle-fill mr-2"></i> Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>