@model SisNikosPizza.Domain.Models.ApplicationUser

@{
    ViewData["Title"] = "Editar Usuario";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
  
<style>
    
    body {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        font-family: 'Inter', sans-serif;
        color: #2d2d2d;
        margin: 0;
        padding: 0;
    }

    .container {
        padding: 60px 20px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .form-card {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        max-width: 600px;
        margin: 0 auto;
    }

        .form-card:hover {
            transform: translateY(-5px);
        }

    .form-header {
        background: linear-gradient(45deg, #f1c40f, #f39c12);
        padding: 20px;
        text-align: center;
        color: #fff;
        border-radius: 20px 20px 0 0;
    }

        .form-header h3 {
            font-size: 2rem;
            font-weight: 700;
            margin: 0;
            text-transform: uppercase;
        }

    .form-body {
        padding: 30px;
    }

    .form-label {
        font-size: 1.1rem;
        font-weight: 600;
        color: #333;
        margin-bottom: 8px;
        display: block;
    }

    .form-control {
        border: 2px solid #e0e0e0;
        border-radius: 10px;
        padding: 12px;
        font-size: 1rem;
        background: #f9f9f9;
        width: 100%;
    }

        .form-control:focus {
            border-color: #f1c40f;
            box-shadow: 0 0 8px rgba(241, 196, 15, 0.3);
            outline: none;
            background: #fff;
        }

        .form-control::placeholder {
            color: #aaa;
            font-style: italic;
        }

    .text-danger {
        font-size: 0.9rem;
        color: #e63946;
        margin-top: 5px;
        display: block;
    }

    .btn {
        padding: 12px 24px;
        border-radius: 50px;
        font-weight: 600;
        font-size: 1rem;
    }

    .btn-success {
        background: linear-gradient(45deg, #2ecc71, #27ae60);
        border: none;
        color: #fff;
    }

        .btn-success:hover {
            background: linear-gradient(45deg, #27ae60, #2ecc71);
            transform: scale(1.05);
        }

    .btn-secondary {
        background: linear-gradient(45deg, #6c757d, #5a6268);
        border: none;
        color: #fff;
    }

        .btn-secondary:hover {
            background: linear-gradient(45deg, #5a6268, #6c757d);
            transform: scale(1.05);
        }

    .toast {
        position: fixed;
        bottom: 20px;
        right: 20px;
        background: #2ecc71;
        color: #fff;
        padding: 15px 20px;
        border-radius: 10px;
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.3s ease, transform 0.3s ease;
        z-index: 1000;
    }

        .toast.show {
            opacity: 1;
            transform: translateY(0);
        }
</style>

<div class="container" role="main">
    <div class="form-card" aria-labelledby="form-header">
        <div class="form-header">
            <h3 id="form-header">Editar Usuario</h3>
        </div>
        <div class="form-body">
            <form method="post" asp-controller="User" asp-action="Edit" id="edit-form">
                

                <div class="mb-3">
                    <label for="UserName" class="form-label">Nombre de Usuario <span class="text-danger">*</span></label>
                    <input type="text" asp-for="Nombre" class="form-control" id="UserName" placeholder="Ej. usuario123" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label for="Email" class="form-label">Email <span class="text-danger">*</span></label>
                    <input type="email" asp-for="Email" class="form-control" id="Email" placeholder="Ej. usuario@ejemplo.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label for="PhoneNumber" class="form-label">Teléfono</label>
                    <input type="text" asp-for="PhoneNumber" class="form-control" id="PhoneNumber"
                        placeholder="Ej. 999 999 999" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label for="Direccion" class="form-label">Dirección</label>
                    <input type="text" asp-for="Direccion" class="form-control" id="Direccion" placeholder="Ej. Av. Principal 123, Ciudad" />
                    <span asp-validation-for="Direccion" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-end gap-3 mt-4">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-save"></i> Guardar
                    </button>
                    <a asp-controller="User" asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="toast" id="success-toast" role="alert" aria-live="polite">
    ¡Usuario actualizado exitosamente!
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('edit-form');
            const toast = document.getElementById('success-toast');

            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const formData = new FormData(form);

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: formData
                    });

                    if (response.ok) {
                        toast.classList.add('show');
                        setTimeout(() => {
                            toast.classList.remove('show');
                            window.location.href = '@Url.Action("Index", "User")';
                        }, 2000);
                    } else {
                        const errors = await response.json();
                        console.error('Validation errors:', errors);
                    }
                } catch (error) {
                    console.error('Error:', error);
                }
            });
        });
        </script>
}

