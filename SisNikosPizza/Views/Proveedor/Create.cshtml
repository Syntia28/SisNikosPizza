@model SisNikosPizza.Domain.Models.Proveedor

@{
    ViewData["Title"] = "Crear Proveedor";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<div class="container py-12">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card p-8 animate__animated animate__fadeInUp">
                <div class="text-center mb-6">
                    <h3 class="text-3xl font-bold text-gray-800">Nuevo Proveedor</h3>
                    <p class="text-gray-600 text-sm">Registra o busca proveedores para SisNikosPizza</p>
                </div>

                <form method="post" asp-controller="Proveedor" asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group">
                        <input type="text" asp-for="Nombre" class="form-control" placeholder=" " />
                        <label asp-for="Nombre" class="form-label">Nombre <span class="text-red-500">*</span></label>
                        <i class="bi bi-person-fill input-icon"></i>
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <input type="text" asp-for="Empresa" class="form-control" placeholder=" " />
                        <label asp-for="Empresa" class="form-label">Empresa <span class="text-red-500">*</span></label>
                        <i class="bi bi-building-fill input-icon"></i>
                        <span asp-validation-for="Empresa" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <input type="text" asp-for="ProveedorInsumo" class="form-control" placeholder=" " />
                        <label asp-for="ProveedorInsumo" class="form-label">Insumo <span class="text-red-500">*</span></label>
                        <i class="bi bi-box-seam input-icon"></i>
                        <span asp-validation-for="ProveedorInsumo" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <input type="number" asp-for="Ccantidad" class="form-control" placeholder=" " />
                        <label asp-for="Ccantidad" class="form-label">Cantidad <span class="text-red-500">*</span></label>
                        <i class="bi bi-hash input-icon"></i>
                        <span asp-validation-for="Ccantidad" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <input type="date" asp-for="FechaRegistro" class="form-control" placeholder=" " />
                        <label asp-for="FechaRegistro" class="form-label">Fecha de Registro <span class="text-red-500">*</span></label>
                        <i class="bi bi-calendar-fill input-icon"></i>
                        <span asp-validation-for="FechaRegistro" class="text-danger"></span>
                    </div>

                    <div class="flex justify-end gap-4 mt-8">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save mr-2"></i> Guardar
                        </button>
                        <a asp-controller="Proveedor" asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-x-circle mr-2"></i> Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
