@model SisNikosPizza.Domain.Models.Proveedor

@{
    ViewData["Title"] = "Crear Proveedor";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card border border-secondary">
                <div class="card-header bg-primary text-white text-center">
                    <h3 class="mb-0">Nuevo Proveedor</h3>
                </div>
                <div class="mb-6">
                    <a href="javascript:history.back()" class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-yellow-500 to-yellow-600 text-white rounded-full hover:bg-gradient-to-r hover:from-yellow-600 hover:to-yellow-700 transition duration-300 ease-in-out transform hover:scale-105 shadow-md">
                        <i class="bi bi-arrow-left-circle mr-2"></i> Regresar
                    </a>
                </div>

                <div class="card-body">
                    <form method="post" asp-controller="Proveedor" asp-action="Create">
                        <!-- Campo Nombre -->
                        <div class="mb-3">
                            <label for="Nombre" class="form-label">Nombre <span class="text-danger">*</span></label>
                            <input type="text" asp-for="Nombre" class="form-control" placeholder="Nombre del proveedor" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <!-- Campo Empresa -->
                        <div class="mb-3">
                            <label for="Empresa" class="form-label">Empresa <span class="text-danger">*</span></label>
                            <input type="text" asp-for="Empresa" class="form-control" placeholder="Empresa del proveedor" />
                            <span asp-validation-for="Empresa" class="text-danger"></span>
                        </div>

                        <!-- Campo Producto -->
                        <div class="mb-3">
                            <label for="Producto" class="form-label">Producto <span class="text-danger">*</span></label>
                            <input type="text" asp-for="Producto" class="form-control" placeholder="Producto proporcionado" />
                            <span asp-validation-for="Producto" class="text-danger"></span>
                        </div>

                        <!-- Campo Cantidad -->
                        <div class="mb-3">
                            <label for="Ccantidad" class="form-label">Cantidad <span class="text-danger">*</span></label>
                            <input type="number" asp-for="Ccantidad" class="form-control" placeholder="Cantidad de productos" />
                            <span asp-validation-for="Ccantidad" class="text-danger"></span>
                        </div>

                        <!-- Campo Fecha de Registro -->
                        <div class="mb-3">
                            <label for="FechaRegistro" class="form-label">Fecha de Registro <span class="text-danger">*</span></label>
                            <input type="date" asp-for="FechaRegistro" class="form-control" />
                            <span asp-validation-for="FechaRegistro" class="text-danger"></span>
                        </div>

                        <!-- Botones Guardar y Cancelar -->
                        <div class="d-flex justify-content-end gap-3">
                            <button type="submit" class="btn btn-success px-4">
                                Guardar
                            </button>
                            <a asp-controller="Proveedor" asp-action="Index" class="btn btn-secondary px-4">
                                Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
