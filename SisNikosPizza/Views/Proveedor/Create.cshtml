@model SisNikosPizza.Domain.Models.Proveedor
@{
    ViewData["Title"] = "Crear Proveedor";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<style>
    body {
        background: linear-gradient(135deg, #facc15, #eab308);
        font-family: 'Poppins', sans-serif;
        overflow-x: hidden;
    }

    .card {
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.2));
        backdrop-filter: blur(12px);
        border-radius: 1.5rem;
        border: 1px solid rgba(255, 255, 255, 0.3);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.25);
        transition: transform 0.4s ease, box-shadow 0.4s ease;
    }

    .card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
    }

    .form-group {
        position: relative;
        margin-bottom: 2rem;
    }

    .form-control {
        background: rgba(255, 255, 255, 0.95);
        border: none;
        border-radius: 0.75rem;
        padding: 1rem 1rem 1rem 3.5rem;
        height: 70px;
        min-width: 100%;
        transition: all 0.3s ease;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
        font-size: 1rem;
    }

    .form-control:focus {
        background: #fff;
        box-shadow: 0 0 0 4px rgba(249, 115, 22, 0.3);
        outline: none;
    }

    .form-label {
        position: absolute;
        top: 1rem;
        left: 3.5rem;
        color: #6b7280;
        transition: all 0.3s ease;
        pointer-events: none;
        font-size: 0.9rem;
    }

    .form-control:focus+.form-label,
    .form-control:not(:placeholder-shown)+.form-label {
        top: -0.75rem;
        left: 1.25rem;
        font-size: 0.75rem;
        color: #f97316;
        background: #fff;
        padding: 0 0.25rem;
    }

    .input-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: #f97316;
        font-size: 1.5rem;
    }

    .toggle-switch {
        position: relative;
        display: inline-block;
        width: 60px;
        height: 34px;
    }

    .toggle-switch input {
        opacity: 0;
        width: 0;
        height: 0;
    }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        transition: 0.4s;
        border-radius: 34px;
    }

    .slider:before {
        position: absolute;
        content: "";
        height: 26px;
        width: 26px;
        left: 4px;
        bottom: 4px;
        background-color: white;
        transition: 0.4s;
        border-radius: 50%;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
    }

    input:checked+.slider {
        background-color: #10b981;
    }

    input:checked+.slider:before {
        transform: translateX(26px);
    }

    .btn-primary {
        position: relative;
        overflow: hidden;
        background: linear-gradient(90deg, #f97316, #ef4444);
        border: none;
        border-radius: 0.75rem;
        padding: 0.875rem 2rem;
        color: white;
        font-weight: 600;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        font-size: 1.1rem;
    }

    .btn-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 5px 20px rgba(249, 115, 22, 0.6);
    }

    .btn-primary::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        width: 0;
        height: 0;
        background: rgba(255, 255, 255, 0.4);
        border-radius: 50%;
        transform: translate(-50%, -50%);
        transition: width 0.4s ease, height 0.4s ease;
    }

    .btn-primary:hover::after {
        width: 250px;
        height: 250px;
    }

    .btn-secondary {
        background: #4b5563;
        border: none;
        border-radius: 0.75rem;
        padding: 0.875rem 2rem;
        color: white;
        font-weight: 600;
        transition: transform 0.3s ease, background 0.3s ease;
        font-size: 1.1rem;
    }

    .btn-secondary:hover {
        background: #374151;
        transform: translateY(-3px);
    }

    .error-text {
        color: #dc2626;
        font-size: 0.75rem;
        margin-top: 0.25rem;
    }

    #success-toast {
        animation: slideInRight 0.5s ease forwards;
    }

    |
</style>

<div class="container mx-auto py-8 px-4 sm:px-6 lg:px-8">
    <div class="mb-6">
        <h1
            class="text-3xl sm:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-yellow-500 to-yellow-700 animate-pulse">
            Crear Nuevo Proveedor
        </h1>
    </div>

    <div class="mb-6">
        <a href="@Url.Action("Index", "Proveedor")"
            class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-yellow-500 to-yellow-600 text-white rounded-full hover:bg-gradient-to-r hover:from-yellow-600 hover:to-yellow-700 transition duration-300 ease-in-out transform hover:scale-105 shadow-md">
            <i class="bi bi-arrow-left-circle mr-2"></i> Regresar a la Lista
        </a>
    </div>

    @if (TempData["Satisfactorio"] != null)
    {
        <div class="mb-6 p-4 bg-green-100 border-l-4 border-green-500 text-green-700 rounded-lg">
            <p>@TempData["Satisfactorio"]</p>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mb-6 p-4 bg-red-100 border-l-4 border-red-500 text-red-700 rounded-lg">
            <p>@TempData["Error"]</p>
        </div>
    }

    <div class="card animate__animated animate__fadeInUp">
        <div class="bg-gradient-to-r from-yellow-500 to-yellow-700 text-white px-6 py-4">
            <h2 class="text-2xl font-semibold"><i class="bi bi-person-fill mr-2"></i> Formulario de Proveedor</h2>
        </div>
        <div class="p-6 bg-yellow-50">
            <form asp-action="Create" method="post" id="create-proveedor-form">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="form-group">
                        <input type="text" asp-for="Nombre" class="form-control" placeholder=" " />
                        <label for="Nombre" class="form-label">Nombre <span class="text-red-500">*</span></label>
                        <i class="bi bi-person-fill input-icon"></i>
                        <span asp-validation-for="Nombre" class="error-text"></span>
                    </div>

                    <div class="form-group">
                        <input type="text" asp-for="Empresa" class="form-control" placeholder=" " />
                        <label for="Empresa" class="form-label">Empresa <span class="text-red-500">*</span></label>
                        <i class="bi bi-building-fill input-icon"></i>
                        <span asp-validation-for="Empresa" class="error-text"></span>
                    </div>

                    <div class="form-group">
                        <input type="number" step="0.01" asp-for="Cantidad" class="form-control" placeholder=" " />
                        <label for="Cantidad" class="form-label">Cantidad de Insumos <span
                                class="text-red-500">*</span></label>
                        <i class="bi bi-box-fill input-icon"></i>
                        <span asp-validation-for="Cantidad" class="error-text"></span>
                    </div>

                    <div class="form-group">
                        <label for="Estado" class="block text-sm font-medium text-gray-700 mb-2">Estado <span
                                class="text-red-500">*</span></label>
                        <div class="flex items-center">
                            <span class="mr-3 text-gray-600 font-medium">Estado:</span>
                            <label class="toggle-switch">
                                <input asp-for="Estado" type="checkbox" id="Estado" checked />
                                <span class="slider"></span>
                            </label>
                            <span class="ml-3">
                                <span id="estado-label"
                                    class="inline-block px-3 py-1 bg-green-500 text-white text-sm font-medium rounded-full">Activo</span>
                            </span>
                        </div>
                        <span asp-validation-for="Estado" class="error-text"></span>
                    </div>
                </div>

                <div class="mt-6 flex justify-end space-x-4">
                    <button type="submit" class="btn-primary">
                        <i class="bi bi-save mr-2"></i> Guardar Proveedor
                    </button>
                    <a asp-action="Index" class="btn-secondary">
                        <i class="bi bi-x-circle mr-2"></i> Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="fixed bottom-4 right-4 hidden bg-green-500 text-white px-6 py-3 rounded-lg shadow-lg transition-opacity duration-300"
    id="success-toast">
    <i class="bi bi-check-circle mr-2"></i> ¡Proveedor creado exitosamente!
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('create-proveedor-form');
            const toast = document.getElementById('success-toast');
            const estadoCheckbox = document.getElementById('Estado');
            const estadoLabel = document.getElementById('estado-label');

            function updateEstadoLabel() {
                if (estadoCheckbox.checked) {
                    estadoLabel.classList.remove('bg-red-500');
                    estadoLabel.classList.add('bg-green-500');
                    estadoLabel.textContent = 'Activo';
                } else {
                    estadoLabel.classList.remove('bg-green-500');
                    estadoLabel.classList.add('bg-red-500');
                    estadoLabel.textContent = 'Inactivo';
                }
            }

            estadoCheckbox.addEventListener('change', updateEstadoLabel);
            updateEstadoLabel();

            form.addEventListener('submit', async (e) => {
                if (form.reportValidity()) {
                    if (e.submitter && e.submitter.getAttribute('type') === 'submit') {
                        return;
                    }

                    e.preventDefault();
                    const formData = new FormData(form);

                    try {
                        const response = await fetch(form.action, {
                            method: 'POST',
                            body: formData
                        });

                        if (response.ok) {
                            toast.classList.remove('hidden');
                            setTimeout(() => {
                                toast.classList.add('hidden');
                                window.location.href = '@Url.Action("Index", "Proveedor")';
                            }, 2000);
                        } else {
                            const errors = await response.json();
                            console.error('Validation errors:', errors);
                        }
                    } catch (error) {
                        console.error('Error:', error);
                    }
                }
            });
        });
    </script>
}