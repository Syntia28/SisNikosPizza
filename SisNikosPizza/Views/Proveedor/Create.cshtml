@model SisNikosPizza.Domain.Models.Proveedor
@{
    ViewData["Title"] = "Crear Proveedor";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<style>
    body {
        background: linear-gradient(135deg, #ff6b6b, #ffa500);
        font-family: 'Poppins', sans-serif;
        overflow-x: hidden;
    }

    .card {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border-radius: 1.5rem;
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
        transition: transform 0.4s ease, box-shadow 0.4s ease;
    }

        .card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
        }

    .form-group {
        position: relative;
        margin-bottom: 1.5rem;
    }

    .form-control {
        background: rgba(255, 255, 255, 0.9);
        border: none;
        border-radius: 0.75rem;
        padding: 0.75rem 1rem 0.75rem 2.5rem;
        transition: all 0.3s ease;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }

        .form-control:focus {
            background: #fff;
            box-shadow: 0 0 0 4px rgba(255, 107, 107, 0.3);
            outline: none;
        }

    .form-label {
        position: absolute;
        top: 0.75rem;
        left: 2.5rem;
        color: #6b7280;
        transition: all 0.3s ease;
        pointer-events: none;
        font-size: 0.9rem;
    }

    .form-control:focus + .form-label,
    .form-control:not(:placeholder-shown) + .form-label {
        top: -0.75rem;
        left: 1rem;
        font-size: 0.75rem;
        color: #ff6b6b;
        background: #fff;
        padding: 0 0.25rem;
    }

    .input-icon {
        position: absolute;
        left: 0.75rem;
        top: 50%;
        transform: translateY(-50%);
        color: #ff6b6b;
        font-size: 1.1rem;
    }

    .btn-primary {
        position: relative;
        overflow: hidden;
        background: linear-gradient(90deg, #ff6b6b, #ffa500);
        border: none;
        border-radius: 0.75rem;
        padding: 0.75rem 1.5rem;
        color: white;
        font-weight: 600;
        transition: transform 0.3s ease;
    }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(255, 107, 107, 0.5);
        }

        .btn-primary::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            background: rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            transform: translate(-50%, -50%);
            transition: width 0.4s ease, height 0.4s ease;
        }

        .btn-primary:hover::after {
            width: 200px;
            height: 200px;
        }

    .btn-secondary {
        background: #4b5563;
        border: none;
        border-radius: 0.75rem;
        padding: 0.75rem 1.5rem;
        color: white;
        font-weight: 600;
        transition: transform 0.3s ease, background 0.3s ease;
    }

        .btn-secondary:hover {
            background: #374151;
            transform: translateY(-3px);
        }

    .back-btn {
        background: linear-gradient(90deg, #facc15, #eab308);
        color: #1f2937;
        border-radius: 9999px;
        padding: 0.5rem 1.5rem;
        font-weight: 500;
        transition: transform 0.3s ease, background 0.3s ease;
    }

        .back-btn:hover {
            background: linear-gradient(90deg, #eab308, #ca8a04);
            transform: scale(1.1);
        }

    .error-text {
        color: #dc2626;
        font-size: 0.75rem;
        margin-top: 0.25rem;
    }
</style>

<div class="container py-10">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card p-8 animate__animated animate__fadeInUp">
                <div class="text-center mb-6">
                    <h3 class="text-3xl font-bold text-gray-800">Nuevo Proveedor</h3>
                    <p class="text-gray-600 text-sm">Añade un proveedor para SisNikosPizza con estilo</p>
                </div>

                <div class="mb-6">
                    <a href="javascript:history.back()" class="inline-flex items-center back-btn animate__animated animate__pulse animate__infinite">
                        <i class="bi bi-arrow-left-circle mr-2"></i> Regresar
                    </a>
                </div>

                <form method="post" asp-controller="Proveedor" asp-action="Create">
                    <!-- Campo Nombre -->
                    <div class="form-group">
                        <input type="text" asp-for="Nombre" class="form-control" placeholder=" " />
                        <label for="Nombre" class="form-label">Nombre <span class="text-red-500">*</span></label>
                        <i class="bi bi-person-fill input-icon"></i>
                        <span asp-validation-for="Nombre" class="error-text"></span>
                    </div>

                    <!-- Campo Empresa -->
                    <div class="form-group">
                        <input type="text" asp-for="Empresa" class="form-control" placeholder=" " />
                        <label for="Empresa" class="form-label">Empresa <span class="text-red-500">*</span></label>
                        <i class="bi bi-building-fill input-icon"></i>
                        <span asp-validation-for="Empresa" class="error-text"></span>
                    </div>

                    <!-- Campo Producto -->
                    <div class="form-group">
                        <input type="text" asp-for="Producto" class="form-control" placeholder=" " />
                        <label for="Producto" class="form-label">Producto <span class="text-red-500">*</span></label>
                        <i class="bi bi-box-fill input-icon"></i>
                        <span asp-validation-for="Producto" class="error-text"></span>
                    </div>

                    <!-- Campo Cantidad -->
                    <div class="form-group">
                        <input type="number" asp-for="Ccantidad" class="form-control" placeholder=" " />
                        <label for="Ccantidad" class="form-label">Cantidad <span class="text-red-500">*</span></label>
                        <i class="bi bi-hash input-icon"></i>
                        <span asp-validation-for="Ccantidad" class="error-text"></span>
                    </div>

                    <!-- Campo Fecha de Registro -->
                    <div class="form-group">
                        <input type="date" asp-for="FechaRegistro" class="form-control" placeholder=" " />
                        <label for="FechaRegistro" class="form-label">Fecha de Registro <span class="text-red-500">*</span></label>
                        <i class="bi bi-calendar-fill input-icon"></i>
                        <span asp-validation-for="FechaRegistro" class="error-text"></span>
                    </div>

                    <!-- Botones Guardar y Cancelar -->
                    <div class="flex justify-end gap-4 mt-8">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save mr-2"></i> Guardar
                        </button>
                        <a asp-controller="Proveedor" asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-x-circle mr-2"></i> Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}