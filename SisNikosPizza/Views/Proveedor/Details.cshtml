@model SisNikosPizza.Domain.Models.Proveedor

@{
    ViewData["Title"] = "Detalle del Proveedor";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<div class="container mx-auto py-8 px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-6">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-yellow-500 to-yellow-700 animate-pulse">
            Detalle del Proveedor
        </h1>
    </div>

    <!-- Card -->
    <div class="bg-white shadow-2xl rounded-2xl overflow-hidden max-w-4xl mx-auto">
        <!-- Card Header -->
        <div class="bg-gradient-to-r from-yellow-500 to-yellow-700 text-white px-6 py-4 flex justify-between items-center">
            <h2 class="text-2xl font-semibold"><i class="bi bi-person-lines-fill mr-2"></i> Información del Proveedor</h2>
            <a href="javascript:history.back()" class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-yellow-600 to-yellow-800 text-white rounded-full hover:bg-gradient-to-r hover:from-yellow-700 hover:to-yellow-900 transition duration-300 ease-in-out transform hover:scale-105">
                <i class="bi bi-arrow-left-circle mr-2"></i> Regresar
            </a>
        </div>
        <!-- Card Body -->
        <div class="p-6 bg-yellow-100">
            <dl class="space-y-4">
                <div class="flex flex-col sm:flex-row sm:items-center bg-white rounded-lg shadow-md p-4 border border-gray-200">
                    <dt class="w-full sm:w-1/4 text-gray-600 font-medium">Proveedor ID</dt>
                    <dd class="w-full sm:w-3/4 text-gray-800">@Model.ProveedorId</dd>
                </div>
                <div class="flex flex-col sm:flex-row sm:items-center bg-white rounded-lg shadow-md p-4 border border-gray-200">
                    <dt class="w-full sm:w-1/4 text-gray-600 font-medium">Nombre</dt>
                    <dd class="w-full sm:w-3/4 text-gray-800">@Model.Nombre</dd>
                </div>
                <div class="flex flex-col sm:flex-row sm:items-center bg-white rounded-lg shadow-md p-4 border border-gray-200">
                    <dt class="w-full sm:w-1/4 text-gray-600 font-medium">Producto</dt>
                    <dd class="w-full sm:w-3/4 text-gray-800">@Model.Producto</dd>
                </div>
                <div class="flex flex-col sm:flex-row sm:items-center bg-white rounded-lg shadow-md p-4 border border-gray-200">
                    <dt class="w-full sm:w-1/4 text-gray-600 font-medium">Empresa</dt>
                    <dd class="w-full sm:w-3/4 text-gray-800">@Model.Empresa</dd>
                </div>
                <div class="flex flex-col sm:flex-row sm:items-center bg-white rounded-lg shadow-md p-4 border border-gray-200">
                    <dt class="w-full sm:w-1/4 text-gray-600 font-medium">Cantidad</dt>
                    <dd class="w-full sm:w-3/4 text-gray-800">@Model.Ccantidad</dd>
                </div>
                <div class="flex flex-col sm:flex-row sm:items-center bg-white rounded-lg shadow-md p-4 border border-gray-200">
                    <dt class="w-full sm:w-1/4 text-gray-600 font-medium">Fecha de Registro</dt>
                    <dd class="w-full sm:w-3/4 text-gray-800">@Model.FechaRegistro</dd>
                </div>
                <div class="flex flex-col sm:flex-row sm:items-center bg-white rounded-lg shadow-md p-4 border border-gray-200">
                    <dt class="w-full sm:w-1/4 text-gray-600 font-medium">Creado el</dt>
                    <dd class="w-full sm:w-3/4 text-gray-800">@Model.CreatedAt</dd>
                </div>
                <div class="flex flex-col sm:flex-row sm:items-center bg-white rounded-lg shadow-md p-4 border border-gray-200">
                    <dt class="w-full sm:w-1/4 text-gray-600 font-medium">Actualizado el</dt>
                    <dd class="w-full sm:w-3/4 text-gray-800">@Model.UpdatedAt</dd>
                </div>
            </dl>

            <!-- Action Buttons -->
            <div class="flex justify-end space-x-4 mt-6">
                <a asp-action="Edit" asp-route-id="@Model.ProveedorId" class="inline-flex items-center px-6 py-2 bg-gradient-to-r from-yellow-600 to-yellow-800 text-white rounded-full hover:bg-gradient-to-r hover:from-yellow-700 hover:to-yellow-900 transition duration-300 ease-in-out transform hover:scale-105 shadow-lg">
                    <i class="bi bi-pencil-fill mr-2"></i> Editar
                </a>
                <a asp-action="Index" class="inline-flex items-center px-6 py-2 bg-gray-700 text-white rounded-full hover:bg-gray-800 transition duration-300 ease-in-out transform hover:scale-110 shadow-lg">
                    <i class="bi bi-arrow-left-circle mr-2"></i> Regresar
                </a>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>