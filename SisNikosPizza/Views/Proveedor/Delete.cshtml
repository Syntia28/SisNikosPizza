@model SisNikosPizza.Domain.Models.Proveedor
@{
    ViewData["Title"] = "Eliminar Proveedor";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<section class="content container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <form method="post" asp-controller="Proveedor" asp-action="Delete">
                <div class="card card-default">
                    <div class="card-header">
                        <span class="card-title"><h2>Eliminar Proveedor</h2></span>
                    </div>
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input asp-for="ProveedorId" hidden />
                        <div class="form-group row mb-2">
                            <div class="col-12 col-md-2 col-form-label text-md-end">
                                <label>Nombre</label>
                            </div>
                            <div class="col-12 col-md-9">
                                <input type="text" asp-for="Nombre" class="form-control" placeholder="Nombre de la Categoría" disabled />
                                <span asp-validation-for="Nombre" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="form-group row mb-2">
                            <div class="col-12 col-md-2 col-form-label text-md-end">
                                <label>Producto</label>
                            </div>
                            <div class="col-12 col-md-9">
                                <input type="text" asp-for="Producto" class="form-control" placeholder="Nombre del producto" disabled />
                                <span asp-validation-for="Producto" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="form-group row mb-2">
                            <div class="col-12 col-md-2 col-form-label text-md-end">
                                <label>Cantidad</label>
                            </div>
                            <div class="col-12 col-md-9">
                                <input type="text" asp-for="Ccantidad" class="form-control" placeholder="Colocar la cantidad" disabled />
                                <span asp-validation-for="Ccantidad" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="form-group row mb-2">
                            <div class="col-12 col-md-2 col-form-label text-md-end">
                                <label>Empresa</label>
                            </div>
                            <div class="col-12 col-md-9">
                                <input type="text" asp-for="Empresa" class="form-control" placeholder="Nombre de la Empresa proveedora" disabled />
                                <span asp-validation-for="Empresa" class="text-danger"></span>
                            </div>
                        </div>
                        <div>
                            <button type="submit" class="btn btn-danger">Eliminar</button>
                            <a asp-controller="Proveedor" asp-action="Index" class="btn btn-primary">Cancelar</a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>