@model SisNikosPizza.Domain.Models.Proveedor

@{
    ViewData["Title"] = "Eliminar Proveedor";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<div class="container mx-auto py-8 px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-6">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-yellow-500 to-yellow-700 animate-pulse">
            Eliminar Proveedor
        </h1>
    </div>

    <!-- Card -->
    <div class="bg-white shadow-2xl rounded-2xl overflow-hidden max-w-4xl mx-auto">
        <form method="post" asp-controller="Proveedor" asp-action="Delete">
            <input asp-for="ProveedorId" hidden />
            <!-- Card Header -->
            <div class="bg-gradient-to-r from-yellow-500 to-yellow-700 text-white px-6 py-4 flex justify-between items-center">
                <h2 class="text-2xl font-semibold"><i class="bi bi-person-x-fill mr-2"></i> Confirmar Eliminación</h2>
                <a href="javascript:history.back()" class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-yellow-600 to-yellow-800 text-white rounded-full hover:bg-gradient-to-r hover:from-yellow-700 hover:to-yellow-900 transition duration-300 ease-in-out transform hover:scale-105">
                    <i class="bi bi-arrow-left-circle mr-2"></i> Regresar
                </a>
            </div>
            <!-- Card Body -->
            <div class="p-6 bg-yellow-100">
                <div asp-validation-summary="ModelOnly" class="text-red-600 mb-4"></div>

                <!-- Nombre -->
                <div class="mb-6 flex items-center">
                    <label class="w-1/4 text-gray-600 font-medium">Nombre</label>
                    <div class="w-3/4">
                        <input type="text" asp-for="Nombre" class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-100" placeholder="Nombre del proveedor" disabled />
                        <span asp-validation-for="Nombre" class="text-red-600 text-sm"></span>
                    </div>
                </div>

                <!-- Producto -->
                <div class="mb-6 flex items-center">
                    <label class="w-1/4 text-gray-600 font-medium">Producto</label>
                    
                </div>

                <!-- Cantidad -->
                <div class="mb-6 flex items-center">
                    <label class="w-1/4 text-gray-600 font-medium">Cantidad</label>
                    <div class="w-3/4">
                        <input type="text" asp-for="Ccantidad" class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-100" placeholder="Cantidad" disabled />
                        <span asp-validation-for="Ccantidad" class="text-red-600 text-sm"></span>
                    </div>
                </div>

                <!-- Empresa -->
                <div class="mb-6 flex items-center">
                    <label class="w-1/4 text-gray-600 font-medium">Empresa</label>
                    <div class="w-3/4">
                        <input type="text" asp-for="Empresa" class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-100" placeholder="Nombre de la empresa proveedora" disabled />
                        <span asp-validation-for="Empresa" class="text-red-600 text-sm"></span>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="flex justify-end space-x-4 mt-6">
                    <button type="submit" class="inline-flex items-center px-10 py-4 bg-gradient-to-r from-red-600 to-yellow-500 text-white rounded-full hover:bg-gradient-to-r hover:from-red-700 hover:to-yellow-600 transition duration-300 ease-in-out transform hover:scale-115 animate-pulse shadow-xl text-xl font-bold">
                        <i class="bi bi-trash-fill mr-2"></i> Eliminar
                    </button>
                    <a asp-controller="Proveedor" asp-action="Index" class="inline-flex items-center px-6 py-2 bg-gray-700 text-white rounded-full hover:bg-gray-800 transition duration-300 ease-in-out transform hover:scale-105">
                        <i class="bi bi-x-circle mr-2"></i> Cancelar
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>