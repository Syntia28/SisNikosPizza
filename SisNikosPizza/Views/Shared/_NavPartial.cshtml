@using Microsoft.AspNetCore.Identity
@using SisNikosPizza.Utilidades

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item sb-sidenav-menu-heading" role="presentation">Core</li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Carta" asp-action="Index">
                <i class="fas fa-pizza-slice sb-nav-link-icon"></i>
                Pizzas
            </a>
        </li>
        @if (User.IsInRole(VCG.Role_Admin) || User.IsInRole(VCG.Role_Delivery))
        {
            <li class="nav-item">
                <a class="nav-link" asp-controller="Pedidos" asp-action="Delivery">
                    <i class="fas fa-motorcycle sb-nav-link-icon"></i>
                    Delivery
                </a>
            </li>
        }
        @if (User.IsInRole(VCG.Role_Admin))
        {
            <li class="nav-item">
                <a class="nav-link" asp-controller="Pedidos" asp-action="Index">
                    <i class="fas fa-tachometer-alt sb-nav-link-icon"></i>
                    Pedidos
                </a>
            </li>
            <li class="nav-item sb-sidenav-menu-heading" role="presentation">Gestión</li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Cliente" asp-action="Index">
                    <i class="fas fa-user sb-nav-link-icon"></i>
                    Clientes
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Proveedor" asp-action="Index">
                    <i class="fas fa-truck sb-nav-link-icon"></i>
                    Proveedores
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Producto" asp-action="Index">
                    <i class="fas fa-box sb-nav-link-icon"></i>
                    Productos
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Insumo" asp-action="Index">
                    <i class="fas fa-box sb-nav-link-icon"></i>
                    Insumos
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Categoria" asp-action="Index">
                    <i class="fas fa-tags sb-nav-link-icon"></i>
                    Categorías
                </a>
            </li>
            <li class="nav-item sb-sidenav-menu-heading" role="presentation">Addons</li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Ventas" asp-action="Index">
                    <i class="fas fa-shopping-cart sb-nav-link-icon"></i>
                    Ventas
                </a>
            </li>
        }
    }
    else
    {
        <li class="nav-item sb-sidenav-menu-heading" role="presentation">Core</li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Carta" asp-action="Index">
                <i class="fas fa-pizza-slice sb-nav-link-icon"></i>
                Pizzas
            </a>
        </li>
    }
</ul>