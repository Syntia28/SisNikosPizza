@using Microsoft.AspNetCore.Identity
@using SisNikosPizza.Utilidades

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <div class="nav">
            <div class="sb-sidenav-menu-heading">Core</div>
            <a class="nav-link" asp-controller="Carta" asp-action="Index">
                <div class="sb-nav-link-icon">
                    <i class="fas fa-pizza-slice"></i>
                </div>
                Pizzas
            </a>

            @if (User.IsInRole(VCG.Role_Admin) || User.IsInRole(VCG.Role_Delivery)){
                <a class="nav-link" asp-controller="Pedidos" asp-action="Delivery">
                    <div class="sb-nav-link-icon">
                        <i class="fas fa-motorcycle"></i>
                    </div>
                    Delivery
                </a>
            }

            @if (User.IsInRole(VCG.Role_Admin)) 
            {

                <a class="nav-link" asp-controller="Pedidos" asp-action="Index">
                    <div class="sb-nav-link-icon">
                        <i class="fas fa-tachometer-alt"></i>
                    </div>
                    Pedidos
                </a>

                <div class="sb-sidenav-menu-heading">Gestión</div>
                <a class="nav-link" asp-controller="Cliente" asp-action="Index">
                    <div class="sb-nav-link-icon"><i class="fas fa-user"></i></div>
                    Clientes
                </a>
                <a class="nav-link" asp-controller="Proveedor" asp-action="Index">
                    <div class="sb-nav-link-icon"><i class="fas fa-truck"></i></div>
                    Proveedores
                </a>
                <a class="nav-link" asp-controller="Producto" asp-action="Index">
                    <div class="sb-nav-link-icon"><i class="fas fa-box"></i></div>
                    Productos
                </a>
                <a class="nav-link" asp-controller="Insumo" asp-action="Index">
                    <div class="sb-nav-link-icon"><i class="fas fa-box"></i></div>
                    Insumos
                </a>
                <a class="nav-link" asp-controller="Categoria" asp-action="Index">
                    <div class="sb-nav-link-icon"><i class="fas fa-tags"></i></div>
                    Categorías
                </a>

                <div class="sb-sidenav-menu-heading">Addons</div>
                <a class="nav-link" asp-controller="Ventas" asp-action="Index">
                    <div class="sb-nav-link-icon"><i class="fas fa-shopping-cart"></i></div>
                    Ventas
                    </a>
              
            }
        </div>
    }
    else
    {
        <div class="nav">
            <div class="sb-sidenav-menu-heading">Core</div>
            <a class="nav-link" asp-controller="Carta" asp-action="Index">
                <div class="sb-nav-link-icon"><i class="fas fa-tachometer-alt"></i></div>
                Pizzas
            </a>
        </div>
    }
</ul>
