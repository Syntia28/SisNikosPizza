@using Microsoft.AspNetCore.Identity
@using SisNikosPizza.Utilidades

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<nav class="relative h-full w-[300px] overflow-y-auto overflow-x-hidden">
    @if (SignInManager.IsSignedIn(User))
    {
        <div class="py-4 pl-4">
            <div class="mb-6">
                <h3 class="text-amber-800 text-xs font-bold uppercase tracking-wider mb-3 pl-2">Core</h3>
                
                <a asp-controller="Carta" asp-action="Index" 
                   class="flex items-center px-2 py-2 text-gray-700 rounded-lg hover:bg-amber-200 hover:text-amber-900 transition-all duration-200 group mb-2">
                    <div class="flex items-center justify-center w-8 h-8 mr-3">
                        <i class="fas fa-pizza-slice text-amber-600 group-hover:text-amber-800"></i>
                    </div>
                    <span class="font-medium">Pizzas</span>
                </a>

                @if (User.IsInRole(VCG.Role_Admin) || User.IsInRole(VCG.Role_Delivery))
                {
                    <a asp-controller="Pedidos" asp-action="Delivery" 
                       class="flex items-center px-2 py-2 text-gray-700 rounded-lg hover:bg-amber-200 hover:text-amber-900 transition-all duration-200 group mb-2">
                        <div class="flex items-center justify-center w-8 h-8 mr-3">
                            <i class="fas fa-motorcycle text-amber-600 group-hover:text-amber-800"></i>
                        </div>
                        <span class="font-medium">Delivery</span>
                    </a>
                }

                @if (User.IsInRole(VCG.Role_Admin))
                {
                    <a asp-controller="Pedidos" asp-action="Index" 
                       class="flex items-center px-2 py-2 text-gray-700 rounded-lg hover:bg-amber-200 hover:text-amber-900 transition-all duration-200 group mb-2">
                        <div class="flex items-center justify-center w-8 h-8 mr-3">
                            <i class="fas fa-tachometer-alt text-amber-600 group-hover:text-amber-800"></i>
                        </div>
                        <span class="font-medium">Pedidos</span>
                    </a>
                }
            </div>

            @if (User.IsInRole(VCG.Role_Admin))
            {
                <div class="mb-6">
                    <h3 class="text-amber-800 text-xs font-bold uppercase tracking-wider mb-3 pl-2">Gestión</h3>
                    
                    <a asp-controller="Cliente" asp-action="Index" 
                       class="flex items-center px-2 py-2 text-gray-700 rounded-lg hover:bg-amber-200 hover:text-amber-900 transition-all duration-200 group mb-2">
                        <div class="flex items-center justify-center w-8 h-8 mr-3">
                            <i class="fas fa-user text-amber-600 group-hover:text-amber-800"></i>
                        </div>
                        <span class="font-medium">Clientes</span>
                    </a>

                    <a asp-controller="Proveedor" asp-action="Index" 
                       class="flex items-center px-2 py-2 text-gray-700 rounded-lg hover:bg-amber-200 hover:text-amber-900 transition-all duration-200 group mb-2">
                        <div class="flex items-center justify-center w-8 h-8 mr-3">
                            <i class="fas fa-truck text-amber-600 group-hover:text-amber-800"></i>
                        </div>
                        <span class="font-medium">Proveedores</span>
                    </a>

                    <a asp-controller="Producto" asp-action="Index" 
                       class="flex items-center px-2 py-2 text-gray-700 rounded-lg hover:bg-amber-200 hover:text-amber-900 transition-all duration-200 group mb-2">
                        <div class="flex items-center justify-center w-8 h-8 mr-3">
                            <i class="fas fa-box text-amber-600 group-hover:text-amber-800"></i>
                        </div>
                        <span class="font-medium">Productos</span>
                    </a>

                    <a asp-controller="Insumo" asp-action="Index" 
                       class="flex items-center px-2 py-2 text-gray-700 rounded-lg hover:bg-amber-200 hover:text-amber-900 transition-all duration-200 group mb-2">
                        <div class="flex items-center justify-center w-8 h-8 mr-3">
                            <i class="fas fa-box text-amber-600 group-hover:text-amber-800"></i>
                        </div>
                        <span class="font-medium">Insumos</span>
                    </a>

                    <a asp-controller="Categoria" asp-action="Index" 
                       class="flex items-center px-2 py-2 text-gray-700 rounded-lg hover:bg-amber-200 hover:text-amber-900 transition-all duration-200 group mb-2">
                        <div class="flex items-center justify-center w-8 h-8 mr-3">
                            <i class="fas fa-tags text-amber-600 group-hover:text-amber-800"></i>
                        </div>
                        <span class="font-medium">Categorías</span>
                    </a>
                </div>

                <div class="mb-6">
                    <h3 class="text-amber-800 text-xs font-bold uppercase tracking-wider mb-3 pl-2">Addons</h3>
                    
                    <a asp-controller="Ventas" asp-action="Index" 
                       class="flex items-center px-2 py-2 text-gray-700 rounded-lg hover:bg-amber-200 hover:text-amber-900 transition-all duration-200 group mb-2">
                        <div class="flex items-center justify-center w-8 h-8 mr-3">
                            <i class="fas fa-shopping-cart text-amber-600 group-hover:text-amber-800"></i>
                        </div>
                        <span class="font-medium">Ventas</span>
                    </a>
                </div>
            }
        </div>
    }
    else
    {
        <div class="py-4 pl-4">
            <div class="mb-6">
                <h3 class="text-amber-800 text-xs font-bold uppercase tracking-wider mb-3 pl-2">Core</h3>
                
                <a asp-controller="Carta" asp-action="Index" 
                   class="flex items-center px-2 py-2 text-gray-700 rounded-lg hover:bg-amber-200 hover:text-amber-900 transition-all duration-200 group mb-2">
                    <div class="flex items-center justify-center w-8 h-8 mr-3">
                        <i class="fas fa-pizza-slice text-amber-600 group-hover:text-amber-800"></i>
                    </div>
                    <span class="font-medium">Pizzas</span>
                </a>
            </div>
        </div>
    }
</nav>
