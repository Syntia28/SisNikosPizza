@using Microsoft.AspNetCore.Identity
@using SisNikosPizza.Utilidades

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <div class="nav">
            <div class="sb-sidenav-menu-heading">Core</div>
            <a class="nav-link" asp-controller="Home" asp-action="Index">
                <div class="sb-nav-link-icon"><i class="fas fa-tachometer-alt"></i></div>
                Pizzas
            </a>

            <a class="nav-link" asp-controller="Home" asp-action="Index">
                <div class="sb-nav-link-icon"><i class="fas fa-tachometer-alt"></i></div>
                Pedidos
            </a>

            @if (User.IsInRole(VCG.Role_Admin)) // Corrección: cierre de paréntesis agregado aquí
            {
                <div class="sb-sidenav-menu-heading">Gestión</div>
                <a class="nav-link" asp-controller="Cliente" asp-action="Index">
                    <div class="sb-nav-link-icon"><i class="fas fa-user"></i></div>
                    Clientes
                </a>
                <a class="nav-link" asp-controller="Proveedor" asp-action="Index">
                    <div class="sb-nav-link-icon"><i class="fas fa-truck"></i></div>
                    Proveedores
                </a>
                <a class="nav-link" asp-controller="Producto" asp-action="Index">
                    <div class="sb-nav-link-icon"><i class="fas fa-box"></i></div>
                    Productos
                </a>
                <a class="nav-link" asp-controller="Categoria" asp-action="Index">
                    <div class="sb-nav-link-icon"><i class="fas fa-tags"></i></div>
                    Categorías
                </a>

                <div class="sb-sidenav-menu-heading">Addons</div>
                <a class="nav-link" asp-controller="Charts" asp-action="Index">
                    <div class="sb-nav-link-icon"><i class="fas fa-chart-area"></i></div>
                    Gráficos
                </a>
                <a class="nav-link" asp-controller="Tables" asp-action="Index">
                    <div class="sb-nav-link-icon"><i class="fas fa-table"></i></div>
                    Tablas
                </a>
            }
        </div>
    }
    else
    {
        <div class="nav">
            <div class="sb-sidenav-menu-heading">Core</div>
            <a class="nav-link" asp-controller="Home" asp-action="Index">
                <div class="sb-nav-link-icon"><i class="fas fa-tachometer-alt"></i></div>
                Pizzas
            </a>
        </div>
    }
</ul>
