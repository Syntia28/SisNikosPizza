@model IEnumerable<SisNikosPizza.Domain.Models.Producto>

@{
    ViewData["Title"] = "Bienvenido - Nikos Pizza";
    ViewData["Description"] = "Descubre las mejores pizzas artesanales de Nikos Pizza. Ingredientes frescos y auténtico sabor italiano.";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdn.jsdelivr.net">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@700;800;900&family=Roboto:wght@400;500&display=swap" rel="stylesheet">

    <!-- Corregido: preload con @Url.Content -->
    <link rel="preload" as="image" href="@Url.Content("~/Imagenes/logo.webp")" type="image/webp">
    <!-- Este preload es opcional, solo si se usa como <img> -->
    <link rel="preload" as="image" href="@Url.Content("~/Imagenes/register.webp")" type="image/webp">

    <link rel="stylesheet" href="@Url.Content("~/css/home.css")" />
}

<!-- Hero Section -->
<section class="hero-nikos" aria-labelledby="hero-title">
    <div class="hero-bg" role="img" aria-label="Imagen de fondo con pizzas"></div>
    <div class="hero-glass">
        <img src="@Url.Content("~/Imagenes/logo.webp")"
             alt="Logo de Nikos Pizza"
             class="logo-hero-nikos"
             width="120"
             height="120"
             loading="eager">
        <h1 id="hero-title" class="hero-title-nikos">
            <span class="animated-gradient bienvenida-letras">¡Bienvenido a Nikos Pizza!</span>
        </h1>
        <p class="hero-subtitle-nikos">
            Donde cada mordida es una fiesta de sabor 🍕✨
            <span class="hero-frase">¡Déjate sorprender por la mejor pizza artesanal!</span>
        </p>
        <a href="#pizzas" class="btn btn--primary" aria-describedby="hero-cta-description">
            Ver nuestras pizzas
        </a>
        <div id="hero-cta-description" class="sr-only">
            Navegar a la sección de pizzas disponibles
        </div>
    </div>
</section>

<!-- Welcome Section -->
<section class="bienvenida-nikos" aria-labelledby="welcome-title">
    <h2 id="welcome-title" class="bienvenida-titulo">
        ¡La pizza más deliciosa de la ciudad te espera!
    </h2>
    <p>
        Descubre nuestras recetas artesanales, ingredientes frescos y el auténtico sabor italiano en cada porción.
        <span class="emoji" aria-label="pizza">🍕</span>
        <span class="emoji" aria-label="corazón">❤️</span>
        ¡Haz de tu día una fiesta con Nikos Pizza!
        <span class="emoji" aria-label="celebración">🎉</span>
    </p>
</section>

<!-- Pizzas Section -->
<section id="pizzas" class="pizzas-section-nikos" aria-labelledby="pizzas-title">
    <h2 id="pizzas-title" class="section-title-nikos">Nuestras Pizzas Estrella</h2>
    <div class="pizzas-grid-nikos">
        <article class="pizza-card-nikos" tabindex="0" role="button" aria-label="Pizza Niko's - La favorita de la casa" data-pizza="nikos">
            <div class="pizza-img-wrap">
                <img src="@Url.Content("~/Imagenes/nikos.webp")"
                     alt="Pizza Niko's con ingredientes especiales de la casa"
                     width="280" height="200" loading="lazy">
                <div class="pizza-badge" aria-label="Pizza destacada">⭐</div>
            </div>
            <div class="pizza-info-nikos">
                <h3>NIKO'S</h3>
                <p>La favorita de la casa, ¡pruébala!</p>
            </div>
        </article>

        <article class="pizza-card-nikos" tabindex="0" role="button" aria-label="Pizza Pepperoni - Clásica e irresistible" data-pizza="pepperoni">
            <div class="pizza-img-wrap">
                <img src="@Url.Content("~/Imagenes/pepenori.webp")"
                     alt="Pizza Pepperoni con deliciosas rodajas de pepperoni"
                     width="280" height="200" loading="lazy">
                <div class="pizza-badge" aria-label="Pizza picante">🔥</div>
            </div>
            <div class="pizza-info-nikos">
                <h3>PEPPERONI</h3>
                <p>Clásica, irresistible y siempre deliciosa.</p>
            </div>
        </article>

        <article class="pizza-card-nikos" tabindex="0" role="button" aria-label="Pizza Frutas - Explosión de sabores tropicales" data-pizza="frutas">
            <div class="pizza-img-wrap">
                <img src="@Url.Content("~/Imagenes/frutas.webp")"
                     alt="Pizza con frutas tropicales frescas"
                     width="280" height="200" loading="lazy">
                <div class="pizza-badge" aria-label="Pizza tropical">🍍</div>
            </div>
            <div class="pizza-info-nikos">
                <h3>FRUTAS</h3>
                <p>Una explosión de sabores tropicales.</p>
            </div>
        </article>

        <article class="pizza-card-nikos" tabindex="0" role="button" aria-label="Pizza Española - Sabores auténticos" data-pizza="espanola">
            <div class="pizza-img-wrap">
                <img src="@Url.Content("~/Imagenes/espanola.webp")"
                     alt="Pizza Española con ingredientes tradicionales"
                     width="280" height="200" loading="lazy">
                <div class="pizza-badge" aria-label="Pizza española">🇪🇸</div>
            </div>
            <div class="pizza-info-nikos">
                <h3>ESPAÑOLA</h3>
                <p>Sabores intensos y auténticos.</p>
            </div>
        </article>

        <article class="pizza-card-nikos" tabindex="0" role="button" aria-label="Pizza Hawaiana - Perfecta combinación dulce y salado" data-pizza="hawaiana">
            <div class="pizza-img-wrap">
                <img src="@Url.Content("~/Imagenes/hawaina.webp")"
                     alt="Pizza Hawaiana con piña y jamón"
                     width="280" height="200" loading="lazy">
                <div class="pizza-badge" aria-label="Pizza hawaiana">🌺</div>
            </div>
            <div class="pizza-info-nikos">
                <h3>HAWAIANA</h3>
                <p>La combinación perfecta de dulce y salado.</p>
            </div>
        </article>
    </div>
</section>

<!-- CTA Flotante -->
<a href="@Url.Action("Index", "Carta")"
   class="cta-float-nikos"
   aria-label="Ir a la carta para realizar pedido">
    <span>¡Haz tu pedido ahora!</span>
</a>

@section Scripts {
    <script src="@Url.Content("~/js/home.js")" asp-append-version="true"></script>
}
