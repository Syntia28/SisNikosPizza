@model IEnumerable<SisNikosPizza.Domain.Models.Producto>
@using Microsoft.AspNetCore.Identity

@inject SignInManager<IdentityUser> SignInManager

@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<div class="text-center" style="background-color: #fff2cc; padding: 20px;">
    <h1 class="display-4" style="color: #c75c25; font-weight: bold; text-shadow: 2px 2px 5px rgba(0,0,0,0.2);">
        ¡Bienvenido a Nikos Pizza!
    </h1>
    <p style="font-size: 1.2rem; color: #555;">Descubre nuestras deliciosas pizzas hechas con amor</p>
    <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 20px; margin-top: 20px;">
        @foreach (var pizza in Model)
        {
            <div class="card shadow-sm" style="width: 18rem; border: none; border-radius: 10px; overflow: hidden;">
                <img src="@pizza.ImagenUrl" class="card-img-top" alt="@pizza.Nombre" style="height: 180px; object-fit: cover;">
                <div class="card-body" style="background-color: #ffffff;">
                    <h5 class="card-title" style="font-size: 1.5rem; color: #c75c25; font-weight: bold;">@pizza.Nombre</h5>
                    <p class="card-text" style="color: #6c757d;">@pizza.Descripcion</p>
                    <p class="card-text fw-bold" style="font-size: 1.2rem; color: #000;">
                        Precio: S/. @pizza.Precio
                    </p>
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <form action="/Carrito/Create" method="post">
                            <input type="hidden" name="ProductoId" value="@pizza.ProductoId" />
                            <input type="hidden" name="UsuarioId" value="@ViewBag.UsuarioId" />
                            <input type="hidden" name="Cantidad" value="1" />
                            <input type="hidden" name="PrecioUnitario" value="@pizza.Precio" />

                             <button type="submit" class="btn btn-primary w-100" style="background-color: #b2611a; border: none; font-size: 1rem; padding: 10px;">
                                Agregar al carrito
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-primary w-100" href="/Identity/Account/Login" style="background-color: #b2611a; border: none; font-size: 1rem; padding: 10px;">
                            Agregar al carrito
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const forms = document.querySelectorAll('form[action="/Carrito/Create"]');

            forms.forEach(form => {
                form.addEventListener("submit", async (e) => {
                    e.preventDefault(); // 🚫 evita redirección

                    const formData = new FormData(form);

                    const response = await fetch(form.action, {
                        method: "POST",
                        body: formData
                    });

                    const result = await response.text();

                    if (result === "ok") {
                        alert("Producto agregado al carrito correctamente ✅");
                        // Opcional: actualizar contador o icono del carrito
                    } else {
                        alert("❌ Error al agregar al carrito");
                    }
                });
            });
        });
    </script>
}