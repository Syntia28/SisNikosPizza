@model IEnumerable<SisNikosPizza.Domain.Models.Producto>
@using Microsoft.AspNetCore.Identity

@inject SignInManager<IdentityUser> SignInManager

@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<style>
    body {
        font-family: 'Poppins', sans-serif;
        background: linear-gradient(180deg, #fef6e4 0%, #ffe5b4 100%);
        margin: 0;
        padding: 0;
        overflow-x: hidden;
    }

    .text-center {
        background: linear-gradient(135deg, #fde29f 0%, #ffb74d 100%);
        padding: 60px 20px;
        color: #000;
        border-radius: 0 0 30px 30px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
        text-align: center;
        position: relative;
        overflow: hidden;
    }

        .text-center::before {
            content: '🍕';
            font-size: 100px;
            opacity: 0.1;
            position: absolute;
            top: -20px;
            left: 20px;
            transform: rotate(-20deg);
        }

        .text-center::after {
            content: '🍕';
            font-size: 100px;
            opacity: 0.1;
            position: absolute;
            bottom: -20px;
            right: 20px;
            transform: rotate(20deg);
        }

    h1.display-4 {
        font-family: 'Pacifico', cursive;
        font-size: 3.5rem;
        font-weight: 400;
        color: #fff;
        text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.3);
        animation: slideInDown 1s ease-in-out;
        margin-bottom: 10px;
    }

    .text-center p {
        font-size: 1.3rem;
        font-weight: 300;
        color: #000;
        text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.2);
        animation: fadeIn 1.5s ease-in-out;
    }

    .card-container {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 25px;
        margin: 40px 20px;
        max-width: 1400px;
        margin-left: auto;
        margin-right: auto;
    }

    .card {
        width: 100%;
        max-width: 320px;
        border-radius: 20px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        position: relative;
    }

        .card:hover {
            transform: translateY(-10px);
            box-shadow: 0 12px 25px rgba(0, 0, 0, 0.2);
        }

    .card-img-top {
        height: 220px;
        object-fit: cover;
        border-bottom: 4px solid #fad087;
        transition: transform 0.3s ease;
    }

    .card:hover .card-img-top {
        transform: scale(1.05);
    }

    .card-body {
        padding: 20px;
        text-align: center;
    }

    .card-title {
        font-family: 'Poppins', sans-serif;
        font-size: 1.8rem;
        font-weight: 600;
        color: #fad087;
        margin-bottom: 10px;
    }

    .card-text {
        font-size: 1rem;
        color: #555;
        margin-bottom: 15px;
        line-height: 1.5;
    }

        .card-text.fw-bold {
            font-size: 1.5rem;
            color: #d69e12;
            margin-bottom: 20px;
        }

    .stock-info {
        font-size: 0.9rem;
        color: #757575;
        background: #0000;
        padding: 5px 10px;
        border-radius: 10px;
        display: inline-block;
        margin-bottom: 15px;
    }

    .btn-primary {
        background: linear-gradient(135deg, #fad087, #FFC300);
        border: none;
        font-size: 1.1rem;
        font-weight: 500;
        padding: 12px 20px;
        border-radius: 25px;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: #000;
        width: 100%;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

        .btn-primary:hover {
            background: linear-gradient(135deg, #fad087, #FFC300);
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
        }

        .btn-primary:disabled {
            background: #ccc;
            cursor: not-allowed;
            opacity: 0.6;
        }

    .quantity-input {
        width: 80px;
        padding: 8px;
        border: 1px solid #ddd;
        border-radius: 10px;
        text-align: center;
        font-size: 1rem;
        margin-bottom: 15px;
        background: #f9f9f9;
        color: #333;
    }

        .quantity-input:focus {
            outline: none;
            border-color: #fee7b0;
            box-shadow: 0 0 5px rgba(255, 111, 97, 0.5);
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @@keyframes slideInDown {
        from {
            transform: translateY(-50px);
            opacity: 0;
        }

        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    @@media (max-width: 768px) {
        h1.display-4 {
            font-size: 2.5rem;
        }

        .text-center p {
            font-size: 1.1rem;
        }

        .card {
            max-width: 280px;
        }
    }

    @@media (max-width: 576px) {
        .text-center {
            padding: 40px 15px;
        }

        .card-container {
            margin: 20px 10px;
            gap: 15px;
        }

        .card {
            max-width: 100%;
        }
    }
</style>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" integrity="sha512-z3gLpd7yknf1YoNbCzqRKc4qyor8gaKU1qmn+CShxbuBusANI9QpRohGBreCFkKxLhei6S9CQXFEbbKuqLg0DA==" crossorigin="anonymous" referrerpolicy="no-referrer" />

<div class="text-center">
    <h1 class="display-4">¡Bienvenido a Nikos Pizza!</h1>
    <p>🍕 Descubre nuestras deliciosas pizzas hechas con amor 🍕</p>

    <div class="card-container">
        @foreach (var pizza in Model)
        {
            <div class="card">
                <img src="@pizza.ImagenUrl" class="card-img-top" alt="@pizza.Nombre">
                <div class="card-body">
                    <h5 class="card-title">@pizza.Nombre</h5>
                    <p class="card-text">@pizza.Descripcion</p>
                    <p class="stock-info"><i class="fas fa-box-open"></i> Stock: <span class="stock-value" data-product-id="@pizza.ProductoId">@pizza.Stock</span></p>
                    <p class="card-text fw-bold">
                        Precio: S/. @pizza.Precio
                    </p>

                    @if (SignInManager.IsSignedIn(User))
                    {
                        <form action="/Carrito/Create" method="post" class="cart-form">
                            <input type="hidden" name="carritoItems.ProductoId" value="@pizza.ProductoId" />
                            <input type="hidden" name="carritoItems.UsuarioId" value="@ViewBag.UsuarioId" />
                            <input type="hidden" name="carritoItems.PrecioUnitario" value="@pizza.Precio" />
                            <input type="number" name="carritoItems.Cantidad" class="quantity-input" min="1" max="@pizza.Stock" value="1" required @(pizza.Stock == 0 ? "disabled" : "") />
                            <button type="submit" class="btn btn-primary" @(pizza.Stock == 0 ? "disabled" : "")>
                                <i class="fas fa-cart-plus"></i> Agregar al carrito
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-primary" href="/Identity/Account/Login">
                            <i class="fas fa-cart-plus"></i> Agregar al carrito
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const forms = document.querySelectorAll('form.cart-form');

            forms.forEach(form => {
                form.addEventListener("submit", async (e) => {
                    e.preventDefault();

                    const formData = new FormData(form);
                    const productId = formData.get("carritoItems.ProductoId");
                    const quantity = parseInt(formData.get("carritoItems.Cantidad"));
                    const stockElement = document.querySelector(`.stock-value[data-product-id="${productId}"]`);
                    const currentStock = parseInt(stockElement.textContent);

                    if (quantity > currentStock) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: '❌ La cantidad solicitada excede el stock disponible.',
                            confirmButtonColor: '#d32f2f',
                            background: '#fff',
                            customClass: {
                                popup: 'animated shake'
                            }
                        });
                        return;
                    }

                    try {
                        const response = await fetch(form.action, {
                            method: "POST",
                            body: formData
                        });

                        const result = await response.text();
                        console.log('Server response:', result); // Debug log

                        if (result.startsWith("ok")) {
                            const newStock = currentStock - quantity;
                            stockElement.textContent = newStock;
                            form.querySelector('.quantity-input').setAttribute('max', newStock);

                            if (newStock === 0) {
                                form.querySelector('.quantity-input').disabled = true;
                                form.querySelector('.btn-primary').disabled = true;
                            }

                            Swal.fire({
                                icon: 'success',
                                title: '¡Producto agregado!',
                                text: '✅ Tu pizza fue agregada al carrito correctamente.',
                                confirmButtonColor: '#ff6f61',
                                background: '#fff',
                                customClass: {
                                    popup: 'animated bounceIn'
                                }
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: result.split(':')[1] || '❌ Hubo un problema al agregar tu pizza.',
                                confirmButtonColor: '#d32f2f',
                                background: '#fff',
                                customClass: {
                                    popup: 'animated shake'
                                }
                            });
                        }
                    } catch (error) {
                        console.error('Fetch error:', error); // Debug log
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: '❌ Error de conexión con el servidor.',
                            confirmButtonColor: '#d32f2f',
                            background: '#fff',
                            customClass: {
                                popup: 'animated shake'
                            }
                        });
                    }
                });
            });
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
}