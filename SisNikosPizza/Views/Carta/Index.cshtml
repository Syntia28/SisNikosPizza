@model IEnumerable<SisNikosPizza.Domain.Models.Producto>
@using Microsoft.AspNetCore.Identity

@inject SignInManager<IdentityUser> SignInManager

@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<style>
    /* Estilos generales */
    body {
        font-family: 'Poppins', sans-serif;
        background-color: #ffe5b4;
        margin: 0;
        padding: 0;
    }

    .text-center {
        background: linear-gradient(135deg, #ffcc80, #ff8a65);
        padding: 40px;
        color: #000000;
        border-radius: 10px;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);
    }

    h1.display-4 {
        font-size: 3rem;
        font-weight: bold;
        text-shadow: 3px 3px 7px rgba(0, 0, 0, 0.3);
        animation: fadeIn 1s ease-in-out;
    }

    .card {
        width: 18rem;
        border-radius: 15px;
        overflow: hidden;
        transition: transform 0.3s, box-shadow 0.3s;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);
        background: #fff;
    }

        .card:hover {
            transform: scale(1.05);
            box-shadow: 0px 8px 15px rgba(0, 0, 0, 0.3);
        }

    .card-title {
        font-size: 1.7rem;
        color: #e67e22;
        font-weight: bold;
    }

    .btn-primary {
        background: linear-gradient(135deg, #e67e22, #d35400);
        border: none;
        font-size: 1.2rem;
        padding: 12px;
        border-radius: 10px;
        transition: 0.3s ease-in-out;
    }

        .btn-primary:hover {
            background: #c0392b;
            transform: scale(1.07);
        }
</style>

<div class="text-center">
    <h1 class="display-4">¡Bienvenido a Nikos Pizza!</h1>
    <p style="font-size: 1.5rem;">🍕 Descubre nuestras deliciosas pizzas hechas con amor 🍕</p>

    <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 20px; margin-top: 30px;">
        @foreach (var pizza in Model)
        {
            <div class="card">
                <img src="@pizza.ImagenUrl" class="card-img-top" alt="@pizza.Nombre" style="height: 200px; object-fit: cover;">
                <div class="card-body">
                    <h5 class="card-title">@pizza.Nombre</h5>
                    <p class="card-text">@pizza.Descripcion</p>
                    <p class="card-text fw-bold" style="font-size: 1.4rem;">
                        Precio: S/. @pizza.Precio
                    </p>

                    @if (SignInManager.IsSignedIn(User))
                    {
                        <form action="/Carrito/Create" method="post">
                            <input type="hidden" name="ProductoId" value="@pizza.ProductoId" />
                            <input type="hidden" name="UsuarioId" value="@ViewBag.UsuarioId" />
                            <input type="hidden" name="Cantidad" value="1" />
                            <input type="hidden" name="PrecioUnitario" value="@pizza.Precio" />

                            <button type="submit" class="btn btn-primary w-100">
                                Agregar al carrito 🛒
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-primary w-100" href="/Identity/Account/Login">
                            Agregar al carrito 🛒
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const forms = document.querySelectorAll('form[action="/Carrito/Create"]');

            forms.forEach(form => {
                form.addEventListener("submit", async (e) => {
                    e.preventDefault(); // 🚫 Evita la redirección automática

                    const formData = new FormData(form);

                    const response = await fetch(form.action, {
                        method: "POST",
                        body: formData
                    });

                    const result = await response.text();

                    if (result === "ok") {
                        Swal.fire({
                            icon: 'success',
                            title: '¡Producto agregado!',
                            text: '✅ Tu pizza fue agregada al carrito correctamente.',
                            confirmButtonColor: '#e67e22'
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: '❌ Hubo un problema al agregar tu pizza.',
                            confirmButtonColor: '#c0392b'
                        });
                    }
                });
            });
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script> <!-- Librería para mejorar alertas -->
}