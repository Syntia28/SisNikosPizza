@model IEnumerable<SisNikosPizza.Domain.Models.Producto>
@using Microsoft.AspNetCore.Identity

@inject SignInManager<IdentityUser> SignInManager

@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<!-- Estilos principales -->


<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
<link rel="stylesheet" href="~/css/card.css" asp-append-version="true" />

<main role="main" aria-labelledby="bienvenida-title">
    <div class="text-center">
        <h1 id="bienvenida-title" class="display-4">¡Bienvenido a Nikos Pizza!</h1>
        <p>🍕 Descubre nuestras deliciosas pizzas hechas con amor 🍕</p>
    </div>

    <section aria-labelledby="pizzas-title">
        <h2 id="pizzas-title" class="visually-hidden">Listado de pizzas disponibles</h2>
        <div class="card-container">
            @foreach (var pizza in Model)
            {
                <div class="card" aria-label="Producto: @pizza.Nombre">
                    <img src="@pizza.ImagenUrl" class="card-img-top" alt="Imagen de la pizza @pizza.Nombre" />
                    <div class="card-body">
                        <h2 class="card-title">@pizza.Nombre</h2>
                        <p class="card-text">@pizza.Descripcion</p>
                        <p class="stock-info" aria-label="Stock disponible de @pizza.Nombre">
                            <i class="fas fa-box-open"></i> Stock:
                            <span class="stock-value" data-product-id="@pizza.ProductoId">@pizza.Stock</span>
                        </p>
                        <p class="card-text fw-bold">Precio: S/. @pizza.Precio</p>

                        @if (SignInManager.IsSignedIn(User))
                        {
                            <form action="/Carrito/Create" method="post" class="cart-form" aria-label="Formulario para agregar @pizza.Nombre al carrito">
                                <input type="hidden" name="carritoItems.ProductoId" value="@pizza.ProductoId" />
                                <input type="hidden" name="carritoItems.UsuarioId" value="@ViewBag.UsuarioId" />
                                <input type="hidden" name="carritoItems.PrecioUnitario" value="@pizza.Precio" />

                                <label for="cantidad-@pizza.ProductoId" class="visually-hidden">Cantidad</label>
                                <input id="cantidad-@pizza.ProductoId"
                                       type="number"
                                       name="carritoItems.Cantidad"
                                       class="quantity-input"
                                       min="1"
                                       max="@pizza.Stock"
                                       value="1"
                                       required
                                       aria-label="Cantidad a agregar"
                                       @(pizza.Stock == 0 ? "disabled" : "") />

                                <button type="submit"
                                        class="btn btn-primary"
                                        aria-label="Agregar @pizza.Nombre al carrito"
                                        @(pizza.Stock == 0 ? "disabled" : "")>
                                    <i class="fas fa-cart-plus"></i> Agregar al carrito
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-primary" href="/Identity/Account/Login" aria-label="Iniciar sesión para agregar @pizza.Nombre al carrito">
                                <i class="fas fa-cart-plus"></i> Agregar al carrito
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </section>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const forms = document.querySelectorAll('form.cart-form');

            forms.forEach(form => {
                form.addEventListener("submit", async (e) => {
                    e.preventDefault();

                    const formData = new FormData(form);
                    const productId = formData.get("carritoItems.ProductoId");
                    const quantity = parseInt(formData.get("carritoItems.Cantidad"));
                    const stockElement = document.querySelector(`.stock-value[data-product-id="${productId}"]`);
                    const currentStock = parseInt(stockElement.textContent);

                    if (quantity > currentStock) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'La cantidad solicitada excede el stock disponible.',
                            confirmButtonColor: '#d32f2f',
                            background: '#fff'
                        });
                        return;
                    }

                    try {
                        const response = await fetch(form.action, {
                            method: "POST",
                            body: formData
                        });

                        const result = await response.text();

                        if (result.startsWith("ok")) {
                            const newStock = currentStock - quantity;
                            stockElement.textContent = newStock;
                            form.querySelector('.quantity-input').setAttribute('max', newStock);

                            if (newStock === 0) {
                                form.querySelector('.quantity-input').disabled = true;
                                form.querySelector('.btn-primary').disabled = true;
                            }

                            Swal.fire({
                                icon: 'success',
                                title: '¡Producto agregado!',
                                text: 'Tu pizza fue agregada al carrito correctamente.',
                                confirmButtonColor: '#ff6f61',
                                background: '#fff'
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: result.split(':')[1] || 'Hubo un problema al agregar tu pizza.',
                                confirmButtonColor: '#d32f2f',
                                background: '#fff'
                            });
                        }
                    } catch (error) {
                        console.error('Fetch error:', error);
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Error de conexión con el servidor.',
                            confirmButtonColor: '#d32f2f',
                            background: '#fff'
                        });
                    }
                });
            });
        });
    </script>
}
