@model IEnumerable<SisNikosPizza.Domain.Models.Categoria>
@{
    ViewData["Title"] = "Lista de Categorías";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card">
                <div class="card-header">
                    <div class="d-flex justify-content-between">
                        <h2>Categorías</h2>
                        <div>
                            <a class="btn btn-success btn-sm mt-2" asp-controller="Categoria" asp-action="Index">
                                <i class="bi bi-file-earmark-plus"></i>&nbsp;Nueva Categoría
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-sm" id="table_categoria">
                            <thead class="thead">
                                <tr>
                                    <th class="text-center">Opciones</th>
                                    <th class="text-center">ID</th>
                                    <th>Nombre</th>
                                    <th class="text-center">Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

