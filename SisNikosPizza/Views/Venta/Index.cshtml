@model IEnumerable<SisNikosPizza.Domain.Models.Venta>

@{
    ViewData["Title"] = "Pedidos";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">

<style>
    body {
        font-family: 'Poppins', sans-serif;
        background-color: #f4f7fc;
    }

    .card {
        border-radius: 12px;
        box-shadow: 0 2px 15px rgba(0, 0, 0, 0.1);
        background-color: #ffffff;
    }

    .card-header {
        background-color: #5f6368;
        color: #fff;
        padding: 20px;
        border-top-left-radius: 12px;
        border-top-right-radius: 12px;
        font-size: 1.25rem;
        font-weight: 600;
    }

    .table th, .table td {
        text-align: center;
        padding: 12px;
        font-size: 1rem;
    }

    .table th {
        background-color: #f1f1f1;
        color: #333;
    }

    .table tbody tr:hover {
        background-color: #f8f9fa;
        cursor: pointer;
    }

    .form-select, .form-control {
        border-radius: 20px;
        height: 40px;
        padding-left: 10px;
    }

    .btn-info {
        background-color: #2a9d8f;
        border: none;
        color: #fff;
        border-radius: 20px;
        padding: 8px 16px;
        transition: all 0.3s ease;
    }

        .btn-info:hover {
            background-color: #1f7c6b;
        }

    .search-container input {
        border-radius: 30px;
        padding-left: 35px;
    }

    .search-container .bi-search {
        position: absolute;
        left: 10px;
        top: 8px;
        font-size: 1.2rem;
        color: #888;
    }

    .pagination .page-item a {
        background-color: #007bff;
        color: #fff;
        border-radius: 20px;
        padding: 8px 16px;
        margin: 0 5px;
    }

    .pagination .page-item.active a {
        background-color: #2a9d8f;
    }
</style>

<div class="container-fluid py-5">
    <div class="card">
        <!-- Cabecera -->
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 class="mb-0">Pedidos</h2>
        </div>
        <!-- Filtros y Opciones -->
        <div class="card-body">
            <div class="d-flex justify-content-between mb-4">
                <div>
                    <label for="entries" class="form-label me-2">Mostrar</label>
                    <select id="entries" class="form-select d-inline-block" style="width: auto;">
                        <option>10</option>
                        <option>25</option>
                        <option>50</option>
                        <option>100</option>
                    </select>
                    <span>registros por página</span>
                </div>
                <div class="search-container position-relative">
                    <input type="search" class="form-control" placeholder="Buscar" style="width: 300px;" />
                    <i class="bi bi-search position-absolute"></i>
                </div>
            </div>
            <!-- Tabla -->
            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Cliente</th>
                            <th>Total</th>
                            <th>Opciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var venta in Model)
                        {
                            <tr>
                                <td>@venta.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@venta.Owner?.NormalizedEmail</td>
                                <td>S/. @venta.Total</td>
                                <td class="text-center">
                                    <a class="btn btn-info btn-sm me-2" asp-controller="Venta" asp-action="Detalles" asp-route-id="@venta.VentaId">
                                        <i class="bi bi-eye"></i> Ver Detalles
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Paginación (si es necesario) -->
    <div class="d-flex justify-content-center mt-4">
        <nav aria-label="Page navigation example">
            <ul class="pagination">
                <li class="page-item">
                    <a class="page-link" href="#">Anterior</a>
                </li>
                <li class="page-item active">
                    <a class="page-link" href="#">1</a>
                </li>
                <li class="page-item">
                    <a class="page-link" href="#">2</a>
                </li>
                <li class="page-item">
                    <a class="page-link" href="#">3</a>
                </li>
                <li class="page-item">
                    <a class="page-link" href="#">Siguiente</a>
                </li>
            </ul>
        </nav>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
