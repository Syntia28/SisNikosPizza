@model SisNikosPizza.Domain.Models.Venta

@{
    ViewData["Title"] = "Detalle de la Venta";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<div class="container py-5">
    <h1 class="fw-bold text-gradient">DETALLE DE LA VENTA</h1>

    <!-- Botón de Regresar -->
    <div class="mb-4">
        <a href="javascript:history.back()" class="btn btn-secondary">
            <i class="bi bi-arrow-left-circle"></i> Regresar
        </a>
    </div>

    <!-- Información General de la Venta -->
    <div class="card mb-5 shadow-lg rounded">
        <div class="card-body">
            <h5 class="card-title text-uppercase text-primary mb-3">Información de la Venta</h5>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <p><strong>Número de Venta:</strong> <span class="text-muted">@Model.VentaId</span></p>
                </div>
                <div class="col-md-4 mb-3">
                    <p><strong>Fecha:</strong> <span class="text-muted">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</span></p>
                </div>
                <div class="col-md-4 mb-3">
                    <p><strong>Cliente:</strong> <span class="text-muted">@Model.Owner?.UserName</span></p>
                </div>
            </div>
        </div>
    </div>

    <!-- Detalle de la Venta -->
    <div class="table-responsive shadow-lg rounded mb-5">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-primary">
                <tr>
                    <th>Producto</th>
                    <th>Descripción</th>
                    <th>Cantidad</th>
                    <th>Precio Unitario</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var detalle in Model.Detalles)
                {
                    <tr>
                        <td class="d-flex align-items-center">
                            @if (detalle.Producto != null)
                            {
                                <img src="@detalle.Producto.ImagenUrl" alt="@detalle.Producto.Nombre" class="img-fluid rounded-circle" style="width: 50px; height: 50px; object-fit: cover; margin-right: 10px;" />
                                <span>@detalle.Producto.Nombre</span>
                            }
                            else
                            {
                                <span class="text-danger">Producto no disponible</span>
                            }
                        </td>
                        <td>@detalle.Producto.Descripcion</td>
                        <td class="text-center">@detalle.Cantidad</td>
                        <td class="text-end">S/. @detalle.PrecioUnitario</td>
                        <td class="text-end">S/. @detalle.PrecioTotal</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Total de la Venta -->
    <div class="d-flex justify-content-end mt-4">
        <div class="text-end">
            <h4 class="text-success">Total: S/. @Model.Total</h4>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
