@model SisNikosPizza.Domain.Models.Producto

@{
    ViewData["Title"] = "Eliminar Producto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<div class="container mx-auto py-8 px-4 sm:px-6 lg:px-8">
    <div class="mb-6">
        <h1
            class="text-3xl sm:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-yellow-500 to-yellow-700 animate-pulse">
            Eliminar Producto
        </h1>
    </div>

    <div class="bg-white shadow-2xl rounded-2xl overflow-hidden max-w-4xl mx-auto">
        <form method="post" asp-controller="Producto" asp-action="Delete">
            <input asp-for="ProductoId" hidden />
            <div
                class="bg-gradient-to-r from-yellow-500 to-yellow-700 text-white px-6 py-4 flex justify-between items-center">
                <h2 class="text-2xl font-semibold"><i class="bi bi-box-seam mr-2"></i> Confirmar Eliminación</h2>
                <a href="javascript:history.back()"
                    class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-yellow-600 to-yellow-800 text-white rounded-full hover:bg-gradient-to-r hover:from-yellow-700 hover:to-yellow-900 transition duration-300 ease-in-out transform hover:scale-105">
                    <i class="bi bi-arrow-left-circle mr-2"></i> Regresar
                </a>
            </div>
            <div class="p-6 bg-yellow-100">
                <div asp-validation-summary="ModelOnly" class="text-red-600 mb-4"></div>

                @if (!string.IsNullOrEmpty(Model.ImagenUrl))
                {
                    <div class="text-center mb-4">
                        <img fetchpriority="high" decoding="async" src="@Model.ImagenUrl" alt="Imagen del producto"
                            class="img-fluid rounded shadow-sm" style="max-height: 300px; object-fit: cover;" />
                    </div>
                }

                else
                {
                    <p class="text-gray-600 text-center mb-6">No hay imagen disponible</p>
                }

                <dl class="space-y-4">
                    <div
                        class="flex flex-col sm:flex-row sm:items-center bg-white rounded-lg shadow-md p-4 border border-gray-200">
                        <dt class="w-full sm:w-1/4 text-gray-600 font-medium">Producto ID</dt>
                        <dd class="w-full sm:w-3/4 text-gray-800">@Model.ProductoId</dd>
                    </div>
                    <div
                        class="flex flex-col sm:flex-row sm:items-center bg-white rounded-lg shadow-md p-4 border border-gray-200">
                        <dt class="w-full sm:w-1/4 text-gray-600 font-medium">Nombre</dt>
                        <dd class="w-full sm:w-3/4 text-gray-800">@Model.Nombre</dd>
                    </div>
                    <div
                        class="flex flex-col sm:flex-row sm:items-center bg-white rounded-lg shadow-md p-4 border border-gray-200">
                        <dt class="w-full sm:w-1/4 text-gray-600 font-medium">Categoría ID</dt>
                        <dd class="w-full sm:w-3/4 text-gray-800">@Model.CategoriaId</dd>
                    </div>
                    <div
                        class="flex flex-col sm:flex-row sm:items-center bg-white rounded-lg shadow-md p-4 border border-gray-200">
                        <dt class="w-full sm:w-1/4 text-gray-600 font-medium">Estado</dt>
                        <dd class="w-full sm:w-3/4 text-gray-800">
                            @if (Model.Estado)
                            {
                                <span
                                    class="inline-block px-2 py-1 text-sm font-semibold text-white bg-green-500 rounded-full">Activo</span>
                            }
                            else
                            {
                                <span
                                    class="inline-block px-2 py-1 text-sm font-semibold text-white bg-red-500 rounded-full">Inactivo</span>
                            }
                        </dd>
                    </div>
                    <div
                        class="flex flex-col sm:flex-row sm:items-center bg-white rounded-lg shadow-md p-4 border border-gray-200">
                        <dt class="w-full sm:w-1/4 text-gray-600 font-medium">Precio</dt>
                        <dd class="w-full sm:w-3/4 text-gray-800">S/. @Model.Precio</dd>
                    </div>
                    <div
                        class="flex flex-col sm:flex-row sm:items-center bg-white rounded-lg shadow-md p-4 border border-gray-200">
                        <dt class="w-full sm:w-1/4 text-gray-600 font-medium">Stock</dt>
                        <dd class="w-full sm:w-3/4 text-gray-800">@Model.Stock</dd>
                    </div>
                    <div
                        class="flex flex-col sm:flex-row sm:items-center bg-white rounded-lg shadow-md p-4 border border-gray-200">
                        <dt class="w-full sm:w-1/4 text-gray-600 font-medium">Descripción</dt>
                        <dd class="w-full sm:w-3/4 text-gray-800">@Model.Descripcion</dd>
                    </div>
                    <div
                        class="flex flex-col sm:flex-row sm:items-center bg-white rounded-lg shadow-md p-4 border border-gray-200">
                        <dt class="w-full sm:w-1/4 text-gray-600 font-medium">Creado el</dt>
                        <dd class="w-full sm:w-3/4 text-gray-800">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
                    </div>
                    <div
                        class="flex flex-col sm:flex-row sm:items-center bg-white rounded-lg shadow-md p-4 border border-gray-200">
                        <dt class="w-full sm:w-1/4 text-gray-600 font-medium">Actualizado el</dt>
                        <dd class="w-full sm:w-3/4 text-gray-800">@Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
                    </div>
                </dl>

                <div class="flex justify-center space-x-4 mt-6">
                    <button type="submit"
                        class="inline-flex items-center px-10 py-4 bg-gradient-to-r from-red-600 to-yellow-500 text-white rounded-full hover:bg-gradient-to-r hover:from-red-700 hover:to-yellow-600 transition duration-300 ease-in-out transform hover:scale-115 animate-pulse shadow-xl text-xl font-bold">
                        <i class="bi bi-trash-fill mr-2"></i> Eliminar
                    </button>
                    <a asp-controller="Producto" asp-action="Index"
                        class="inline-flex items-center px-6 py-2 bg-gray-700 text-white rounded-full hover:bg-gray-800 transition duration-300 ease-in-out transform hover:scale-105 shadow-lg">
                        <i class="bi bi-x-circle mr-2"></i> Cancelar
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>