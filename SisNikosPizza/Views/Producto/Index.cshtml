@model IEnumerable<SisNikosPizza.Domain.Models.Producto>

@{
    ViewData["Title"] = "Lista de Productos";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-white d-flex justify-content-between align-items-center rounded-top">
                    <h2 class="mb-0"><i class="bi bi-box-seam"></i> Productos</h2>
                    <a class="btn btn-success btn-sm" asp-controller="Producto" asp-action="Create">
                        <i class="bi bi-file-earmark-plus"></i> Nuevo Producto
                    </a>
                </div>
                <div class="card-body bg-light p-4">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>Imagen</th>
                                    <th>Nombre</th>
                                    <th>Precio</th>
                                    <th>Descripción</th>
                                    <th>Estado</th>
                                    <th>Stock</th>
                                    <th>Insumos</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var producto in Model)
                                {
                                    <tr>
                                        <td>
                                            @if (!string.IsNullOrEmpty(producto.ImagenUrl))
                                            {
                                                <img src="@producto.ImagenUrl" alt="Imagen del producto" class="img-thumbnail" style="max-width: 80px; object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <span class="text-muted">Sin imagen</span>
                                            }
                                        </td>
                                        <td>@producto.Nombre</td>
                                        <td>S/. @producto.Precio.ToString("F2")</td>
                                        <td>@producto.Descripcion</td>
                                        <td>
                                            <span class="badge @(producto.Estado ? "bg-success" : "bg-danger")">
                                                @(producto.Estado ? "Activo" : "Inactivo")
                                            </span>
                                        </td>
                                        <td>@producto.Stock</td>
                                        <td>
                                            @if (producto.ProductoInsumos != null && producto.ProductoInsumos.Any())
                                            {
                                                <ul class="list-unstyled mb-0">
                                                    @foreach (var pi in producto.ProductoInsumos)
                                                    {
                                                        <li>
                                                            <strong>@pi.Insumo?.Nombre</strong> - @pi.Cantidad @pi.Insumo?.UnidadeDeMedida
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                            else
                                            {
                                                <span class="text-muted">Sin insumos</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <div class="d-flex justify-content-center gap-2">
                                                <a asp-action="Details" asp-route-id="@producto.ProductoId" class="btn btn-info btn-sm" title="Detalles">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a asp-action="Edit" asp-route-id="@producto.ProductoId" class="btn btn-warning btn-sm" title="Editar">
                                                    <i class="fas fa-pencil"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@producto.ProductoId" class="btn btn-danger btn-sm" title="Eliminar">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
