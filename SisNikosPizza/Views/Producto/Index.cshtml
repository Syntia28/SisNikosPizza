@model IEnumerable<SisNikosPizza.Domain.Models.Producto>

@{
    ViewData["Title"] = "Lista de Productos";
    Layout = "~/Views/Shared/_Admin.cshtml";
}


<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card shadow-sm">
                <div style="background-color: #f7b248 !important" class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h2 class="mb-0">Productos</h2>
                    <a class="btn btn-success btn-sm" asp-controller="Producto" asp-action="Create">
                        <i class="bi bi-file-earmark-plus"></i>&nbsp;Nuevo Producto
                    </a>
                </div>
                <div style="background-color: #fff2cc" class="card-body p-4">
                    <table class="table table-striped table-hover align-middle">
                        <thead>
                            <tr>
                                <th style="width: 15%;">Imagen</th>
                                <th>Nombre</th>
                                <th>Precio</th>
                                <th>Descripción</th>
                                <th>Estado</th>
                                <th>Stock</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var producto in Model)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(producto.ImagenUrl))
                                        {
                                            <img src="@producto.ImagenUrl" alt="Imagen del producto" class="img-thumbnail" style="max-width: 100px; max-height: 100px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <span class="text-muted">Seleciona Imagen</span>
                                        }
                                    </td>
                                    <td>@producto.Nombre</td>
                                    <td>S/. @producto.Precio.ToString("F2")</td>
                                    <td>@producto.Descripcion</td>
                                    <td>
                                        @if (producto.Estado)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactivo</span>
                                        }
                                    </td>
                                    <td>@producto.Stock</td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@producto.ProductoId" class="btn btn-info btn-sm">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@producto.ProductoId" class="btn btn-warning btn-sm">
                                            <i class="fas fa-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@producto.ProductoId" class="btn btn-danger btn-sm">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
