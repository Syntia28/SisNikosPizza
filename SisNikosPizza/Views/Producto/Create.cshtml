@model SisNikosPizza.Domain.Models.Producto

@{
    ViewData["Title"] = "Crear Producto";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<section class="content container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <form method="post" asp-controller="Producto" asp-action="Create" enctype="multipart/form-data">
                <div class="card card-default shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h2 class="card-title mb-0">Nuevo Producto</h2>
                    </div>
                    <div class="card-body">
                        <!-- Validation Summary -->
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Nombre -->
                        <div class="form-group row mb-3">
                            <label class="col-md-3 col-form-label text-md-end">Nombre</label>
                            <div class="col-md-9">
                                <input type="text" asp-for="Nombre" class="form-control" placeholder="Nombre del producto" />
                                <span asp-validation-for="Nombre" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Descripción -->
                        <div class="form-group row mb-3">
                            <label class="col-md-3 col-form-label text-md-end">Descripción</label>
                            <div class="col-md-9">
                                <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Descripción del producto"></textarea>
                                <span asp-validation-for="Descripcion" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Categoría -->
                        <div class="form-group row mb-3">
                            <label class="col-md-3 col-form-label text-md-end">Categoría</label>
                            <div class="col-md-9">
                                <select asp-for="Categoriaid" asp-items="@ViewBag.CategoriesList" class="form-select">
                                    <option selected disabled>--Seleccionar categoría--</option>
                                </select>
                                <span asp-validation-for="Categoriaid" class="text-danger"></span>
                            </div>
                        </div>

                       

                        <!-- Precio -->
                        <div class="form-group row mb-3">
                            <label class="col-md-3 col-form-label text-md-end">Precio</label>
                            <div class="col-md-9">
                                <input type="number" asp-for="Precio" class="form-control" placeholder="Precio del producto" step="0.01" />
                                <span asp-validation-for="Precio" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- URL Imagen -->
                        <div class="form-group row mb-3">
                            <label class="col-md-3 col-form-label text-md-end">Imagen</label>
                            <div class="col-12 col-md-9">
                                <input type="file" name="imageFile" class="form-control" accept="image/*" />
                                <span asp-validation-for="ImagenUrl" class="text-danger"></span>
                            </div>
                        </div>
                      -

                        <!-- Estado -->
                        <div class="form-group row mb-3">
                            <label class="col-md-3 col-form-label text-md-end">Estado</label>
                            <div class="col-md-9">
                                <select asp-for="Estado" class="form-select">
                                    <option value="true">Activo</option>
                                    <option value="false">Inactivo</option>
                                </select>
                                <span asp-validation-for="Estado" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Botones -->
                        <div class="form-group row">
                            <div class="col-md-9 offset-md-3 d-flex justify-content-between">
                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-floppy"></i>&nbsp;Guardar
                                </button>
                                <a asp-controller="Categories" asp-action="Index" class="btn btn-secondary">
                                    <i class="bi bi-box-arrow-left"></i>&nbsp;Cancelar
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>
