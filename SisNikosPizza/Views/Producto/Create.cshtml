@model SisNikosPizza.Domain.ViewModels.VMDProducto

@{
    ViewData["Title"] = "Crear Producto";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<div class="container mx-auto py-8 px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-6">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-yellow-500 to-yellow-700 animate-pulse">
            Nuevo Producto
        </h1>
    </div>

    <!-- Card -->
    <div class="bg-white shadow-2xl rounded-2xl overflow-hidden max-w-4xl mx-auto">
        <form method="post" asp-controller="Producto" asp-action="Create" enctype="multipart/form-data">
            <!-- Card Header -->
            <div class="bg-gradient-to-r from-yellow-500 to-yellow-700 text-white px-6 py-4 flex justify-between items-center">
                <h2 class="text-2xl font-semibold"><i class="bi bi-box-seam mr-2"></i> Crear Producto</h2>
                <a href="javascript:history.back()" class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-yellow-600 to-yellow-800 text-white rounded-full hover:bg-gradient-to-r hover:from-yellow-700 hover:to-yellow-900 transition duration-300 ease-in-out transform hover:scale-105">
                    <i class="bi bi-arrow-left-circle mr-2"></i> Regresar
                </a>
            </div>
            <!-- Card Body -->
            <div class="p-6 bg-yellow-100">
                <!-- Success/Error Messages -->
                @if (TempData["Satisfactorio"] != null)
                {
                    <div class="mb-4 p-4 bg-green-100 text-green-700 rounded-lg flex justify-between items-center">
                        @TempData["Satisfactorio"]
                        <button type="button" class="text-green-700 hover:text-green-900" data-bs-dismiss="alert" aria-label="Close">
                            <i class="bi bi-x"></i>
                        </button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="mb-4 p-4 bg-red-100 text-red-700 rounded-lg flex justify-between items-center">
                        @TempData["Error"]
                        <button type="button" class="text-red-700 hover:text-red-900" data-bs-dismiss="alert" aria-label="Close">
                            <i class="bi bi-x"></i>
                        </button>
                    </div>
                }

                <!-- Validation Summary -->
                <div asp-validation-summary="ModelOnly" class="text-red-600 mb-4"></div>

                <!-- Nombre -->
                <div class="mb-6">
                    <label class="block text-gray-600 font-medium mb-2">Nombre <span class="text-red-500">*</span></label>
                    <input type="text" asp-for="producto.Nombre" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500" placeholder="Nombre del producto" />
                    <span asp-validation-for="producto.Nombre" class="text-red-600 text-sm"></span>
                </div>

                <!-- Descripción -->
                <div class="mb-6">
                    <label class="block text-gray-600 font-medium mb-2">Descripción</label>
                    <textarea asp-for="producto.Descripcion"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500"
                        rows="4" placeholder="Descripción del producto"></textarea>
                    <span asp-validation-for="producto.Descripcion" class="text-red-600 text-sm"></span>
                </div>

                <!-- Categoría -->
                <div class="mb-6">
                    <label class="block text-gray-600 font-medium mb-2">Categoría <span class="text-red-500">*</span></label>
                    <select asp-for="producto.CategoriaId" asp-items="@Model.CategoriasList"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500">
                        <option value="" selected disabled>--Seleccionar categoría--</option>
                    </select>
                    <span asp-validation-for="producto.CategoriaId" class="text-red-600 text-sm"></span>
                </div>

                <!-- Precio y Stock -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                    <div>
                        <label class="block text-gray-600 font-medium mb-2">Precio <span class="text-red-500">*</span></label>
                        <input type="number" asp-for="producto.Precio"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500"
                            placeholder="Precio del producto" step="0.01" min="0" />
                        <span asp-validation-for="producto.Precio" class="text-red-600 text-sm"></span>
                    </div>
                    <div>
                        <label class="block text-gray-600 font-medium mb-2">Stock <span class="text-red-500">*</span></label>
                        <input type="number" asp-for="producto.Stock"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500"
                            placeholder="Unidad" step="1" min="1" />
                        <span asp-validation-for="producto.Stock" class="text-red-600 text-sm"></span>
                    </div>
                </div>

                <!-- Insumos -->
                <div class="mb-6">
                    <label class="block text-gray-600 font-medium mb-2">Insumos <span class="text-red-500">*</span></label>
                    <table class="w-full border-collapse bg-white rounded-lg shadow-md" id="insumosTable">
                        <thead class="bg-gray-200 text-gray-700">
                            <tr>
                                <th class="px-4 py-3 text-left text-sm font-semibold">Insumo</th>
                                <th class="px-4 py-3 text-left text-sm font-semibold">Cantidad</th>
                                <th class="px-4 py-3 text-left text-sm font-semibold">Unidad de Medida</th>
                                <th class="px-4 py-3 text-center text-sm font-semibold">Acción</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200"></tbody>
                    </table>
                    <button type="button" class="mt-4 inline-flex items-center px-4 py-2 bg-gradient-to-r from-yellow-600 to-yellow-800 text-white rounded-full hover:bg-gradient-to-r hover:from-yellow-700 hover:to-yellow-900 transition duration-300 ease-in-out transform hover:scale-105 animate-pulse" onclick="addInsumoRow()">
                        <i class="bi bi-plus-circle mr-2"></i> Añadir Insumo
                    </button>
                </div>

                <!-- Imagen -->
                <div class="mb-6">
                    <label class="block text-gray-600 font-medium mb-2">Imagen <span class="text-red-500">*</span></label>
                    <input type="file" name="imageFile" accept="image/*" required class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-yellow-500 file:text-white hover:file:bg-yellow-600" />
                    <span asp-validation-for="producto.ImagenUrl" class="text-red-600 text-sm"></span>
                </div>

                <!-- Estado -->
                <div class="mb-6">
                    <label class="block text-gray-600 font-medium mb-2">Estado <span class="text-red-500">*</span></label>
                    <select asp-for="producto.Estado"
                        class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500">
                        <option value="true">Activo</option>
                        <option value="false">Inactivo</option>
                    </select>
                    <span asp-validation-for="producto.Estado" class="text-red-600 text-sm"></span>
                </div>

                <!-- Action Buttons -->
                <div class="flex justify-end space-x-4 mt-6">
                    <button type="submit" class="inline-flex items-center px-10 py-4 bg-gradient-to-r from-red-600 to-yellow-500 text-white rounded-full hover:bg-gradient-to-r hover:from-red-700 hover:to-yellow-600 transition duration-300 ease-in-out transform hover:scale-115 animate-pulse shadow-xl text-xl font-bold">
                        <i class="bi bi-floppy-fill mr-2"></i> Guardar
                    </button>
                    <a asp-controller="Producto" asp-action="Index" class="inline-flex items-center px-6 py-2 bg-gray-700 text-white rounded-full hover:bg-gray-800 transition duration-300 ease-in-out transform hover:scale-105">
                        <i class="bi bi-x-circle mr-2"></i> Cancelar
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @* <script>
