@model SisNikosPizza.Domain.Models.Carrito;

@{
    ViewData["Title"] = "Carrito de Compras";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<div class="container-fluid py-5">
    <!-- Título principal -->
    <div class="text-center mb-4">
        <h2 class="text-title">TU CARRITO DE COMPRAS</h2>
        <p class="text-muted">¡No olvides de revisar tu pedido antes de realizarlo!</p>
    </div>

    @if (Model.CarritoProductos == null || !Model.CarritoProductos.Any())
    {
        <!-- Mensaje si el carrito está vacío -->
        <div class="text-center">
            <h4 class="text-danger mb-3">¡Tu carrito está vacío!</h4>
            <a href="/Carta" class="btn btn-outline-primary btn-lg">Explorar Carta</a>
        </div>
    }
    else
    {
        <!-- Lista de productos -->
        <div class="row">
            @foreach (var carritoItem in Model.CarritoProductos)
            {
                <div class="col-12 col-md-6 col-lg-4 mb-4">
                    <div class="card custom-card shadow-lg border-0 rounded-lg overflow-hidden">
                        <!-- Título con fondo amarillo -->
                        <div class="btn btn-finalizar btn-lg w-100">
                            Tu Pedido
                        </div>

                        <!-- Contenido de la tarjeta -->
                        <div class="card-body">
                            <!-- Contenedor de producto: Imagen, nombre, cantidad, precio, etc. -->
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <!-- Imagen -->

                                <div class="mb-3">
                                    <img src="@carritoItem.Producto.ImagenUrl" alt="@carritoItem.Producto.Nombre" class="img-fluid rounded" style="width: 100%; height: 120px; object-fit: cover;" />
                                </div>

                                <!-- Información de la cantidad, precio unitario y total -->
                                <div class="">
                                    <!-- Detalles del producto (nombre) -->
                                    <div class="product-details">
                                        <h5 class="card-title text-dark fw-bold mb-2">@carritoItem.Producto.Nombre</h5>
                                    </div>
                                    <div class="w-30 d-flex justify-content-between align-items-center">
                                        <p class="text-muted mb-1 me-2"><strong>Cantidad:</strong></p>
                                        <p class="text-muted mb-1 me-2">@carritoItem.Cantidad</p>
                                    </div>

                                    <div class="w-30 d-flex justify-content-between align-items-center">
                                        <p class="text-muted mb-1"><strong>Precio Unitario:</strong></p>
                                        <p class="text-muted mb-1">S/. @carritoItem.Producto.Precio</p>
                                    </div>
                                    <div class="w-30 d-flex justify-content-between align-items-center">
                                        <p class="text-muted mb-1"><strong>Total:</strong></p>
                                        <p class="text-muted mb-1">S/. @(carritoItem.Cantidad * carritoItem.Producto.Precio)</p>
                                    </div>
                                </div>

                            </div>

                            <!-- Botones de acción (Aumentar, Disminuir, Eliminar) -->
                            <div class="action-buttons d-flex justify-content-end w-100">
                                <form asp-controller="Carrito" asp-action="IncrementarCantidad" class="d-inline-block">
                                    <input type="hidden" name="ProductoId" value="@carritoItem.Producto.ProductoId" />
                                    <button type="submit" class="btn btn-info btn-sm rounded-circle shadow-sm">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </form>

                                <form asp-controller="Carrito" asp-action="DecrementarCantidad" class="d-inline-block mx-2">
                                    <input type="hidden" name="ProductoId" value="@carritoItem.Producto.ProductoId" />
                                    <button type="submit" class="btn btn-warning btn-sm rounded-circle shadow-sm">
                                        <i class="fas fa-minus"></i>
                                    </button>
                                </form>

                                <form asp-controller="Carrito" asp-action="EliminarProducto" method="post"
                                    class="d-inline-block">
                                    <input type="hidden" name="ProductoId" value="@carritoItem.Producto.ProductoId" />
                                    <button type="submit" class="btn btn-danger btn-sm rounded-circle shadow-sm">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </form>
                            </div>


                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Cuadro con el resumen de precios -->
        <div class="mt-4">
            <div class="card shadow-sm p-4">
                <h4 class="text-center text-title mb-4">Resumen de tu Pago</h4>

                <div class="d-flex justify-content-between mb-3">
                    <span class="fw-bold">Subtotal:</span>
                    <span>S/. @Math.Round(Model.CarritoProductos.Sum(item => item.Cantidad * item.Producto.Precio) * 0.82,
                           2)</span>
                </div>
                <div class="d-flex justify-content-between mb-3">
                    <span class="fw-bold">Impuestos (18%):</span>
                    <span>S/. @Math.Round(Model.CarritoProductos.Sum(item => item.Cantidad * item.Producto.Precio) * 0.18,
                           2)</span>
                </div>
                <div class="d-flex justify-content-between mb-4">
                    <span class="fw-bold text-success">Total:</span>
                    <span class="text-success fs-5">S/. @Model.CarritoProductos.Sum(item => item.Cantidad *
                    item.Producto.Precio)</span>
                </div>

                <div class="text-center">
                    <a class="btn btn-finalizar btn-lg w-100" asp-controller="Pedidos" asp-action="Nuevo">Finalizar
                        Pedido</a>
                </div>
            </div>
        </div>
    }
</div>

<!-- Estilos personalizados -->
<style>
    .text-title {
        color: #D35400;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
        font-weight: bold;
        font-size: 2rem;
    }

    .btn-finalizar {
        background-color: #D35400;
        color: white;
        font-size: 1.2rem;
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
        transition: all 0.3s ease;
    }

    .btn-finalizar:hover {
        background-color: #E67E22;
        transform: scale(1.05);
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.3);
    }
</style>
