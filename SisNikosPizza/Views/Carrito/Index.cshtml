@model SisNikosPizza.Domain.Models.Carrito;

@{
    ViewData["Title"] = "Carrito de Compras";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<div class="container-fluid py-4">
    <!-- Título -->
    <div class="mb-4">
        <h2 class="text-left">Carrito de Compras</h2>
    </div>

    @if (Model.CarritoProductos == null || !Model.CarritoProductos.Any())
    {
        <!-- Mostrar mensaje si no hay productos -->
        <div class="text-center">
            <h4 class="mb-3">No hay productos en el carrito</h4>
            <a href="/Carta" class="btn btn-primary">Ver Carta</a>
        </div>
    }
    else
    {
        <!-- Lista de productos -->
        <div class="row">
            @foreach (var carritoItem in Model.CarritoProductos)
            {
                <div class="col-12 mb-3 p-3 border rounded d-flex align-items-center" style="background-color: rgba(255, 255, 255, 0.8);">
                    <!-- Imagen -->
                    <div class="me-3">
                        <img src="@carritoItem.Producto.ImagenUrl" alt="@carritoItem.Producto.Nombre" style="width: 50px; height: 50px; object-fit: cover;" />
                    </div>
                    <!-- Detalles del producto -->
                    <div class="flex-grow-1">
                        <h5 class="mb-1">@carritoItem.Producto.Nombre</h5>
                        <p class="mb-1">Cantidad: @carritoItem.Cantidad</p>
                        <p class="mb-1">Precio Unitario: S/. @carritoItem.Producto.Precio</p>
                        <p class="mb-1">Total: S/. @(carritoItem.Cantidad * carritoItem.Producto.Precio)</p>
                    </div>
                    <!-- Opciones -->
                    <div class="d-flex align-items-center">
                        <form asp-controller="Carrito" asp-action="IncrementarCantidad" class="me-2">
                            <input type="hidden" name="ProductoId" value="@carritoItem.Producto.ProductoId" />
                            <button type="submit" class="btn btn-info btn-sm">+</button>
                        </form>
                        <form asp-controller="Carrito" asp-action="DecrementarCantidad" method="post" class="me-2">
                            <input type="hidden" name="ProductoId" value="@carritoItem.Producto.ProductoId" />
                            <button type="submit" class="btn btn-warning btn-sm">-</button>
                        </form>
                        <form asp-controller="Carrito" asp-action="EliminarProducto" method="post">
                            <input type="hidden" name="ProductoId" value="@carritoItem.Producto.ProductoId" />
                            <button type="submit" class="btn btn-danger btn-sm">
                                <i class="fas fa-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>

        <div class="d-flex justify-content-end mt-4">

            <div class="text-end">
                <p class="mb-1">
                    <strong>Subtotal:</strong>
                    S/. @Math.Round(Model.CarritoProductos.Sum(item => item.Cantidad * item.Producto.Precio) * 0.82, 2)
                </p>
                <p class="mb-1">
                    <strong>Impuestos (18%):</strong>
                    S/. @Math.Round(Model.CarritoProductos.Sum(item => item.Cantidad * item.Producto.Precio) * 0.18, 2)
                </p>
                <p class="mb-1">
                    <strong>Total:</strong>
                    S/. @Model.CarritoProductos.Sum(item => item.Cantidad * item.Producto.Precio)
                </p>
               
               
            </div>
        </div>



        <!-- Botón de realizar pedido -->
        <div class="text-end">
            <a class="btn btn-primary" asp-controller="Pedidos" asp-action="Nuevo">Realizar Pedido</a>
        </div>
    }
</div>
