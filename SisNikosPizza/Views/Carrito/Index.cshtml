@using SisNikosPizza.Utilidades
@model SisNikosPizza.Domain.ViewModels.VMDCarrito

@{
    ViewData["Title"] = "Carrito de Compras";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/carrito.index.css" asp-append-version="true" />

    
    <div class="container-fluid">
        @Html.Raw("<script src=\"https://unpkg.com/@dotlottie/player-component@2.7.12/dist/dotlottie-player.mjs\" type=\"module\"></script>")
   
        @if (Model.listaCarritoItems == null || !Model.listaCarritoItems.Any())
        {
            <div class="empty-cart">
                <h4 class="text-danger mb-4">¡Tu carrito está vacío!</h4>
                <a href="/Carta" class="btn">Explorar Carta</a>
            </div>
        }
        else
        {

            <div class="card-wrapper">
                <div class="card">
                    <div class="card-header">
                        <dotlottie-player id="lottie-player" src="https://lottie.host/7cc5c610-8081-4951-9ff8-f03dfb0a38d0/vO4r4zS6zv.lottie"
                              background="transparent" speed="1" style="position: absolute; top: 10px; right: 10px; width: 100px; height: 100px" loop autoplay aria-label="Animación de carrito de compras">
                        </dotlottie-player>
                        <h2>Nuevo Pedido</h2>
                    </div>
                    <div class="card-body">
                        @if (!Model.listaCarritoItems.Any())
                        {
                            <div class="empty-cart">
                                <p class="text-muted fs-4 mb-4">¡Tu carrito está vacío!</p>
                                <a href="/Carta" class="btn btn-primary">Descubre Nuestra Carta</a>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive mb-5">
                                <table class="table table-bordered table-hover align-middle">
                                    <thead>
                                        <tr>
                                            <th></th>
                                            <th>Producto</th>
                                            <th>Cantidad</th>
                                            <th>Precio</th>
                                            <th>Total</th>
                                            <th>Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var carritoItem in Model.listaCarritoItems)
                                        {
                                            <tr>
                                                <td>
                                                    <img src="@carritoItem.Producto.ImagenUrl" alt="@carritoItem.Producto.Nombre" class="img-fluid">
                                                </td>
                                                <td>@carritoItem.Producto.Nombre</td>
                                                <td>@carritoItem.Cantidad</td>
                                                <td>S/. @carritoItem.Producto.Precio</td>
                                                <td>S/. @(carritoItem.Cantidad * carritoItem.Producto.Precio)</td>
                                                <td>
                                                    <div class="action-buttons d-flex justify-content-end mt-3 gap-2">
                                                        <form asp-controller="Carrito" asp-action="Update" method="post" class="d-inline-block form-cantidad">
                                                            <input type="hidden" name="CarritoItemId" value="@carritoItem.CarritoItemsId" />
                                                            <input type="hidden" name="Cantidad" value="1" />
                                                            <button type="submit" class="btn btn-info btn-custom" title="Aumentar cantidad">
                                                                <i class="fas fa-plus"></i>
                                                            </button>
                                                        </form>
                                                        <form asp-controller="Carrito" asp-action="Update" method="post" class="d-inline-block form-cantidad">
                                                            <input type="hidden" name="CarritoItemId" value="@carritoItem.CarritoItemsId" />
                                                            <input type="hidden" name="Cantidad" value="-1" />
                                                            <button type="submit" class="btn btn-warning btn-custom" title="Disminuir cantidad">
                                                                <i class="fas fa-minus"></i>
                                                            </button>
                                                        </form>
                                                        <form asp-controller="Carrito" asp-action="Delete" method="post" class="d-inline-block">
                                                            <input type="hidden" name="CarritoItemId" value="@carritoItem.CarritoItemsId" />
                                                            <button type="submit" class="btn btn-danger btn-custom" title="Eliminar producto">
                                                                <i class="fas fa-trash"></i>
                                                            </button>
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                        <tr>
                                                <td>
                                                    <img src="~/logo/logo.png" alt="logo" class="img-fluid">
                                                </td>
                                                <td></td>
                                                <td></td>
                                                <td></td>
                                                <td>S/. @Model.Total</td>
                                                <td>
                                                    
                                                </td>
                                            </tr>
                                    </tbody>
                                </table>
                            </div>

                            <form method="post" id="formPedido" asp-controller="Pedidos" asp-action="CrearPedido">
                                @for (int i = 0; i < Model.listaCarritoItems.Count; i++)
                                {
                                    <input type="hidden" name="listaCarritoItems[@i].CarritoItemsId" value="@Model.listaCarritoItems[i].CarritoItemsId" />
                                    <input type="hidden" name="listaCarritoItems[@i].ProductoId"     value="@Model.listaCarritoItems[i].ProductoId" />
                                    <input type="hidden" name="listaCarritoItems[@i].Cantidad"       value="@Model.listaCarritoItems[i].Cantidad" />
                                    <input type="hidden" name="listaCarritoItems[@i].PrecioUnitario" value="@Model.listaCarritoItems[i].PrecioUnitario" />
                                    <input type="hidden" name="listaCarritoItems[@i].PrecioTotal"    value="@Model.listaCarritoItems[i].PrecioTotal" />
                                }
                                <input type="hidden" asp-for="@Model.Total" value="@Math.Round(Model.Total * new decimal(0.18) + Model.Total, 2)" />
                                


                                <div class="section-title">Detalles del Pedido</div>
                                <div class="radio-group">
                                    <input type="radio" asp-for="Pedido.TipoPedido" id="delivery" value="@VCG.TipoPedido.Delivery" checked="@(Model.Pedido?.TipoPedido == VCG.TipoPedido.Delivery || Model.Pedido?.TipoPedido == null)">
                                    <label for="delivery">Delivery</label>

                                    <input type="radio" asp-for="Pedido.TipoPedido" id="recoger" value="@VCG.TipoPedido.Recoger" checked="@(Model.Pedido?.TipoPedido == VCG.TipoPedido.Recoger)">
                                    <label for="recoger">Recoger</label>

                                    <input type="radio" asp-for="Pedido.TipoPedido" id="mesa" value="@VCG.TipoPedido.Mesa" checked="@(Model.Pedido?.TipoPedido == VCG.TipoPedido.Mesa)">
                                    <label for="mesa">Mesa</label>
                                </div>

                                <div id="section-delivery" style="display:none;">
                                    <div class="input-group mb-3">
                                        <span class="input-group-text">📱</span>
                                        <input type="text" asp-for="Pedido.Telefono" class="form-control" placeholder="Teléfono">
                                    </div>
                                    <div class="input-group mb-3">
                                        <span class="input-group-text">🏠</span>
                                        <input type="text" asp-for="Pedido.Direccion" class="form-control" placeholder="Dirección">
                                    </div>
                                    <div class="input-group mb-3">
                                        <span class="input-group-text">📍</span>
                                        <input type="text" asp-for="Pedido.Referencia" class="form-control" placeholder="Referencia">
                                    </div>
                                </div>
                                <div id="section-recoger" style="display:none;">
                                    <div class="mb-4">
                                        <p class="mb-2"><strong>Recoger en:</strong> Jr. Reina Farje N° 175</p>
                                        <p class="mb-3"><strong>Referencia:</strong> Media cuadra del BCP de Sucre</p>
                                        <label asp-for="Pedido.FechaRecogo" class="form-label">Fecha de Recogida</label>
                                        <input type="datetime-local" asp-for="Pedido.FechaRecogo" class="form-control">
                                    </div>
                                </div>
                                <div id="section-mesa" style="display:none;">
                                    <div class="mb-4">
                                        <label asp-for="Pedido.Mesa" class="form-label">Número o Nombre de la Mesa</label>
                                        <input type="text" asp-for="Pedido.Mesa" class="form-control" placeholder="Ej: Mesa 5">
                                    </div>
                                </div>


                                <div class="order-summary">
                                    <div class="subtotal">
                                        <span>Subtotal:</span>
                                        <span>S/. @Model.Total</span>
                                    </div>
                                    <div class="impuestos">
                                        <span>Impuestos (18%):</span>
                                        <span>S/. @Math.Round(Model.listaCarritoItems.Sum(item => item.Cantidad * item.Producto.Precio) * 0.18, 2)</span>
                                    </div>
                                    <div class="total">
                                        <span>Total:</span>
                                        <span>S/. @Math.Round(Model.Total * new decimal(0.18) + Model.Total, 2)</span>
                                    </div>
                                </div>

                                <div class="text-end mt-4">
                                    <button type="submit" class="btn btn-success">Confirmar Pedido</button>
                                </div>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    
    </div>

    
@section Scripts {
    <script>

        document.querySelectorAll('.form-cantidad').forEach(form => {
            form.addEventListener('submit', async function (e) {
                e.preventDefault(); 

                const formData = new FormData(this);
                const data = new URLSearchParams(formData);
                
                const response = await fetch(this.action, {
                    method: 'POST',
                    body: data,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                if (response.ok) {
                    location.reload();
                } else {
                    alert("Error al actualizar el carrito.");
                }
            });
        });

        function toggleTipoPedidoSection() {
            const tipoPedidoRadios = document.querySelectorAll('input[name="Pedido.TipoPedido"]');
            let tipoSeleccionado = '';
            tipoPedidoRadios.forEach(radio => {
                if (radio.checked) {
                    tipoSeleccionado = radio.value;
                }
            });

            const sectionDelivery = document.getElementById('section-delivery');
            const sectionRecoger = document.getElementById('section-recoger');
            const sectionMesa = document.getElementById('section-mesa');

            const inputTelefono = document.getElementById('Pedido_Telefono');
            const inputDireccion = document.getElementById('Pedido_Direccion');
            const inputFechaRecogo = document.getElementById('Pedido_FechaRecogo');
            const inputMesa = document.getElementById('Pedido_Mesa');

            sectionDelivery.style.display = 'none';
            if (inputTelefono) inputTelefono.required = false;
            if (inputDireccion) inputDireccion.required = false;

            sectionRecoger.style.display = 'none';
            if (inputFechaRecogo) inputFechaRecogo.required = false;
            
            sectionMesa.style.display = 'none';
            if (inputMesa) inputMesa.required = false;

            if (tipoSeleccionado === '@VCG.TipoPedido.Delivery') {
                sectionDelivery.style.display = 'block';
                if (inputTelefono) inputTelefono.required = true;
                if (inputDireccion) inputDireccion.required = true;
            } else if (tipoSeleccionado === '@VCG.TipoPedido.Recoger') {
                sectionRecoger.style.display = 'block';
                if (inputFechaRecogo) inputFechaRecogo.required = true;
            } else if (tipoSeleccionado === '@VCG.TipoPedido.Mesa') {
                sectionMesa.style.display = 'block';
                if (inputMesa) inputMesa.required = true;
            }
        }

        document.querySelectorAll('input[name="Pedido.TipoPedido"]').forEach(input => {
            input.addEventListener('change', toggleTipoPedidoSection);
        });

        window.addEventListener('DOMContentLoaded', () => {
            const tipoPedidoActual = "@Model.Pedido?.TipoPedido";
            if (tipoPedidoActual) {
                const radioAChequear = document.querySelector(`input[name="Pedido.TipoPedido"][value="${tipoPedidoActual}"]`);
                if (radioAChequear) {
                    radioAChequear.checked = true;
                }
            } else {
                const deliveryRadio = document.getElementById('delivery');
                if (deliveryRadio) {
                    deliveryRadio.checked = true;
                }
            }
            toggleTipoPedidoSection(); 
        });
    </script>
}