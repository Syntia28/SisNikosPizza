@using SisNikosPizza.Utilidades
@model SisNikosPizza.Domain.ViewModels.VMDCarrito

@{
    ViewData["Title"] = "Carrito de Compras";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/carrito.index.css" asp-append-version="true" />

    
    <div class="container-fluid">
        @Html.Raw("<script src=\"https://unpkg.com/@dotlottie/player-component@2.7.12/dist/dotlottie-player.mjs\" type=\"module\"></script>")
   
        @if (Model.listaCarritoItems == null || !Model.listaCarritoItems.Any())
        {
            <div class="empty-cart">
                <h4 class="text-danger mb-4">¡Tu carrito está vacío!</h4>
                <a href="/Carta" class="btn">Explorar Carta</a>
            </div>
        }
        else
        {
            @* opciones del tipo de pedido *@

            <div class="card-wrapper">
                <div class="card">
                    <div class="card-header">
                        <dotlottie-player id="lottie-player" src="https://lottie.host/7cc5c610-8081-4951-9ff8-f03dfb0a38d0/vO4r4zS6zv.lottie"
                              background="transparent" speed="1" style="position: absolute; top: 10px; right: 10px; width: 100px; height: 100px" loop autoplay aria-label="Animación de carrito de compras">
                        </dotlottie-player>
                        <h2>Nuevo Pedido</h2>
                    </div>
                    <div class="card-body">
                        @if (!Model.listaCarritoItems.Any())
                        {
                            <div class="empty-cart">
                                <p class="text-muted fs-4 mb-4">¡Tu carrito está vacío!</p>
                                <a href="/Carta" class="btn btn-primary">Descubre Nuestra Carta</a>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive mb-5">
                                <table class="table table-bordered table-hover align-middle">
                                    <thead>
                                        <tr>
                                            <th></th>
                                            <th>Producto</th>
                                            <th>Cantidad</th>
                                            <th>Precio</th>
                                            <th>Total</th>
                                            <th>Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var carritoItem in Model.listaCarritoItems)
                                        {
                                            <tr>
                                                <td>
                                                    <img src="@carritoItem.Producto.ImagenUrl" alt="@carritoItem.Producto.Nombre" class="img-fluid">
                                                </td>
                                                <td>@carritoItem.Producto.Nombre</td>
                                                <td>@carritoItem.Cantidad</td>
                                                <td>S/. @carritoItem.Producto.Precio</td>
                                                <td>S/. @(carritoItem.Cantidad * carritoItem.Producto.Precio)</td>
                                                <td>
                                                    <div class="action-buttons d-flex justify-content-end mt-3 gap-2">
                                                        <form asp-controller="Carrito" asp-action="Update" method="post" class="d-inline-block form-cantidad">
                                                            <input type="hidden" name="CarritoItemId" value="@carritoItem.CarritoItemsId" />
                                                            <input type="hidden" name="Cantidad" value="1" />
                                                            <button type="submit" class="btn btn-info btn-custom" title="Aumentar cantidad">
                                                                <i class="fas fa-plus"></i>
                                                            </button>
                                                        </form>
                                                        <form asp-controller="Carrito" asp-action="Update" method="post" class="d-inline-block form-cantidad">
                                                            <input type="hidden" name="CarritoItemId" value="@carritoItem.CarritoItemsId" />
                                                            <input type="hidden" name="Cantidad" value="-1" />
                                                            <button type="submit" class="btn btn-warning btn-custom" title="Disminuir cantidad">
                                                                <i class="fas fa-minus"></i>
                                                            </button>
                                                        </form>
                                                        <form asp-controller="Carrito" asp-action="Delete" method="post" class="d-inline-block">
                                                            <input type="hidden" name="CarritoItemId" value="@carritoItem.CarritoItemsId" />
                                                            <button type="submit" class="btn btn-danger btn-custom" title="Eliminar producto">
                                                                <i class="fas fa-trash"></i>
                                                            </button>
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                        <tr>
                                                <td>
                                                    <img src="~/logo/logo.png" alt="logo" class="img-fluid">
                                                </td>
                                                <td></td>
                                                <td></td>
                                                <td></td>
                                                <td>S/. @Model.Total</td>
                                                <td>
                                                    
                                                </td>
                                            </tr>
                                    </tbody>
                                </table>
                            </div>

                            <form method="post" id="formPedido" asp-controller="Pedidos" asp-action="CrearPedido">
                                @* lista para enviar al servidor *@
                                @for (int i = 0; i < Model.listaCarritoItems.Count; i++)
                                {
                                    <input type="hidden" name="listaCarritoItems[@i].CarritoItemsId" value="@Model.listaCarritoItems[i].CarritoItemsId" />
                                    <input type="hidden" name="listaCarritoItems[@i].ProductoId"     value="@Model.listaCarritoItems[i].ProductoId" />
                                    <input type="hidden" name="listaCarritoItems[@i].Cantidad"       value="@Model.listaCarritoItems[i].Cantidad" />
                                    <input type="hidden" name="listaCarritoItems[@i].PrecioUnitario" value="@Model.listaCarritoItems[i].PrecioUnitario" />
                                    <input type="hidden" name="listaCarritoItems[@i].PrecioTotal"    value="@Model.listaCarritoItems[i].PrecioTotal" />
                                }
                                <input type="hidden" asp-for="@Model.Total" value="@Math.Round(Model.Total * new decimal(0.18) + Model.Total, 2)" />
                                


                                <div class="section-title">Detalles del Pedido</div>
                                <div class="radio-group">
                                    <input type="radio" name="TipoPedido" id="delivery" value="@VCG.TipoPedido.Delivery">
                                    <label for="delivery">Delivery</label>

                                    <input type="radio" name="TipoPedido" id="recoger" value="@VCG.TipoPedido.Recoger">
                                    <label for="recoger">Recoger</label>

                                    <input type="radio" name="TipoPedido" id="mesa" value="@VCG.TipoPedido.Mesa">
                                    <label for="mesa">Mesa</label>
                                </div>

                                <div id="section-delivery" style="display:none;">
                                    @* <!-- inputs de Teléfono, Dirección, Referencia --> *@
                                    <input type="hidden" asp-for="@Model.Pedido.TipoPedido" value="@VCG.TipoPedido.Delivery" />
                                    <div class="input-group mb-3">
                                        <span class="input-group-text">📱</span>
                                        <input type="text" asp-for="@Model.Pedido.Telefono" class="form-control" placeholder="Teléfono" required>
                                    </div>
                                    <div class="input-group mb-3">
                                        <span class="input-group-text">🏠</span>
                                        <input type="text" asp-for="@Model.Pedido.Direccion" class="form-control" placeholder="Dirección" required>
                                    </div>
                                    <div class="input-group mb-3">
                                        <span class="input-group-text">📍</span>
                                        <input type="text" asp-for="@Model.Pedido.Referencia" class="form-control" placeholder="Referencia">
                                    </div>
                                </div>
                                <div id="section-recoger" style="display:none;">
                                    @* <!-- inputs de FechaRecogo --> *@
                                    <input type="hidden" asp-for="@Model.Pedido.TipoPedido" value="@VCG.TipoPedido.Recoger" />
                                    <div class="mb-4">
                                        <p class="mb-2"><strong>Recoger en:</strong> Jr. Reina Farje N° 175</p>
                                        <p class="mb-3"><strong>Referencia:</strong> Media cuadra del BCP de Sucre</p>
                                        <span class="form-label">Fecha de Recogida</span>
                                        <input type="datetime-local" asp-for="@Model.Pedido.FechaRecogo" class="form-control" required>
                                    </div>
                                </div>
                                <div id="section-mesa" style="display:none;">
                                    @* <!-- inputs de Mesa --> *@
                                    <input type="hidden" asp-for="@Model.Pedido.TipoPedido" value="@VCG.TipoPedido.Mesa" />
                                    <div class="mb-4">
                                        <span class="form-label">Número o Nombre de la Mesa</span>
                                        <input type="text" asp-for="@Model.Pedido.Mesa" class="form-control" placeholder="Ej: Mesa 5" required>
                                    </div>
                                </div>


                                <div class="order-summary">
                                    <div class="subtotal">
                                        <span>Subtotal:</span>
                                        <span>S/. @Model.Total</span>
                                    </div>
                                    <div class="impuestos">
                                        <span>Impuestos (18%):</span>
                                        <span>S/. @Math.Round(Model.listaCarritoItems.Sum(item => item.Cantidad * item.Producto.Precio) * 0.18, 2)</span>
                                    </div>
                                    <div class="total">
                                        <span>Total:</span>
                                        <span>S/. @Math.Round(Model.Total * new decimal(0.18) + Model.Total, 2)</span>
                                    </div>
                                </div>

                                <div class="text-end mt-4">
                                    <button type="submit" class="btn btn-success">Confirmar Pedido</button>
                                </div>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    
    </div>

    
@section Scripts {
    <script>

        document.querySelectorAll('.form-cantidad').forEach(form => {
            form.addEventListener('submit', async function (e) {
                e.preventDefault(); // Evita que recargue la página

                const formData = new FormData(this);
                const data = new URLSearchParams(formData);
                
                const response = await fetch(this.action, {
                    method: 'POST',
                    body: data,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                if (response.ok) {
                    location.reload();
                } else {
                    alert("Error al actualizar el carrito.");
                }
            });
        });

        function toggleTipoPedidoSection() {
        const tipo = document.querySelector('input[name="TipoPedido"]:checked').value;

        if (tipo === 'Delivery') {
            document.getElementById('section-delivery').style.display = 'block';


            document.getElementById('section-mesa').style.display = 'none';
            document.getElementById('section-recoger').style.display = 'none';


            document.getElementById("Pedido_FechaRecogo").required = false;
            document.getElementById("Pedido_Mesa").required = false;
        } else if (tipo === 'Recoger') {
            document.getElementById("Pedido_Telefono").required = false;
            document.getElementById("Pedido_Direccion").required = false;
            document.getElementById("Pedido_FechaRecogo").required = false;


            document.getElementById('section-mesa').style.display = 'none';
            document.getElementById('section-delivery').style.display = 'none';

            document.getElementById('section-recoger').style.display = 'block';
        } else if (tipo === 'Mesa') {
            document.getElementById("Pedido_FechaRecogo").required = false;
            document.getElementById("Pedido_Telefono").required = false;
            document.getElementById("Pedido_Direccion").required = false;


            document.getElementById('section-recoger').style.display = 'none';
            document.getElementById('section-delivery').style.display = 'none';

            document.getElementById('section-mesa').style.display = 'block';
        }
    }

    document.querySelectorAll('input[name="TipoPedido"]').forEach(input => {
        input.addEventListener('change', toggleTipoPedidoSection);
    });

    // Ejecutar al cargar por si ya hay un tipo marcado
    window.addEventListener('DOMContentLoaded', toggleTipoPedidoSection);
    </script>
}