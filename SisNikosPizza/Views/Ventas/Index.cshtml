@using SisNikosPizza.Utilidades
@model IEnumerable<SisNikosPizza.Domain.ViewModels.VMDDetallesPedido>
@using Microsoft.AspNetCore.Identity

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Ventas";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #fff3e0 0%, #ffe082 100%);
            color: #212121;
            margin: 0;
            padding: 0;
        }
        .container-fluid {
            max-width: 1400px;
            padding: 4rem 1.5rem;
            margin: 0 auto;
        }
        .card {
            border-radius: 20px;
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.2);
            background: #ffffff;
            border: 2px solid #ffca28;
            animation: slideIn 0.7s ease-out;
        }
        @@keyframes slideIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .card-header {
            background: linear-gradient(90deg, #ff8f00, #ffca28);
            color: #fff;
            padding: 1.5rem;
            border-top-left-radius: 20px;
            border-top-right-radius: 20px;
            font-family: 'Poppins', sans-serif;
            font-size: 1.8rem;
            font-weight: 700;
            text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.2);
        }
        .card-body {
            background: #fff8e1;
            padding: 2rem;
        }
        .table th, .table td {
            text-align: center;
            padding: 1rem;
            font-size: 1rem;
            vertical-align: middle;
        }
        .table th {
            background: linear-gradient(90deg, #ffca28, #ffe082);
            color: #212121;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.9rem;
            letter-spacing: 0.05rem;
        }
        .table tbody tr {
            transition: all 0.3s ease;
        }
        .table tbody tr:hover {
            background: #fff3e0;
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }
        .form-select, .form-control {
            border-radius: 30px;
            height: 45px;
            padding-left: 15px;
            border: 2px solid #ffca28;
            transition: all 0.3s ease;
        }
        .form-select:focus, .form-control:focus {
            border-color: #ff8f00;
            box-shadow: 0 0 8px rgba(255, 143, 0, 0.3);
        }
        .btn-info, .btn-success {
            background: linear-gradient(90deg, #ff8f00, #ffca28);
            border: none;
            color: #fff;
            border-radius: 30px;
            padding: 0.5rem 1.5rem;
            font-size: 0.95rem;
            font-weight: 600;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }
        .btn-info:hover, .btn-success:hover {
            background: linear-gradient(90deg, #e67e22, #ffb300);
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(255, 143, 0, 0.3);
        }
        .btn-outline-warning {
            border: 2px solid #ffca28;
            color: #ff8f00;
            border-radius: 30px;
            padding: 0.5rem 1.5rem;
            font-size: 0.95rem;
            font-weight: 600;
            transition: all 0.3s ease;
        }
        .btn-outline-warning:hover {
            background: #ffca28;
            color: #212121;
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(255, 143, 0, 0.3);
        }
        .search-container, .date-container {
            position: relative;
        }
        .search-container input {
            padding-left: 40px;
            background: #ffffff;
        }
        .search-container .bi-search {
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 1.2rem;
            color: #ff8f00;
            transition: color 0.3s ease;
        }
        .search-container input:focus + .bi-search {
            color: #e67e22;
        }
        .pagination .page-item a {
            background: #ff8f00;
            color: #fff;
            border-radius: 30px;
            padding: 0.5rem 1rem;
            margin: 0 0.3rem;
            border: none;
            transition: all 0.3s ease;
        }
        .pagination .page-item.active a {
            background: #ffca28;
            color: #212121;
            font-weight: 600;
        }
        .pagination .page-item a:hover {
            background: #e67e22;
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }
        .pagination .page-item.disabled a {
            background: #ccc;
            color: #666;
            cursor: not-allowed;
        }
        @@media (max-width: 768px) {
            .container-fluid { padding: 3rem 1rem; }
            .card-header { font-size: 1.5rem; padding: 1.2rem; }
            .card-body { padding: 1.5rem; }
            .table th, .table td { font-size: 0.9rem; padding: 0.8rem; }
            .form-select, .form-control { height: 40px; max-width: 100%; }
            .btn-info, .btn-success, .btn-outline-warning { padding: 0.4rem 1rem; font-size: 0.9rem; }
        }
        @@media (max-width: 576px) {
            .card-header { font-size: 1.3rem; }
            .table th, .table td { font-size: 0.85rem; padding: 0.6rem; }
            .btn-info, .btn-success, .btn-outline-warning { font-size: 0.85rem; padding: 0.3rem 0.8rem; }
            .d-flex.flex-wrap { flex-direction: column; align-items: stretch; }
            .search-container, .date-container { width: 100%; }
            .search-container input, .date-container input { width: 100%; max-width: none; }
        }
    </style>
}

<div class="container-fluid py-5">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 class="mb-0"><i class="fas fa-pizza-slice me-2"></i> Ventas</h2>
        </div>
        <div class="card-body">
            <!-- Filter and Export Form -->
            <div class="d-flex flex-wrap gap-3 mb-4">
                <div class="d-flex align-items-center gap-2">
                    <label for="entries" class="form-label mb-0">Mostrar</label>
                    <select id="entries" name="pageSize" class="form-select" style="width: auto; border-color: #ffca28;">
                        <option value="10" selected="@(ViewBag.PageSize == 10)">10</option>
                        <option value="25" selected="@(ViewBag.PageSize == 25)">25</option>
                        <option value="50" selected="@(ViewBag.PageSize == 50)">50</option>
                        <option value="100" selected="@(ViewBag.PageSize == 100)">100</option>
                    </select>
                    <span>registros por página</span>
                </div>
                <div class="search-container position-relative flex-grow-1">
                    <input type="text" name="searchEmail" class="form-control" placeholder="Buscar por email..." value="@ViewBag.SearchEmail" style="width: 100%; max-width: 300px; border-color: #ffca28;" />
                    <i class="bi bi-search position-absolute"></i>
                </div>
                <div class="date-container position-relative">
                    <input type="date" name="searchDate" class="form-control" value="@(ViewBag.SearchDate != null ? ViewBag.SearchDate.ToString("yyyy-MM-dd") : "")" style="width: 100%; max-width: 200px; border-color: #ffca28;" />
                </div>
                <div class="d-flex align-items-center gap-2">
                    <label for="exportPeriod" class="form-label mb-0">Exportar por</label>
                    <select id="exportPeriod" name="exportPeriod" class="form-select" style="width: auto; border-color: #ffca28;">
                        <option value="daily">Diario</option>
                        <option value="weekly">Semanal</option>
                        <option value="monthly">Mensual</option>
                    </select>
                </div>
                    <form asp-controller="Reportes" asp-action="DescargarExcel" method="get">
                        <button type="submit" class="btn btn-success ms-2">
                            <i class="bi bi-file-earmark-excel"></i> Exportar a Excel
                        </button>
                    </form>
            </div>

            <!-- Sales Table -->
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Cliente</th>
                            <th>Total</th>
                            <th>Productos</th>
                            <th>Opciones</th>
                        </tr>
                    </thead>
                    <tbody id="salesTable">
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted">No se encontraron resultados.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var venta in Model)
                            {
                                <tr>
                                    <td>@venta.FechaPedido.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@venta.Usuario.UserName</td>
                                    <td class="text-success fw-bold">@venta.Detalles.Sum(total => total.PrecioTotal)</td>
                                    <td> @venta.Detalles.Count()</td>
                                    <td class="text-center">
                                        <a asp-controller="Ventas" asp-action="Cobrar" asp-route-id="@venta.PedidoId">Ver Detalles</a>

                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    <div class="d-flex justify-content-center mt-4">
        <nav aria-label="Page navigation">
            <ul class="pagination">
                <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage - 1, pageSize = ViewBag.PageSize, searchEmail = ViewBag.SearchEmail, searchDate = ViewBag.SearchDate })" aria-label="Anterior">Anterior</a>
                </li>
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("Index", new { page = i, pageSize = ViewBag.PageSize, searchEmail = ViewBag.SearchEmail, searchDate = ViewBag.SearchDate })">@i</a>
                    </li>
                }
                <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = ViewBag.CurrentPage + 1, pageSize = ViewBag.PageSize, searchEmail = ViewBag.SearchEmail, searchDate = ViewBag.SearchDate })" aria-label="Siguiente">Siguiente</a>
                </li>
            </ul>
        </nav>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDKzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const searchInput = document.querySelector('input[name="searchEmail"]');
            const dateInput = document.querySelector('input[name="searchDate"]');
            const tableRows = document.querySelectorAll('#salesTable tr');
            const entriesSelect = document.querySelector('#entries');
            const noResultsRow = document.createElement('tr');
            noResultsRow.innerHTML = '<td colspan="4" class="text-center text-muted">No se encontraron resultados.</td>';

            function filterRows() {
                let visibleRows = 0;
                const query = searchInput.value.toLowerCase();
                const selectedDate = dateInput.value;

                tableRows.forEach(row => {
                    const email = row.cells[1].textContent.toLowerCase();
                    const date = row.cells[0].textContent.split(' ')[0]; // Extract date part (dd/MM/yyyy)
                    const formattedDate = selectedDate ? new Date(selectedDate).toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit', year: 'numeric' }) : '';

                    const matchesEmail = query ? email.includes(query) : true;
                    const matchesDate = selectedDate ? date === formattedDate : true;

                    if (matchesEmail && matchesDate) {
                        row.style.display = '';
                        visibleRows++;
                    } else {
                        row.style.display = 'none';
                    }
                });

                const tbody = document.querySelector('#salesTable');
                if (visibleRows === 0 && !tbody.contains(noResultsRow)) {
                    tbody.appendChild(noResultsRow);
                } else if (visibleRows > 0 && tbody.contains(noResultsRow)) {
                    tbody.removeChild(noResultsRow);
                }
            }

            searchInput.addEventListener('input', filterRows);
            dateInput.addEventListener('change', filterRows);
            entriesSelect.addEventListener('change', () => {
                filterRows(); // Reapply filters after changing page size
            });
        });
    </script>
}