﻿@{
ViewData["Title"] = "Detalle de la Venta";
Layout = "~/Views/Shared/_Admin.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<div class="container mx-auto py-8 px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-6">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-red-600 via-yellow-500 to-orange-600 animate-pulse">
            Detalle de la Venta
        </h1>
    </div>

    <!-- Back Button -->
    <div class="mb-6">
        <a href="javascript:history.back()" class="inline-flex items-center px-4 py-2 bg-yellow-500 text-white rounded-full hover:bg-yellow-600 transition duration-300 ease-in-out transform hover:scale-105">
            <i class="bi bi-arrow-left-circle mr-2"></i> Regresar
        </a>
    </div>

    <!-- Sale Information Card -->
    <div class="bg-white shadow-xl rounded-2xl mb-8 p-6 transform hover:shadow-2xl transition duration-300">
        <h2 class="text-2xl font-semibold text-gray-800 mb-4 border-b-2 border-orange-500 pb-2">Información de la Venta</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            <div>
                <p class="text-sm font-medium text-gray-600">Número de Venta</p>
                <p class="text-lg text-gray-900">@Model.VentaId</p>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-600">Fecha</p>
                <p class="text-lg text-gray-900">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-600">Cliente</p>
                <p class="text-lg text-gray-900">@Model.Owner?.UserName</p>
            </div>
        </div>
    </div>

    <!-- Sale Details Table -->
    <div class="bg-white shadow-xl rounded-2xl overflow-hidden mb-8">
        <div class="overflow-x-auto">
            <table class="w-full table-auto">
                <thead class="bg-gradient-to-r from-red-600 to-orange-600 text-white">
                    <tr>
                        <th class="px-6 py-4 text-left text-sm font-semibold">Producto</th>
                        <th class="px-6 py-4 text-left text-sm font-semibold">Descripción</th>
                        <th class="px-6 py-4 text-center text-sm font-semibold">Cantidad</th>
                        <th class="px-6 py-4 text-right text-sm font-semibold">Precio Unitario</th>
                        <th class="px-6 py-4 text-right text-sm font-semibold">Subtotal</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    @foreach (var detalle in Model.Detalles)
                    {
                        <tr class="hover:bg-gray-50 transition duration-200">
                            <td class="px-6 py-4 flex items-center">
                                @if (detalle.Producto != null)
                                {
                                    <img src="@detalle.Producto.ImagenUrl" alt="@detalle.Producto.Nombre" class="w-12 h-12 rounded-full object-cover mr-3 border-2 border-orange-300" />
                                    <span class="text-gray-800 font-medium">@detalle.Producto.Nombre</span>
                                }
                                else
                                {
                                    <span class="text-red-600 font-medium">Producto no disponible</span>
                                }
                            </td>
                            <td class="px-6 py-4 text-gray-600">@detalle.Producto.Descripcion</td>
                            <td class="px-6 py-4 text-center text-gray-800">@detalle.Cantidad</td>
                            <td class="px-6 py-4 text-right text-gray-800">S/. @detalle.PrecioUnitario</td>
                            <td class="px-6 py-4 text-right text-gray-800 font-semibold">S/. @detalle.PrecioTotal</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Total -->
    <div class="flex justify-end">
        <div class="bg-gradient-to-r from-green-500 to-green-700 text-white px-6 py-3 rounded-full shadow-lg">
            <h3 class="text-xl font-bold">Total: S/. @Model.Total</h3>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>