﻿@using SisNikosPizza.Utilidades
@model SisNikosPizza.Domain.ViewModels.VMDDetallesPedido

@{
    ViewData["Title"] = "detalle de ventas";
    Layout = "~/Views/Shared/_Admin.cshtml";
}
@section Styles {
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@4"></script>
    <script defer src="https://unpkg.com/@@alpinejs/collapse@3.x.x/dist/cdn.min.js"></script>
    <script src="https://unpkg.com/alpinejs" defer></script>

    <style>
        .fade-in {
            animation: fadeIn 1s ease-in-out;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .glow-border {
            box-shadow: 0 0 15px rgba(99, 102, 241, 0.3);
            transition: box-shadow 0.3s ease-in-out;
        }

        .glow-border:hover {
            box-shadow: 0 0 25px rgba(99, 102, 241, 0.6);
        }

        .btn-return {
            transition: all 0.3s ease-in-out;
        }

        .btn-return:hover {
            transform: translateX(-3px);
            box-shadow: 0 0 10px rgba(99, 102, 241, 0.4);
        }
    </style>
}

<div class="flex flex-col items-center gap-10 py-10 bg-gradient-to-tr from-gray-100 to-gray-200 min-h-screen"
    role="main">

    <div
        class="w-full max-w-2xl bg-white rounded-3xl glow-border shadow-2xl p-8 fade-in relative transition-all duration-300 ease-in-out">

        <!-- Botón regresar -->
        <div class="absolute top-2 left-2">
            <a asp-action="Index"
                class="inline-flex items-center gap-2 bg-indigo-600 text-white text-sm font-medium px-4 py-2 rounded-full shadow-md btn-return">
                <i class="fa-solid fa-arrow-left"></i> Regresar
            </a>
        </div>

        <div class="flex flex-col items-center text-center mb-6 space-y-1">
            <span class="text-4xl font-extrabold text-indigo-700 tracking-widest">NIKOS PIZZA</span>
            <span class="text-sm text-gray-600 italic">Detalle de venta</span>
            <span class="text-xs text-gray-400">📅 @Model.FechaPedido.ToString("dd/MM/yyyy HH:mm")</span>
        </div>

        <div class="flex flex-col gap-2 mb-6">
            <div class="flex justify-between text-sm font-medium text-gray-700">
                <span>👤 Cliente:</span>
                <span>@Model.Usuario.UserName</span>
            </div>
            @if (Model.Detalles.First().Pedido.Direccion != null)
            {
                <div class="flex justify-between text-sm font-medium text-gray-700">
                    <span>📍 Dirección:</span>
                    <span>@Model.Detalles.First().Pedido.Direccion</span>
                </div>
            }
        </div>

        <div class="border-t border-b border-gray-300 py-4 mb-6">
            <h3 class="text-center text-lg font-semibold text-indigo-600 mb-3">🧾 Detalle del Pedido</h3>
            <ul class="space-y-3">
                @foreach (var pedido in Model.Detalles)
                {
                    <li
                        class="flex justify-between items-center px-3 py-2 bg-indigo-50 rounded-lg shadow-sm transition transform hover:scale-105">
                        <span class="flex items-center gap-2 text-sm font-medium">
                            <i class="fa-solid fa-pizza-slice text-yellow-500"></i> x@pedido.Cantidad
                        </span>
                        <span class="text-sm">@pedido.Producto.Nombre</span>
                        <span class="text-sm font-semibold text-green-700">S/ @pedido.PrecioTotal.ToString("0.00")</span>
                    </li>
                }
            </ul>
        </div>

        <div class="flex justify-between items-center text-lg font-bold text-gray-800 mb-4">
            <span>Total:</span>
            <span class="text-green-600">S/ @Model.Detalles.Sum(d => d.PrecioTotal).ToString("0.00")</span>
        </div>

        <div class="flex justify-between text-xs text-gray-500">
            <span>Método:</span>
            <span>@Model.Detalles.First().Pedido.TipoPedido</span>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
