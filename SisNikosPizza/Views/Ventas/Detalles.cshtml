@using SisNikosPizza.Utilidades
@model SisNikosPizza.Domain.ViewModels.VMDDetallesPedido

@{
    ViewData["Title"] = "Detalle de Ventas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <!-- DNS prefetch y preconnect -->
    <link rel="dns-prefetch" href="//cdn.tailwindcss.com" />
    <link rel="dns-prefetch" href="//cdnjs.cloudflare.com" />
    <link rel="dns-prefetch" href="//unpkg.com" />
    <link rel="preconnect" href="https://cdn.tailwindcss.com" crossorigin />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <link rel="preconnect" href="https://unpkg.com" crossorigin />

    <!-- CSS crítico inline primero -->
    <style>
        /* CSS crítico para evitar FOUC */
        .container {
            max-width: 1400px;
            padding: 4rem 1.5rem;
            margin: 0 auto;
        }

        .card {
            background: rgba(255, 255, 255, 0.9);
            border-radius: 2rem;
            padding: 2.5rem;
        }
    </style>

    <!-- Resto del CSS -->
    <style>
        .container {
            max-width: 1400px;
            padding: 4rem 1.5rem;
            margin: 0 auto;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #fef3c7, #fee2e2);
            color: #212121;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        .container {
            max-width: 1400px;
            padding: 4rem 1.5rem;
            margin: 0 auto;
        }

        .card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border-radius: 2rem;
            border: 2px solid #f1c40f;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.1);
            padding: 2.5rem;
            position: center;
            overflow: hidde;
            animation: float 4s ease-in-out infinite;
        }

        .card::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(241, 196, 15, 0.1) 0%, transparent 70%);
            animation: rotate 15s linear infinite;
            z-index: 0;
        }

        .card-content {
            position: relative;
            z-index: 1;
        }

        .fade-in {
            animation: fadeIn 1s ease-in-out;
        }


        .btn-return {
            background: linear-gradient(45deg, #f1c40f, #f39c12);
            color: #fff;
            border-radius: 50px;
            padding: 0.75rem 1.5rem;
            font-weight: 600;
            transition: all 0.3s ease-in-out;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            box-shadow: 0 5px 15px rgba(241, 196, 15, 0.3);
        }

        .btn-return:hover {
            transform: translateX(-5px) scale(1.05);
            box-shadow: 0 8px 20px rgba(241, 196, 15, 0.5);
            background: linear-gradient(45deg, #f39c12, #f1c40f);
        }

        .header-text {
            font-size: 2.5rem;
            font-weight: 700;
            color: #e67e22;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.1);
            letter-spacing: 2px;
        }

        .subtext {
            color: #7f8c8d;
            font-style: italic;
            font-size: 0.9rem;
        }

        .detail-row {
            background: #fff;
            border-radius: 15px;
            padding: 1rem;
            margin-bottom: 1rem;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
            transition: transform 0.3s ease;
        }

        .detail-row:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.1);
        }

        .order-item {
            background: linear-gradient(135deg, #fff3e0, #ffe082);
            border-radius: 10px;
            padding: 0.75rem;
            margin-bottom: 0.5rem;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .order-item:hover {
            transform: scale(1.02);
            box-shadow: 0 5px 15px rgba(241, 196, 15, 0.3);
        }

        .total {
            background: #fff;
            border-radius: 15px;
            padding: 1rem;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
            font-size: 1.2rem;
            color: #e74c3c;
        }

        .method {
            font-size: 0.9rem;
            color: #7f8c8d;
            text-align: right;
        }


}
</style>
}

<div class="flex flex-col items-center gap-10 py-10 bg-gradient-to-tr from-gray-100 to-gray-200 min-h-screen"
    role="main">
    <div class="container">
        <div
            class="w-full max-w-2xl bg-white rounded-3xl glow-border shadow-2xl p-8 fade-in relative transition-all duration-300 ease-in-out card">
            <div class="card-content">
                <div class="absolute top-4 left-4">
                    <a asp-action="Index" class="btn-return">
                        <i class="fa-solid fa-arrow-left"></i> Regresar
                    </a>
                </div>

                <div class="flex flex-col items-center text-center mb-6 space-y-2">
                    <span class="header-text">NIKOS PIZZA</span>
                    <span class="subtext">Detalle de venta</span>
                    <span class="text-xs text-gray-400">📅 @Model.FechaPedido.ToString("dd/MM/yyyy HH:mm")</span>
                </div>

                <div class="flex flex-col gap-2 mb-6">
                    <div class="detail-row flex justify-between text-sm font-medium text-gray-700">
                        <span>👤 Cliente:</span>
                        <span>@Model.Usuario.UserName</span>
                    </div>
                    @if (Model.Detalles.First().Pedido.Direccion != null)
                    {
                        <div class="detail-row flex justify-between text-sm font-medium text-gray-700">
                            <span>📍 Dirección:</span>
                            <span>@Model.Detalles.First().Pedido.Direccion</span>
                        </div>
                    }
                </div>

                <div class="border-t border-b border-gray-200 py-4 mb-6">
                    <h3 class="text-center text-lg font-semibold text-yellow-600 mb-3">🧾 Detalle del Pedido</h3>
                    <ul class="space-y-3">
                        @foreach (var pedido in Model.Detalles)
                        {
                            <li class="order-item flex justify-between items-center px-3 py-2">
                                <span class="flex items-center gap-2 text-sm font-medium">
                                    <i class="fa-solid fa-pizza-slice text-yellow-500"></i> @pedido.Cantidad
                                </span>
                                <span class="text-sm">@pedido.Producto.Nombre</span>
                                <span class="text-sm font-semibold text-green-700">S/ @pedido.PrecioTotal</span>
                            </li>
                        }
                    </ul>
                </div>

                <div class="total flex justify-between items-center mb-4">
                    <span>Total:</span>
                    <span class="text-yellow-600">S/ @Model.Detalles.Sum(d => d.PrecioTotal)</span>
                </div>

                <div class="method">
                    <span>Método:</span>
                    <span class="font-medium text-yellow-600">@Model.Detalles.First().Pedido.TipoPedido</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
