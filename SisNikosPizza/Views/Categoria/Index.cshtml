@model IEnumerable<SisNikosPizza.Domain.Models.Categoria>

@{
    ViewData["Title"] = "Lista de Categorías";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<style>
    .card {
        animation: slideIn 0.7s ease-out;
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .loading-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(255, 255, 255, 0.8);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 10;
    }

    .loading-spinner {
        border: 4px solid #f1c40f;
        border-top: 4px solid transparent;
        border-radius: 50%;
        width: 30px;
        height: 30px;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    .no-results {
        text-align: center;
        padding: 1.5rem;
        background: #fef0e7;
        color: #d32f2f;
        border-radius: 0.75rem;
        font-size: 1.1rem;
        font-weight: 500;
        margin-top: 1rem;
        display: none;
    }
</style>

<div class="container mx-auto py-8 px-4 sm:px-6 lg:px-8" role="main">
    <!-- Header -->
    <div class="mb-6">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-yellow-500 to-yellow-700 animate-pulse">
            Lista de Categorías
        </h1>
    </div>

    <!-- TempData Messages -->
    @if (TempData["Satisfactorio"] != null)
    {
        <div class="mb-6 p-4 bg-green-100 border-l-4 border-green-500 text-green-700 rounded-lg">
            <p>@TempData["Satisfactorio"]</p>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mb-6 p-4 bg-red-100 border-l-4 border-red-500 text-red-700 rounded-lg">
            <p>@TempData["Error"]</p>
        </div>
    }

    <!-- Back Button -->
    <div class="mb-6">
        <a href="javascript:history.back()" class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-yellow-500 to-yellow-600 text-white rounded-full hover:bg-gradient-to-r hover:from-yellow-600 hover:to-yellow-700 transition duration-300 ease-in-out transform hover:scale-105 shadow-md" aria-label="Regresar">
            <i class="bi bi-arrow-left-circle mr-2"></i> Regresar
        </a>
    </div>

    <!-- Card -->
    <div class="bg-white shadow-2xl rounded-2xl overflow-hidden border-2 border-yellow-400 card" aria-labelledby="card-header">
        <!-- Card Header -->
        <div class="bg-gradient-to-r from-yellow-500 to-yellow-700 text-white px-6 py-4 flex justify-between items-center relative">
            <h2 class="text-2xl font-semibold font-['Poppins']" id="card-header">Gestión de Categorías</h2>

            <a asp-controller="Categoria" asp-action="Create" class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-yellow-600 to-yellow-800 text-white rounded-full hover:bg-gradient-to-r hover:from-yellow-700 hover:to-yellow-900 transition duration-300 ease-in-out transform hover:scale-110 animate-pulse shadow-lg" aria-label="Crear nuevo insumo">
                <i class="bi bi-plus-circle mr-2"></i> Nueva Categoria
                <div class="absolute inset-0 bg-radial-gradient from-white/30 to-transparent opacity-40"></div>
            </a>

            
        </div>

        <!-- Card Body -->
        <div class="p-6 bg-yellow-50 relative">
            <div class="loading-overlay" id="loadingOverlay">
                <div class="loading-spinner"></div>
            </div>
            <!-- Filters -->
            <div class="mb-6 bg-white p-4 rounded-xl shadow-md flex flex-col sm:flex-row justify-between items-center gap-4">
                <div class="flex items-center gap-2">
                    <label for="entries" class="text-gray-700 font-medium">Mostrar</label>
                    <select id="entries" class="border border-gray-300 rounded-xl px-3 py-2 focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500" onchange="updateEntries()" aria-label="Seleccionar número de registros por página">
                        <option value="10" selected>10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                    <span class="text-gray-700">registros</span>
                </div>
                <div class="relative max-w-md w-full">
                    <div class="flex items-center">
                        <span class="bg-yellow-100 border border-yellow-400 border-r-0 rounded-l-xl px-3 py-2 text-yellow-600"><i class="bi bi-search"></i></span>
                        <input type="search" id="searchInput" class="w-full border border-yellow-400 border-l-0 rounded-r-xl px-3 py-2 focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500" placeholder="Buscar por ID, Nombre o Estado..." aria-label="Buscar categorías" />
                        <button id="clearSearch" class="absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-500 hover:text-yellow-500 hidden" aria-label="Limpiar búsqueda">
                            <i class="bi bi-x"></i>
                        </button>
                    </div>
                </div>
            </div>
            <!-- Table -->
            <div class="overflow-x-auto">
                <table class="w-full table-auto border border-yellow-200 rounded-xl shadow-md" id="categoryTable">
                    <thead class="bg-yellow-100 text-yellow-700">
                        <tr>
                            <th class="px-6 py-4 text-left text-sm font-semibold uppercase">ID</th>
                            <th class="px-6 py-4 text-left text-sm font-semibold uppercase">Nombre</th>
                            <th class="px-6 py-4 text-center text-sm font-semibold uppercase">Estado</th>
                            <th class="px-6 py-4 text-center text-sm font-semibold uppercase">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-yellow-200" id="categoryTableBody">
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var categoria in Model)
                            {
                                <tr class="bg-yellow-50 hover:bg-yellow-100 transition duration-300" data-id="@categoria.CategoriaId" data-nombre="@categoria.nombre.ToLower()" data-estado="@(categoria.Estado ? "activo" : "inactivo")">
                                    <td class="px-6 py-4 text-gray-800 font-medium">@categoria.CategoriaId</td>
                                    <td class="px-6 py-4 text-gray-800 font-medium">@categoria.nombre</td>
                                    <td class="px-6 py-4 text-center">
                                        @if (categoria.Estado)
                                        {
                                            <span class="inline-block px-3 py-1 bg-green-500 text-white text-sm font-medium rounded-full">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="inline-block px-3 py-1 bg-red-500 text-white text-sm font-medium rounded-full">Inactivo</span>
                                        }
                                    </td>
                                    <td class="px-6 py-4 text-center flex justify-center space-x-2">
                                        <a asp-action="Details" asp-route-id="@categoria.CategoriaId" class="inline-flex items-center px-3 py-1 bg-blue-500 text-white rounded-full hover:bg-blue-600 transition duration-300 transform hover:scale-105" aria-label="Ver detalles de @categoria.nombre">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@categoria.CategoriaId" class="inline-flex items-center px-3 py-1 bg-yellow-500 text-white rounded-full hover:bg-yellow-600 transition duration-300 transform hover:scale-105" aria-label="Editar @categoria.nombre">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@categoria.CategoriaId" class="inline-flex items-center px-3 py-1 bg-red-500 text-white rounded-full hover:bg-red-600 transition duration-300 transform hover:scale-105" aria-label="Eliminar @categoria.nombre">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="px-6 py-4 text-center text-gray-600">No hay categorías disponibles.</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="no-results" id="noResults">No se encontraron categorías que coincidan con la búsqueda.</div>
            </div>
            <!-- Pagination -->
            <div class="mt-6 flex justify-between items-center">
                <span id="tableInfo" class="text-gray-600"></span>
                <nav aria-label="Paginación de categorías">
                    <ul class="flex space-x-2" id="pagination"></ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- No Results Toast -->
<div class="fixed bottom-4 right-4 hidden bg-red-500 text-white px-6 py-3 rounded-lg shadow-lg transition-opacity duration-300" id="noResultsToast" role="alert" aria-live="polite">
    <i class="bi bi-exclamation-circle mr-2"></i> No se encontraron categorías que coincidan con la búsqueda.
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    let currentPage = 1;
    let rowsPerPage = 10;
    let allRows = [];
    let searchTimeout = null;

    document.addEventListener('DOMContentLoaded', () => {
        allRows = Array.from(document.querySelectorAll('#categoryTableBody tr'));
        updateTable();

        const searchInput = document.getElementById('searchInput');
        const clearSearch = document.getElementById('clearSearch');
        searchInput.addEventListener('input', () => {
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(filterTable, 300);
        });
        searchInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
                filterTable();
            }
        });

        clearSearch.addEventListener('click', () => {
            searchInput.value = '';
            clearSearch.classList.add('hidden');
            currentPage = 1;
            filterTable();
            searchInput.focus();
        });
    });

    function updateEntries() {
        rowsPerPage = parseInt(document.getElementById('entries').value);
        currentPage = 1;
        updateTable();
    }

    function filterTable() {
        const searchTerm = document.getElementById('searchInput').value.toLowerCase().trim();
        const noResults = document.getElementById('noResults');
        const noResultsToast = document.getElementById('noResultsToast');
        const loadingOverlay = document.getElementById('loadingOverlay');
        const clearSearch = document.getElementById('clearSearch');

        loadingOverlay.style.display = 'flex';

        const filteredRows = allRows.filter(row => {
            const id = row.getAttribute('data-id');
            const nombre = row.getAttribute('data-nombre');
            const estado = row.getAttribute('data-estado');
            return id.includes(searchTerm) ||
                (nombre && nombre.includes(searchTerm)) ||
                (estado && estado.includes(searchTerm));
        });

        currentPage = 1;
        updateTable(filteredRows);

        clearSearch.classList.toggle('hidden', !searchTerm);
        noResults.style.display = filteredRows.length === 0 && searchTerm ? 'block' : 'none';
        if (filteredRows.length === 0 && searchTerm) {
            noResultsToast.classList.remove('hidden');
            setTimeout(() => noResultsToast.classList.add('hidden'), 3000);
        }

        setTimeout(() => loadingOverlay.style.display = 'none', 300);
    }

    function updateTable(filteredRows = allRows) {
        const start = (currentPage - 1) * rowsPerPage;
        const end = start + rowsPerPage;
        const paginatedRows = filteredRows.slice(start, end);

        const tbody = document.getElementById('categoryTableBody');
        tbody.innerHTML = '';
        if (paginatedRows.length === 0 && !document.getElementById('searchInput').value) {
            tbody.innerHTML = '<tr><td colspan="4" class="px-6 py-4 text-center text-gray-600">No hay categorías disponibles.</td></tr>';
        } else {
            paginatedRows.forEach(row => tbody.appendChild(row));
        }

        const totalRows = filteredRows.length;
        document.getElementById('tableInfo').textContent = `Mostrando ${start + 1} al ${Math.min(end, totalRows)} de ${totalRows} registros`;

        updatePagination(totalRows);
    }

    function updatePagination(totalRows) {
        const totalPages = Math.ceil(totalRows / rowsPerPage);
        const pagination = document.getElementById('pagination');
        pagination.innerHTML = '';

        pagination.innerHTML += `
                <li class="${currentPage === 1 ? 'opacity-50 cursor-not-allowed' : ''}">
                    <a href="#" onclick="goToPage(1)" class="px-4 py-2 bg-yellow-500 text-white rounded-full hover:bg-yellow-600 transition duration-300 ${currentPage === 1 ? 'pointer-events-none' : ''}" aria-label="Primera página">Primero</a>
                </li>
                <li class="${currentPage === 1 ? 'opacity-50 cursor-not-allowed' : ''}">
                    <a href="#" onclick="goToPage(${currentPage - 1})" class="px-4 py-2 bg-yellow-500 text-white rounded-full hover:bg-yellow-600 transition duration-300 ${currentPage === 1 ? 'pointer-events-none' : ''}" aria-label="Página anterior">Anterior</a>
                </li>
            `;

        for (let i = 1; i <= totalPages; i++) {
            pagination.innerHTML += `
                    <li class="${i === currentPage ? 'bg-yellow-600' : ''}">
                        <a href="#" onclick="goToPage(${i})" class="px-4 py-2 ${i === currentPage ? 'bg-yellow-600 text-white' : 'bg-yellow-500 text-white'} rounded-full hover:bg-yellow-600 transition duration-300" aria-label="Página ${i}">${i}</a>
                    </li>
                `;
        }

        pagination.innerHTML += `
                <li class="${currentPage === totalPages || totalPages === 0 ? 'opacity-50 cursor-not-allowed' : ''}">
                    <a href="#" onclick="goToPage(${currentPage + 1})" class="px-4 py-2 bg-yellow-500 text-white rounded-full hover:bg-yellow-600 transition duration-300 ${currentPage === totalPages || totalPages === 0 ? 'pointer-events-none' : ''}" aria-label="Página siguiente">Siguiente</a>
                </li>
                <li class="${currentPage === totalPages || totalPages === 0 ? 'opacity-50 cursor-not-allowed' : ''}">
                    <a href="#" onclick="goToPage(${totalPages})" class="px-4 py-2 bg-yellow-500 text-white rounded-full hover:bg-yellow-600 transition duration-300 ${currentPage === totalPages || totalPages === 0 ? 'pointer-events-none' : ''}" aria-label="Última página">Último</a>
                </li>
            `;
    }

    function goToPage(page) {
        if (page >= 1 && page <= Math.ceil(allRows.length / rowsPerPage)) {
            currentPage = page;
            updateTable();
        }
    }
</script>