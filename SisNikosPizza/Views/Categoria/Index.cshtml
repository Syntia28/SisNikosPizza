@model IEnumerable<SisNikosPizza.Domain.Models.Categoria>

@{
    ViewData["Title"] = "Lista de Categorías";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">

<style>
    body {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        font-family: 'Inter', sans-serif;
        color: #2d2d2d;
        margin: 0;
        padding: 0;
    }

    .container {
        padding: 60px 20px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .card {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        transition: transform 0.3s ease;
    }

    .card:hover {
        transform: translateY(-5px);
    }

    .card-header {
        background: linear-gradient(45deg, #f1c40f, #f39c12);
        padding: 20px;
        color: #fff;
        border-radius: 20px 20px 0 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .card-header h2 {
        font-size: 2rem;
        font-weight: 700;
        margin: 0;
        text-transform: uppercase;
        letter-spacing: 1px;
        text-shadow: 1px 1px 5px rgba(0, 0, 0, 0.2);
    }

    .card-body {
        padding: 30px;
    }

    .table th, .table td {
        text-align: center;
        padding: 15px;
        font-size: 1rem;
        vertical-align: middle;
    }

    .table th {
        background: #f9f9f9;
        color: #333;
        font-weight: 600;
    }

    .table tbody tr {
        transition: background 0.3s ease;
    }

    .table tbody tr:hover {
        background: #fff9e6;
    }

    .form-select, .form-control {
        border: 2px solid #e0e0e0;
        border-radius: 10px;
        padding: 10px;
        font-size: 1rem;
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
        background: #f9f9f9;
    }

    .form-select:focus, .form-control:focus {
        border-color: #f1c40f;
        box-shadow: 0 0 8px rgba(241, 196, 15, 0.3);
        outline: none;
        background: #fff;
    }

    .input-group {
        position: relative;
    }

    .input-group-text {
        background: #f9f9f9;
        border: 2px solid #e0e0e0;
        border-right: none;
        border-radius: 10px 0 0 10px;
        padding: 10px;
    }

    .input-group .form-control {
        border-left: none;
        border-radius: 0 10px 10px 0;
        padding-right: 40px;
    }

    .clear-search {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: #6c757d;
        font-size: 1.2rem;
        cursor: pointer;
        display: none;
    }

    .clear-search:hover {
        color: #f1c40f;
    }

    .btn {
        padding: 8px 16px;
        border-radius: 50px;
        font-weight: 600;
        font-size: 0.9rem;
        transition: transform 0.2s ease, background 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-success {
        background: linear-gradient(45deg, #2ecc71, #27ae60);
        border: none;
        color: #fff;
    }

    .btn-success:hover {
        background: linear-gradient(45deg, #27ae60, #2ecc71);
        transform: scale(1.05);
    }

    .btn-primary {
        background: linear-gradient(45deg, #3498db, #2980b9);
        border: none;
        color: #fff;
    }

    .btn-primary:hover {
        background: linear-gradient(45deg, #2980b9, #3498db);
        transform: scale(1.05);
    }

    .btn-info {
        background: linear-gradient(45deg, #17a2b8, #138496);
        border: none;
        color: #fff;
    }

    .btn-info:hover {
        background: linear-gradient(45deg, #138496, #17a2b8);
        transform: scale(1.05);
    }

    .btn-danger {
        background: linear-gradient(45deg, #e63946, #d00000);
        border: none;
        color: #fff;
    }

    .btn-danger:hover {
        background: linear-gradient(45deg, #d00000, #e63946);
        transform: scale(1.05);
    }

    .badge {
        padding: 6px 12px;
        font-size: 0.875rem;
        border-radius: 20px;
        font-weight: 600;
    }

    .badge.bg-success {
        background: #2ecc71;
    }

    .badge.bg-danger {
        background: #e63946;
    }

    .pagination .page-item .page-link {
        background: linear-gradient(45deg, #f1c40f, #f39c12);
        color: #fff;
        border: none;
        border-radius: 50px;
        padding: 8px 16px;
        margin: 0 5px;
        transition: background 0.3s ease;
    }

    .pagination .page-item.active .page-link {
        background: linear-gradient(45deg, #f39c12, #f1c40f);
    }

    .pagination .page-item.disabled .page-link {
        background: #e0e0e0;
        color: #6c757d;
        cursor: not-allowed;
    }

    .toast {
        position: fixed;
        bottom: 20px;
        right: 20px;
        background: #e63946;
        color: #fff;
        padding: 15px 20px;
        border-radius: 10px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.3s ease, transform 0.3s ease;
        z-index: 1000;
    }

    .toast.show {
        opacity: 1;
        transform: translateY(0);
    }

    .loading-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(255, 255, 255, 0.8);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 10;
    }

    .loading-spinner {
        border: 4px solid #f1c40f;
        border-top: 4px solid transparent;
        border-radius: 50%;
        width: 30px;
        height: 30px;
        animation: spin 1s linear infinite;
    }

   
</style>

<div class="container" role="main">
    <div class="card" aria-labelledby="card-header">
        <div class="card-header">
            <h2 id="card-header">Lista de Categorías</h2>
            <a class="btn btn-success" asp-controller="Categoria" asp-action="Create" aria-label="Crear nueva categoría">
                <i class="bi bi-file-earmark-plus"></i> Nueva Categoría
            </a>
        </div>
        <div class="card-body position-relative">
            <div class="loading-overlay" id="loadingOverlay">
                <div class="loading-spinner"></div>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="d-flex align-items-center gap-2">
                    <label for="entries" class="form-label mb-0">Mostrar</label>
                    <select id="entries" class="form-select" style="width: auto;" aria-label="Seleccionar número de registros por página">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                    <span>registros por página</span>
                </div>
                <div class="input-group" style="max-width: 300px;">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="search" id="searchInput" class="form-control" placeholder="Buscar por ID, nombre o estado" aria-label="Buscar categorías" />
                    <button class="clear-search" id="clearSearch" aria-label="Limpiar búsqueda"><i class="bi bi-x"></i></button>
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-bordered table-striped align-middle" id="categoryTable">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Estado</th>
                            <th>Opciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var categoria in Model)
                        {
                            <tr>
                                <td>@categoria.CategoriaId</td>
                                <td>@categoria.nombre</td>
                                <td>
                                    @if (categoria.Estado)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactivo</span>
                                    }
                                </td>
                                <td>
                                    <a class="btn btn-primary btn-sm me-1" asp-controller="Categoria" asp-action="Edit" asp-route-id="@categoria.CategoriaId" aria-label="Editar categoría @categoria.nombre">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a class="btn btn-info btn-sm me-1" asp-controller="Categoria" asp-action="Details" asp-route-id="@categoria.CategoriaId" aria-label="Ver detalles de categoría @categoria.nombre">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a class="btn btn-danger btn-sm" asp-controller="Categoria" asp-action="Delete" asp-route-id="@categoria.CategoriaId" aria-label="Eliminar categoría @categoria.nombre">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center mt-4">
                <span id="tableInfo" class="text-muted"></span>
                <nav aria-label="Paginación de categorías">
                    <ul class="pagination mb-0">
                        <li class="page-item" id="firstPage"><a class="page-link" href="#">Primero</a></li>
                        <li class="page-item" id="prevPage"><a class="page-link" href="#">Anterior</a></li>
                        <li class="page-item active"><a class="page-link" href="#">1</a></li>
                        <li class="page-item" id="nextPage"><a class="page-link" href="#">Siguiente</a></li>
                        <li class="page-item" id="lastPage"><a class="page-link" href="#">Último</a></li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<div class="toast" id="noResultsToast" role="alert" aria-live="polite">
    No se encontraron categorías que coincidan con la búsqueda.
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const searchInput = document.getElementById('searchInput');
        const clearSearch = document.getElementById('clearSearch');
        const table = document.getElementById('categoryTable');
        const rows = table.querySelectorAll('tbody tr');
        const entriesSelect = document.getElementById('entries');
        const tableInfo = document.getElementById('tableInfo');
        const firstPage = document.getElementById('firstPage');
        const prevPage = document.getElementById('prevPage');
        const nextPage = document.getElementById('nextPage');
        const lastPage = document.getElementById('lastPage');
        const toast = document.getElementById('noResultsToast');
        const loadingOverlay = document.getElementById('loadingOverlay');
        let currentPage = 1;
        let rowsPerPage = parseInt(entriesSelect.value);
        let debounceTimeout;

        function updateTable() {
            loadingOverlay.style.display = 'flex';
            const searchTerm = searchInput.value.toLowerCase().trim();
            let visibleRows = 0;
            let filteredRows = [];

            rows.forEach(row => {
                const id = row.cells[0].textContent.toLowerCase();
                const name = row.cells[1].textContent.toLowerCase();
                const status = row.cells[2].textContent.toLowerCase();
                if (id.includes(searchTerm) || name.includes(searchTerm) || status.includes(searchTerm)) {
                    filteredRows.push(row);
                    visibleRows++;
                }
            });

            const totalPages = Math.ceil(filteredRows.length / rowsPerPage);
            const startIndex = (currentPage - 1) * rowsPerPage;
            const endIndex = startIndex + rowsPerPage;

            rows.forEach(row => row.style.display = 'none');
            filteredRows.slice(startIndex, endIndex).forEach(row => row.style.display = '');

            tableInfo.textContent = `Pág. ${currentPage} de ${totalPages || 1} - Mostrando del ${startIndex + 1} al ${Math.min(endIndex, filteredRows.length)} de ${filteredRows.length} registros`;

            firstPage.classList.toggle('disabled', currentPage === 1);
            prevPage.classList.toggle('disabled', currentPage === 1);
            nextPage.classList.toggle('disabled', currentPage === totalPages || totalPages === 0);
            lastPage.classList.toggle('disabled', currentPage === totalPages || totalPages === 0);

            clearSearch.style.display = searchTerm ? 'block' : 'none';

            if (visibleRows === 0) {
                toast.classList.add('show');
                setTimeout(() => toast.classList.remove('show'), 3000);
            }

            setTimeout(() => loadingOverlay.style.display = 'none', 300);
        }

        function debounceSearch() {
            clearTimeout(debounceTimeout);
            debounceTimeout = setTimeout(updateTable, 300);
        }

        searchInput.addEventListener('input', debounceSearch);

        clearSearch.addEventListener('click', () => {
            searchInput.value = '';
            clearSearch.style.display = 'none';
            currentPage = 1;
            updateTable();
            searchInput.focus();
        });

        entriesSelect.addEventListener('change', () => {
            rowsPerPage = parseInt(entriesSelect.value);
            currentPage = 1;
            updateTable();
        });

        firstPage.addEventListener('click', (e) => {
            e.preventDefault();
            if (currentPage !== 1) {
                currentPage = 1;
                updateTable();
            }
        });

        prevPage.addEventListener('click', (e) => {
            e.preventDefault();
            if (currentPage > 1) {
                currentPage--;
                updateTable();
            }
        });

        nextPage.addEventListener('click', (e) => {
            e.preventDefault();
            const totalPages = Math.ceil(rows.length / rowsPerPage);
            if (currentPage < totalPages) {
                currentPage++;
                updateTable();
            }
        });

        lastPage.addEventListener('click', (e) => {
            e.preventDefault();
            const totalPages = Math.ceil(rows.length / rowsPerPage);
            if (currentPage !== totalPages) {
                currentPage = totalPages;
                updateTable();
            }
        });

        updateTable();
    });
</script>