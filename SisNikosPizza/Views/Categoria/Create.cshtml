@model SisNikosPizza.Domain.Models.Categoria

@{
    ViewData["Title"] = "Crear Categoría";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white text-center">
                    <h3 class="mb-0">Nueva Categoría</h3>
                </div>
                <div class="card-body">
                    <form method="post" asp-controller="Categoria" asp-action="Create">
                        <div class="mb-3">
                            <label for="Nombre" class="form-label">Nombre</label>
                            <input type="text" asp-for="nombre" class="form-control" placeholder="Nombre de la Categoría" />
                            <span asp-validation-for="nombre" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label for="Estado" class="form-label">Estado</label>
                            <select asp-for="Estado" class="form-select">
                                <option value="true">ACTIVO</option>
                                <option value="false">INACTIVO</option>
                            </select>
                            <span asp-validation-for="Estado" class="text-danger"></span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-save"></i> Guardar
                            </button>
                            <a asp-controller="Categoria" asp-action="Index" class="btn btn-primary">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>
