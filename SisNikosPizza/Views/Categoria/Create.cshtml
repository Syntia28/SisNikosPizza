@model SisNikosPizza.Domain.Models.Categoria

@{
    ViewData["Title"] = "Crear Categoría";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        font-family: 'Inter', sans-serif;
        color: #2d2d2d;
        margin: 0;
        padding: 0;
    }

    .container {
        padding: 60px 20px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .form-card {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        position: relative;
        transition: transform 0.3s ease;
        max-width: 600px;
        margin: 0 auto;
    }

        .form-card:hover {
            transform: translateY(-5px);
        }

    .form-header {
        background: linear-gradient(45deg, #f1c40f, #f39c12);
        padding: 20px;
        text-align: center;
        color: #fff;
        border-radius: 20px 20px 0 0;
    }

        .form-header h3 {
            font-size: 2rem;
            font-weight: 700;
            margin: 0;
            text-transform: uppercase;
            letter-spacing: 1px;
            text-shadow: 1px 1px 5px rgba(0, 0, 0, 0.2);
        }

    .form-body {
        padding: 30px;
    }

    .form-label {
        font-size: 1.1rem;
        font-weight: 600;
        color: #333;
        margin-bottom: 8px;
        display: block;
    }

    .form-control,
    .form-select {
        border: 2px solid #e0e0e0;
        border-radius: 10px;
        padding: 12px;
        font-size: 1rem;
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
        width: 100%;
        background: #f9f9f9;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #f1c40f;
            box-shadow: 0 0 8px rgba(241, 196, 15, 0.3);
            outline: none;
            background: #fff;
        }

        .form-control::placeholder {
            color: #aaa;
            font-style: italic;
        }

    .text-danger {
        font-size: 0.9rem;
        color: #e63946;
        margin-top: 5px;
        display: block;
    }

    .btn {
        padding: 12px 24px;
        border-radius: 50px;
        font-weight: 600;
        font-size: 1rem;
        transition: transform 0.2s ease, background 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-success {
        background: linear-gradient(45deg, #2ecc71, #27ae60);
        border: none;
        color: #fff;
    }

        .btn-success:hover {
            background: linear-gradient(45deg, #27ae60, #2ecc71);
            transform: scale(1.05);
        }

    .btn-primary {
        background: linear-gradient(45deg, #3498db, #2980b9);
        border: none;
        color: #fff;
    }

        .btn-primary:hover {
            background: linear-gradient(45deg, #2980b9, #3498db);
            transform: scale(1.05);
        }

    .btn:focus {
        outline: none;
        box-shadow: 0 0 0 3px rgba(241, 196, 15, 0.3);
    }
</style>

<div class="container" role="main">
    <!-- Mensajes de éxito o error -->
    @if (TempData["Satisfactorio"] != null)
    {
        <div class="z-1000 mb-6 p-4 bg-green-100 border-l-4 border-green-500 text-green-700 rounded-lg">
            <p>@TempData["Satisfactorio"]</p>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="z-1000 mb-6 p-4 bg-red-100 border-l-4 border-red-500 text-red-700 rounded-lg">
            <p>@TempData["Error"]</p>
        </div>
    }

    <div class="form-card" aria-labelledby="form-header">
        <div class="form-header">
            <h3 id="form-header">Nueva Categoría</h3>
        </div>
        <div class="mb-6">
            <a href="javascript:history.back()"
               class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-yellow-500 to-yellow-600 text-white rounded-full hover:bg-gradient-to-r hover:from-yellow-600 hover:to-yellow-700 transition duration-300 ease-in-out transform hover:scale-105 shadow-md">
                <i class="bi bi-arrow-left-circle mr-2"></i> Regresar
            </a>
        </div>

        <div class="form-body">
            <form method="post" asp-controller="Categoria" asp-action="Create" id="category-form">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="Nombre" class="form-label">Nombre</label>
                    <input type="text" asp-for="nombre" class="form-control" id="Nombre"
                           placeholder="Ej. Pizzas Clásicas" aria-describedby="nombre-error" />
                    <span asp-validation-for="nombre" class="text-danger" id="nombre-error"></span>
                </div>

                <div class="mb-3">
                    <label for="Estado" class="form-label">Estado</label>
                    <select asp-for="Estado" class="form-select" id="Estado" aria-describedby="estado-error">
                        <option value="true">ACTIVO</option>
                        <option value="false">INACTIVO</option>
                    </select>
                    <span asp-validation-for="Estado" class="text-danger" id="estado-error"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <button type="submit" class="btn btn-success" aria-label="Guardar categoría">
                        <i class="bi bi-save"></i> Guardar
                    </button>
                    <a asp-controller="Categoria" asp-action="Index" class="btn btn-primary" aria-label="Cancelar y volver">
                        <i class="bi bi-arrow-left"></i> Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
