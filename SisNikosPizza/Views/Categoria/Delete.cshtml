@model SisNikosPizza.Domain.Models.Categoria
@{
    ViewData["Title"] = "Eliminar Categoría";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<section class="content container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <form method="post" asp-controller="Categoria" asp-action="Delete">
                <div class="card card-default">
                    <div class="card-header">
                        <span class="card-title"><h2>Eliminar Categoría</h2></span>
                    </div>
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input asp-for="CategoriaId" hidden />
                        <div class="form-group row mb-2">
                            <div class="col-12 col-md-2 col-form-label text-md-end">
                                <label>Nombre</label>
                            </div>
                            <div class="col-12 col-md-9">
                                <input type="text" asp-for="nombre" class="form-control" placeholder="Nombre de la Categoría" disabled />
                                <span asp-validation-for="nombre" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="form-group row mb-2">
                            <div class="col-12 col-md-2 col-form-label text-md-end">
                                <label>Estado</label>
                            </div>
                            <div class="col-12 col-md-9">
                                <select asp-for="Estado" class="form-select" disabled>
                                    <option value="true">ACTIVO</option>
                                    <option value="false">INACTIVO</option>
                                </select>
                                <span asp-validation-for="Estado" class="text-danger"></span>
                            </div>
                        </div>
                        <div>
                            <button type="submit" class="btn btn-danger">Eliminar</button>
                            <a asp-controller="Categoria" asp-action="Index" class="btn btn-primary">Cancelar</a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>