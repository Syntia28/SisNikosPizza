@model SisNikosPizza.Domain.Models.Categoria

@{
    ViewData["Title"] = "Editar Categoría";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        font-family: 'Inter', sans-serif;
        color: #2d2d2d;
        margin: 0;
        padding: 0;
    }

    .container {
        padding: 60px 20px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .form-card {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        position: relative;

        transition: transform .form-card:hover {
            transform: translateY(-5px);
        }

        .form-header {
            background: linear-gradient(45deg, #f1c40f, #f39c12);
            padding: 20px;
            text-align: center;
            color: #fff;
            border-radius: 20px 20px 0 0;
        }

        .form-header h3 {
            font-size: 2rem;
            font-weight: 700;
            margin: 0;
            text-transform: uppercase;
            letter-spacing: 1px;
            text-shadow: 1px 1px 5px rgba(0, 0, 0, 0.2);
        }

        .form-body {
            padding: 30px;
        }

        .form-label {
            font-size: 1.1rem;
            font-weight: 600;
            color: #333;
            margin-bottom: 8px;
            display: block;
        }

        .form-control,
        .form-select {
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            padding: 12px;
            font-size: 1rem;
            transition: border-color 0.3s ease, box-shadow 0.3s ease;
            width: 100%;
            background: #f9f9f9;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: #f1c40f;
            box-shadow: 0 0 8px rgba(241, 196, 15, 0.3);
            outline: none;
            background: #fff;
        }

        .form-control::placeholder {
            color: #aaa;
            font-style: italic;
        }

        .text-danger {
            font-size: 0.9rem;
            color: #e63946;
            margin-top: 5px;
            display: block;
        }

        .btn {
            padding: 12px 24px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 1rem;
            transition: transform 0.2s ease, background 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-success {
            background: linear-gradient(45deg, #2ecc71, #27ae60);
            border: none;
            color: #fff;
        }

        .btn-success:hover {
            background: linear-gradient(45deg, #27ae60, #2ecc71);
            transform: scale(1.05);
        }

        .btn-secondary {
            background: linear-gradient(45deg, #6c757d, #5a6268);
            border: none;
            color: #fff;
        }

        .btn-secondary:hover {
            background: linear-gradient(45deg, #5a6268, #6c757d);
            transform: scale(1.05);
        }

        .btn:focus {
            outline: none;
            box-shadow: 0 0 0 3px rgba(241, 196, 15, 0.3);
        }

        .toast {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: #2ecc71;
            color: #fff;
            padding: 15px 20px;
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
            opacity: 0;
            transform: translateY(20px);
            transition: opacity 0.3s ease, transform 0.3s ease;
            z-index: 1000;
        }

        .toast.show {
            opacity: 1;
            transform: translateY(0);
        }
</style>

<div class="container" role="main">
    <div class="form-card" aria-labelledby="form-header">
        <div class="form-header">
            <h3 id="form-header">Editar Categoría</h3>
        </div>
        <div class="form-body">
            <form method="post" asp-controller="Categoria" asp-action="Edit" id="edit-form">
                <input type="hidden" asp-for="CategoriaId" />
                <div class="mb-3">
                    <label for="Nombre" class="form-label">Nombre <span class="text-danger">*</span></label>
                    <input type="text" asp-for="nombre" class="form-control" id="Nombre"
                        placeholder="Ej. Pizzas Clásicas" aria-describedby="nombre-error" />
                    <span asp-validation-for="nombre" class="text-danger" id="nombre-error"></span>
                </div>
                <div class="mb-3">
                    <label for="Estado" class="form-label">Estado</label>
                    <select asp-for="Estado" class="form-select" id="Estado" aria-describedby="estado-error">
                        <option value="true">ACTIVO</option>
                        <option value="false">INACTIVO</option>
                    </select>
                    <span asp-validation-for="Estado" class="text-danger" id="estado-error"></span>
                </div>
                <div class="d-flex justify-content-end gap-3 mt-4">
                    <button type="submit" class="btn btn-success" aria-label="Guardar cambios">
                        <i class="bi bi-save"></i> Guardar
                    </button>
                    <a asp-action="Index" class="btn btn-secondary" aria-label="Cancelar y volver">
                        <i class="bi bi-arrow-left"></i> Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="toast" id="success-toast" role="alert" aria-live="polite">
    ¡Categoría actualizada exitosamente!
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('edit-form');
            const toast = document.getElementById('success-toast');

            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const formData = new FormData(form);

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: formData
                    });

                    if (response.ok) {
                        toast.classList.add('show');
                        setTimeout(() => {
                            toast.classList.remove('show');
                            window.location.href = '@Url.Action("Index", "Categoria")';
                        }, 2000);
                    } else {
                        const errors = await response.json();
                        console.error('Validation errors:', errors);
                    }
                } catch (error) {
                    console.error('Error:', error);
                }
            });
        });
    </script>
}