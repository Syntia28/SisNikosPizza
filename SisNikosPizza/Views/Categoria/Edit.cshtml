@model SisNikosPizza.Domain.Models.Categoria

@{
    ViewData["Title"] = "Editar Categoria";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card border border-secondary">
                <div class="card-header bg-warning text-dark text-center">
                    <h3 class="mb-0">Editar Proveedor</h3>
                </div>
                <div class="card-body">
                    <form method="post" asp-controller="Categoria" asp-action="Edit">
                        <input type="hidden" asp-for="CategoriaId" />

                        <!-- Campo Nombre -->
                        <div class="mb-3">
                            <label for="Nombre" class="form-label">Nombre <span class="text-danger">*</span></label>
                            <input type="text" asp-for="nombre" class="form-control" placeholder="Nombre de la Categoria" />
                            <span asp-validation-for="nombre" class="text-danger"></span>
                        </div>

                       <div class="mb-3">
                            <label for="Estado" class="form-label">Estado</label>
                            <select asp-for="Estado" class="form-select">
                                <option value="true">ACTIVO</option>
                                <option value="false">INACTIVO</option>
                            </select>
                            <span asp-validation-for="Estado" class="text-danger"></span>
                        </div>
                        <!-- Botones Guardar y Cancelar -->
                        <div class="d-flex justify-content-end gap-3">
                            <button type="submit" class="btn btn-success px-4">Guardar</button>
                            <a asp-action="Index" class="btn btn-secondary px-4">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
        <partial name="_ValidationScriptsPartial" />
}
