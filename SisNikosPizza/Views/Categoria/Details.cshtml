@model  SisNikosPizza.Domain.Models.Categoria
@{
    ViewData["Title"] = "Detalle Categoría";
    Layout = "~/Views/Shared/_Admin.cshtml";
    // Layout = "~/Views/Shared/_Layout.cshtml";
    // Layout = null;
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-10 col-md-8">
            <div class="card border border-secondary">
                <div class="card-header bg-secondary bg-opacity-75 text-center">
                    <h2>Detalle de Categoría</h2>
                </div>
                <div class="card-body">
                    <div class="row p-2 border-bottom">
                        <div class="col-4 text-end"><strong>Categoría ID:</strong></div>
                        <div class="col">@Model.CategoriaId</div>
                    </div>
                    <div class="row p-2 border-bottom">
                        <div class="col-4 text-end"><strong>Nombre:</strong></div>
                        <div class="col">@Model.nombre</div>
                    </div>

                    <div class="row p-2 border-bottom">
                        <div class="col-4 text-end"><strong>Estado:</strong></div>
                        <div class="col">
                            @if (Model.Estado)
                            {
                                <span class="text-success">ACTIVO</span>
                            }
                            else
                            {
                                <span class="text-info">INACTIVO</span>
                            }
                        </div>
                    </div>
                    <div class="row p-2 border-bottom">
                        <div class="col-4 text-end"><strong>Creado el:</strong></div>
                        <div class="col">@Model.CreatedAt</div>
                    </div>
                    <div class="row p-2 border-bottom">
                        <div class="col-4 text-end"><strong>Actualizado el:</strong></div>
                        <div class="col">@Model.UpdatedAt</div>
                    </div>
                    <div class="d-grid column-gap-2 d-md-block offset-0 offset-md-3 offset-lg-4 mt-2">
                        <a asp-action="Edit" asp-route-id="@Model.CategoriaId" class="btn btn-warning mb-1 mb-md-0">
                            <i class="bi bi-pencil-square"></i>&nbspEditar
                        </a>
                        <a asp-action="Index" class="btn btn-primary">
                            <i class="bi bi-arrow-return-left"></i>&nbsp; Regresar
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

