@model SisNikosPizza.Domain.Models.Categoria
@{
    ViewData["Title"] = "Detalle Categoría";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<style>
    body {
        background: linear-gradient(135deg, #fef3c7, #fee2e2);
        font-family: 'Poppins', sans-serif;
        overflow-x: hidden;
    }

    .card {
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.2));
        backdrop-filter: blur(12px);
        border-radius: 2rem;
        border: 1px solid rgba(255, 255, 255, 0.3);
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
        transition: transform 0.4s ease, box-shadow 0.4s ease;
        max-width: 600px;
        margin: 0 auto;
    }

        .card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
        }

    .detail-row {
        display: flex;
        align-items: center;
        padding: 1rem 0;
        border-bottom: 1px solid #e0e0e0;
        font-size: 1.1rem;
        position: relative;
    }

    .detail-label {
        flex: 0 0 40%;
        font-weight: 600;
        color: #333;
        text-align: right;
        padding-right: 1.5rem;
    }

    .detail-value {
        flex: 1;
        color: #555;
    }

    .input-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: #eab308;
        font-size: 1.5rem;
    }

    .status-active {
        color: #2ecc71;
        font-weight: 600;
    }

    .status-inactive {
        color: #eab308; /* Changed from #3498db (blue) to #eab308 (yellow) */
        font-weight: 600;
    }

    .btn {
        position: relative;
        overflow: hidden;
        padding: 0.875rem 2rem;
        border-radius: 50px;
        font-weight: 600;
        font-size: 1.1rem;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-warning {
        background: linear-gradient(45deg, #f1c40f, #f39c12); /* Kept as yellow tones from original */
        border: none;
        color: #fff;
    }

        .btn-warning:hover {
            background: linear-gradient(45deg, #f39c12, #f1c40f);
            transform: scale(1.05);
            box-shadow: 0 5px 20px rgba(241, 196, 15, 0.6);
        }

        .btn-warning::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            background: rgba(255, 255, 255, 0.4);
            border-radius: 50%;
            transform: translate(-50%, -50%);
            transition: width 0.4s ease, height 0.4s ease;
        }

        .btn-warning:hover::after {
            width: 250px;
            height: 250px;
        }

    .btn-primary {
        background: linear-gradient(45deg, #f1c40f, #f39c12); /* Changed from #3498db, #2980b9 (blue) to yellow */
        border: none;
        color: #fff;
    }

        .btn-primary:hover {
            background: linear-gradient(45deg, #f39c12, #f1c40f);
            transform: scale(1.05);
            box-shadow: 0 5px 20px rgba(241, 196, 15, 0.6);
        }

        .btn-primary::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            background: rgba(255, 255, 255, 0.4);
            border-radius: 50%;
            transform: translate(-50%, -50%);
            transition: width 0.4s ease, height 0.4s ease;
        }

        .btn-primary:hover::after {
            width: 250px;
            height: 250px;
        }

    .btn:focus {
        outline: none;
        box-shadow: 0 0 0 3px rgba(241, 196, 15, 0.3);
    }

    .button-group {
        display: flex;
        justify-content: center;
        gap: 15px;
        margin-top: 20px;
    }

    .header-underline {
        width: 100px;
        height: 4px;
        background: linear-gradient(90deg, #f1c40f, #f39c12);
        margin: 0 auto;
        border-radius: 2px;
    }
</style>

<div class="container" role="main">
    <div class="card animate__animated animate__fadeInUp" aria-labelledby="card-header">
        <div class="card-header">
            <h3 id="card-header">Detalle de la Categoría</h3>
            <div class="header-underline mt-3"></div>
        </div>
        <div class="card-body">
            <div class="detail-row">
                <div class="detail-label">Categoría ID:</div>
                <div class="detail-value">@Model.CategoriaId</div>
                <i class="bi bi-hash input-icon"></i>
            </div>
            <div class="detail-row">
                <div class="detail-label">Nombre:</div>
                <div class="detail-value">@Model.nombre</div>
                <i class="bi bi-tag-fill input-icon"></i>
            </div>
            <div class="detail-row">
                <div class="detail-label">Estado:</div>
                <div class="detail-value">
                    @if (Model.Estado)
                    {
                        <span class="status-active">ACTIVO</span>
                    }
                    else
                    {
                        <span class="status-inactive">INACTIVO</span>
                    }
                </div>
                <i class="bi bi-toggle-on input-icon"></i>
            </div>
            <div class="detail-row">
                <div class="detail-label">Creado el:</div>
                <div class="detail-value">@Model.CreatedAt</div>
                <i class="bi bi-calendar-plus input-icon"></i>
            </div>
            <div class="detail-row">
                <div class="detail-label">Actualizado el:</div>
                <div class="detail-value">@Model.UpdatedAt</div>
                <i class="bi bi-calendar-check input-icon"></i>
            </div>
            <div class="button-group">
                <a asp-action="Edit" asp-route-id="@Model.CategoriaId" class="btn btn-warning" aria-label="Editar categoría">
                    <i class="bi bi-pencil-square"></i> Editar
                </a>
                <a asp-action="Index" class="btn btn-primary" aria-label="Regresar a la lista">
                    <i class="bi bi-arrow-return-left"></i> Regresar
                </a>
            </div>
        </div>
    </div>
</div>