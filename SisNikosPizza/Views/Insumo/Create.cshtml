@model SisNikosPizza.Domain.Models.Insumo

@{
    ViewData["Title"] = "Crear Insumo";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<div class="container mx-auto py-8 px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-6">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-yellow-500 to-yellow-700 animate-pulse">
            Crear Nuevo Insumo
        </h1>
    </div>

    <!-- Back Button -->
    <div class="mb-6">
        <a href="@Url.Action("Index", "Insumo")" class="inline-flex items-center px-4 py-2 bg-gradient-to-r from-yellow-500 to-yellow-600 text-white rounded-full hover:bg-gradient-to-r hover:from-yellow-600 hover:to-yellow-700 transition duration-300 ease-in-out transform hover:scale-105 shadow-md">
            <i class="bi bi-arrow-left-circle mr-2"></i> Regresar a la Lista
        </a>
    </div>

    <!-- TempData Messages -->
    @if (TempData["Satisfactorio"] != null)
    {
        <div class="mb-6 p-4 bg-green-100 border-l-4 border-green-500 text-green-700 rounded-lg">
            <p>@TempData["Satisfactorio"]</p>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mb-6 p-4 bg-red-100 border-l-4 border-red-500 text-red-700 rounded-lg">
            <p>@TempData["Error"]</p>
        </div>
    }

    <!-- Card -->
    <div class="bg-white shadow-2xl rounded-2xl overflow-hidden">
        <!-- Card Header -->
        <div class="bg-gradient-to-r from-yellow-500 to-yellow-700 text-white px-6 py-4">
            <h2 class="text-2xl font-semibold">Formulario de Insumo</h2>
        </div>
        <!-- Card Body -->
        <div class="p-6 bg-gray-50">
            <form asp-action="Create" method="post" id="create-insumo-form">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Nombre -->
                    <div>
                        <label asp-for="Nombre" class="block text-sm font-medium text-gray-700">Nombre <span class="text-red-500">*</span></label>
                        <input asp-for="Nombre" class="mt-1 w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500" placeholder="Ej. Queso Mozzarella" />
                        <span asp-validation-for="Nombre" class="text-red-500 text-sm"></span>
                    </div>
                    <!-- Precio -->
                    <div>
                        <label asp-for="Precio" class="block text-sm font-medium text-gray-700">Precio (S/.) <span class="text-red-500">*</span></label>
                        <input asp-for="Precio" type="number" step="0.01" class="mt-1 w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500" placeholder="Ej. 15.50" />
                        <span asp-validation-for="Precio" class="text-red-500 text-sm"></span>
                    </div>
                    <!-- Unidad de Medida -->
                    <div>
                        <label asp-for="UnidadeDeMedida" class="block text-sm font-medium text-gray-700">Unidad de Medida <span class="text-red-500">*</span></label>
                        <select asp-for="UnidadeDeMedida" class="mt-1 w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500">
                            <option value="">Seleccione una unidad</option>
                            <option value="Kilogramos">Kilogramos</option>
                            <option value="Litros">Litros</option>
                            <option value="Unidades">Unidades</option>
                            <option value="Gramos">Gramos</option>
                            <option value="Mililitros">Mililitros</option>
                        </select>
                        <span asp-validation-for="UnidadeDeMedida" class="text-red-500 text-sm"></span>
                    </div>
                    <!-- Cantidad -->
                    <div>
                        <label asp-for="Cantidad" class="block text-sm font-medium text-gray-700">Cantidad <span class="text-red-500">*</span></label>
                        <input asp-for="Cantidad" type="number" step="0.01" class="mt-1 w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500" placeholder="Ej. 10.00" />
                        <span asp-validation-for="Cantidad" class="text-red-500 text-sm"></span>
                    </div>
                    <!-- Proveedor (Campo nuevo) -->
                    <div>
                        <label asp-for="ProveedorId" class="block text-sm font-medium text-gray-700">Proveedor <span class="text-red-500">*</span></label>
                        <select asp-for="ProveedorId" asp-items="ViewBag.Proveedores" class="mt-1 w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500">
                            <option value="">-- Seleccione un proveedor --</option>
                        </select>
                        <span asp-validation-for="ProveedorId" class="text-red-500 text-sm"></span>
                    </div>
                    <!-- Descripción -->
                    <div class="md:col-span-2">
                        <label asp-for="Descripcion" class="block text-sm font-medium text-gray-700">Descripción <span class="text-red-500">*</span></label>
                        <textarea asp-for="Descripcion" rows="4" class="mt-1 w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500" placeholder="Ej. Queso mozzarella de alta calidad para pizzas"></textarea>
                        <span asp-validation-for="Descripcion" class="text-red-500 text-sm"></span>
                    </div>
                    <!-- Estado -->
                    <div class="md:col-span-2">
                        <label asp-for="Estado" class="block text-sm font-medium text-gray-700">Estado <span class="text-red-500">*</span></label>
                        <div class="flex items-center mt-1">
                            <span class="w-1/3 text-right font-medium text-gray-600 pr-4">Estado:</span>
                            <div class="relative inline-block w-10 mr-2 align-middle select-none">
                                <input asp-for="Estado" type="checkbox" id="Estado" class="toggle-checkbox absolute block w-6 h-6 rounded-full bg-white border-4 appearance-none cursor-pointer" checked />
                                <label for="Estado" class="toggle-label block overflow-hidden h-6 rounded-full bg-gray-300 cursor-pointer"></label>
                            </div>
                            <span>
                                <span id="estado-label" class="inline-block px-3 py-1 bg-green-500 text-white text-sm font-medium rounded-full">Activo</span>
                            </span>
                        </div>
                        <span asp-validation-for="Estado" class="text-red-500 text-sm"></span>
                    </div>
                </div>
                <!-- Form Actions -->
                <div class="mt-6 flex justify-end space-x-4">
                    <button type="submit" class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-yellow-600 to-yellow-800 text-white rounded-full hover:bg-gradient-to-r hover:from-yellow-700 hover:to-yellow-900 transition duration-300 ease-in-out transform hover:scale-110 shadow-lg">
                        <i class="bi bi-save mr-2"></i> Guardar Insumo
                    </button>
                    <a asp-action="Index" class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-gray-500 to-gray-600 text-white rounded-full hover:bg-gradient-to-r hover:from-gray-600 hover:to-gray-700 transition duration-300 ease-in-out transform hover:scale-110 shadow-lg">
                        <i class="bi bi-x-circle mr-2"></i> Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Success Toast -->
<div class="fixed bottom-4 right-4 hidden bg-green-500 text-white px-6 py-3 rounded-lg shadow-lg transition-opacity duration-300" id="success-toast">
    <i class="bi bi-check-circle mr-2"></i> ¡Insumo creado exitosamente!
</div>

<style>
    .toggle-checkbox:checked {
        right: 0;
        border-color: #10b981;
    }

        .toggle-checkbox:checked + .toggle-label {
            background-color: #10b981;
        }

    .toggle-checkbox {
        transition: all 0.2s ease-in-out;
        right: 20px;
    }

    .toggle-label {
        transition: background-color 0.2s ease-in-out;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('create-insumo-form');
            const toast = document.getElementById('success-toast');
            const estadoCheckbox = document.getElementById('Estado');
            const estadoLabel = document.getElementById('estado-label');

            // Update Estado label dynamically
            function updateEstadoLabel() {
                if (estadoCheckbox.checked) {
                    estadoLabel.classList.remove('bg-red-500');
                    estadoLabel.classList.add('bg-green-500');
                    estadoLabel.textContent = 'Activo';
                } else {
                    estadoLabel.classList.remove('bg-green-500');
                    estadoLabel.classList.add('bg-red-500');
                    estadoLabel.textContent = 'Inactivo';
                }
            }

            estadoCheckbox.addEventListener('change', updateEstadoLabel);
            updateEstadoLabel(); // Initialize label

            form.addEventListener('submit', async (e) => {
                // Validar que se ha seleccionado un proveedor
                const proveedorId = document.querySelector('[name="ProveedorId"]').value;
                if (!proveedorId) {
                    e.preventDefault();
                    alert('Por favor, seleccione un proveedor para el insumo.');
                    return;
                }

                // Código original del submit
                if (form.reportValidity()) {
                    // Si usas AJAX, deja esta parte
                    if (e.submitter && e.submitter.getAttribute('type') === 'submit') {
                        return; // Permite el envío normal del formulario
                    }

                    e.preventDefault();
                    const formData = new FormData(form);

                    try {
                        const response = await fetch(form.action, {
                            method: 'POST',
                            body: formData
                        });

                        if (response.ok) {
                            toast.classList.remove('hidden');
                            setTimeout(() => {
                                toast.classList.add('hidden');
                                window.location.href = '@Url.Action("Index", "Insumo")';
                            }, 2000);
                        } else {
                            const errors = await response.json();
                            console.error('Validation errors:', errors);
                            // Display errors if needed
                        }
                    } catch (error) {
                        console.error('Error:', error);
                    }
                }
            });
        });
    </script>
}