@model SisNikosPizza.Domain.Models.Insumo

@{
    ViewData["Title"] = "Eliminar Insumo";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<div class="container mx-auto py-8 px-4 sm:px-6 lg:px-8">
    <div class="mb-6">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-red-600 via-yellow-500 to-orange-600 animate-pulse">
            Eliminar Insumo
        </h1>
    </div>

    <div class="bg-white shadow-xl rounded-2xl overflow-hidden">
        <form method="post" asp-controller="Insumo" asp-action="Delete">
            <input type="hidden" asp-for="InsumoId" />

            <div class="bg-gradient-to-r from-red-600 to-orange-600 text-white px-6 py-4">
                <h2 class="text-2xl font-semibold">Confirmar Eliminación</h2>
            </div>

            <div class="p-6 bg-yellow-100">
                <div asp-validation-summary="ModelOnly" class="text-red-600 mb-4"></div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                    <div class="flex items-center">
                        <span class="w-1/3 text-right font-medium text-gray-600 pr-4">Insumo ID:</span>
                        <span class="text-gray-800">@Model.InsumoId</span>
                    </div>
                    <div class="flex items-center">
                        <span class="w-1/3 text-right font-medium text-gray-600 pr-4">Nombre:</span>
                        <span class="text-gray-800">@Model.Nombre</span>
                    </div>
                    <div class="flex items-center">
                        <span class="w-1/3 text-right font-medium text-gray-600 pr-4">Precio:</span>
                        <span class="text-gray-800">S/. @Model.Precio</span>
                    </div>
                    <div class="flex items-center">
                        <span class="w-1/3 text-right font-medium text-gray-600 pr-4">Cantidad:</span>
                        <span class="text-gray-800">@Model.Cantidad</span>
                    </div>
                    <div class="flex items-center">
                        <span class="w-1/3 text-right font-medium text-gray-600 pr-4">Unidad de Medida:</span>
                        <span class="text-gray-800">@Model.UnidadeDeMedida</span>
                    </div>
                    <div class="flex items-center">
                        <span class="w-1/3 text-right font-medium text-gray-600 pr-4">Descripción:</span>
                        <span class="text-gray-800">@Model.Descripcion</span>
                    </div>
                    <div class="flex items-center">
                        <span class="w-1/3 text-right font-medium text-gray-600 pr-4">Estado:</span>
                        <span>
                            @if (Model.Estado)
                            {
                                <span class="inline-block px-3 py-1 bg-green-500 text-white text-sm font-medium rounded-full">Activo</span>
                            }
                            else
                            {
                                <span class="inline-block px-3 py-1 bg-red-500 text-white text-sm font-medium rounded-full">Inactivo</span>
                            }
                        </span>
                    </div>
                    <div class="flex items-center">
                        <span class="w-1/3 text-right font-medium text-gray-600 pr-4">Creado el:</span>
                        <span class="text-gray-800">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <div class="flex items-center">
                        <span class="w-1/3 text-right font-medium text-gray-600 pr-4">Actualizado el:</span>
                        <span class="text-gray-800">@Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                </div>

                <div class="flex justify-center space-x-4 mt-6">
                    <button type="submit" class="inline-flex items-center px-6 py-2 bg-red-500 text-white rounded-full hover:bg-red-600 transition duration-300 ease-in-out transform hover:scale-105">
                        <i class="bi bi-trash mr-2"></i> Eliminar
                    </button>
                    <a asp-controller="Insumo" asp-action="Index" class="inline-flex items-center px-6 py-2 bg-yellow-500 text-white rounded-full hover:bg-yellow-600 transition duration-300 ease-in-out transform hover:scale-105">
                        <i class="bi bi-x-circle mr-2"></i> Cancelar
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
