@model SisNikosPizza.Domain.Models.Insumo

@{
    ViewData["Title"] = "Editar Insumo";
    Layout = "~/Views/Shared/_Admin.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<div class="container mx-auto py-8 px-4 sm:px-6 lg:px-8">
    <div class="mb-6">
        <h1 class="text-3xl sm:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-red-600 via-yellow-500 to-orange-600 animate-pulse">
            Editar Insumo
        </h1>
    </div>

    <div class="bg-white shadow-xl rounded-2xl overflow-hidden max-w-4xl mx-auto">
        <form method="post" asp-controller="Insumo" asp-action="Edit">
            <input type="hidden" asp-for="InsumoId" />
            <div class="bg-gradient-to-r from-red-600 to-orange-600 text-white px-6 py-4 text-center">
                <h2 class="text-2xl font-semibold"><i class="bi bi-box-seam mr-2"></i> Editar Insumo</h2>
            </div>
            <div class="p-6 bg-yellow-100">
                <div asp-validation-summary="ModelOnly" class="text-red-600 mb-4"></div>

                <div class="mb-6">
                    <label class="block text-gray-600 font-medium mb-2">Nombre <span class="text-red-500">*</span></label>
                    <input type="text" asp-for="Nombre" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500" placeholder="Nombre del insumo" />
                    <span asp-validation-for="Nombre" class="text-red-600 text-sm"></span>
                </div>

                <div class="mb-6">
                    <label class="block text-gray-600 font-medium mb-2">Descripción</label>
                    <textarea asp-for="Descripcion" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500" rows="4" placeholder="Descripción del insumo"></textarea>
                    <span asp-validation-for="Descripcion" class="text-red-600 text-sm"></span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
                    <div>
                        <label class="block text-gray-600 font-medium mb-2">Precio Unitario <span class="text-red-500">*</span></label>
                        <input type="number" asp-for="Precio" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500" placeholder="Precio del insumo" step="0.01" />
                        <span asp-validation-for="Precio" class="text-red-600 text-sm"></span>
                    </div>
                    <div>
                        <label class="block text-gray-600 font-medium mb-2">Cantidad <span class="text-red-500">*</span></label>
                        <input type="number" asp-for="Cantidad" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500" placeholder="Cantidad del insumo" step="0.01" />
                        <span asp-validation-for="Cantidad" class="text-red-600 text-sm"></span>
                    </div>
                </div>

                <div class="mb-6">
                    <label class="block text-gray-600 font-medium mb-2">Unidad de Medida <span class="text-red-500">*</span></label>
                    <input type="text" asp-for="UnidadeDeMedida" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500" placeholder="Ejemplo: kg, литро, unidad" />
                    <span asp-validation-for="UnidadeDeMedida" class="text-red-600 text-sm"></span>
                </div>

                <div class="mb-6">
                    <label class="block text-gray-600 font-medium mb-2">Estado <span class="text-red-500">*</span></label>
                    <select asp-for="Estado" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500">
                        <option value="true">Activo</option>
                        <option value="false">Inactivo</option>
                    </select>
                    <span asp-validation-for="Estado" class="text-red-600 text-sm"></span>
                </div>

                <div class="flex justify-end space-x-4 mt-6">
                    <button type="submit" class="inline-flex items-center px-8 py-3 bg-gradient-to-r from-red-600 to-yellow-500 text-white rounded-full hover:bg-gradient-to-r hover:from-red-700 hover:to-yellow-600 transition duration-300 ease-in-out transform hover:scale-110 animate-pulse shadow-lg text-lg font-semibold">
                        <i class="bi bi-floppy-fill mr-2"></i> Guardar
                    </button>
                    <a asp-controller="Insumo" asp-action="Index" class="inline-flex items-center px-6 py-2 bg-gray-700 text-white rounded-full hover:bg-gray-800 transition duration-300 ease-in-out transform hover:scale-105">
                        <i class="bi bi-x-circle mr-2"></i> Cancelar
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>